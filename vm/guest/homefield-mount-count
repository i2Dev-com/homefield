#!/bin/sh
# Count host data mounts in the guest for isolation_probe (bin/lib/vm.sh).
# Runs on the guest's /bin/sh (dash on Ubuntu) via `guest sh -c`, including
# on a fresh VM before setup completes.
#
# Exits 3 when `mount` itself fails so the caller distinguishes "could not ask"
# from a count. Prints the count of virtiofs/9p/sshfs/reverse-sshfs lines,
# excluding at most one exact read-only Rosetta share line (#21).
set -eu
# shellcheck disable=SC3040  # enabled when the shell supports it (bash, dash >= 0.5.12)
(set -o pipefail) 2>/dev/null && set -o pipefail

out="$(mount)" || exit 3
total=0
ros=0
while IFS= read -r line; do
  case "$line" in
    # *sshfs* matches both sshfs and reverse-sshfs.
    *virtiofs* | *9p* | *sshfs*)
      total=$((total + 1))
      case "$line" in
        "vz-rosetta on /mnt/lima-rosetta type virtiofs "*)
          ros=$((ros + 1))
          ;;
      esac
      ;;
  esac
done <<EOF
$out
EOF
if [ "$ros" -le 1 ]; then
  echo "$((total - ros))"
else
  echo "$total"
fi

#!/usr/bin/env bash
set -euo pipefail
unit=""
if [ -f /opt/actions-runner/.service ]; then
  unit="$(cat /opt/actions-runner/.service 2>/dev/null || true)"
fi
if pgrep -f Runner.Worker >/dev/null; then
  echo "homefield-maintenance: job in progress, skipping until tomorrow"
  exit 0
fi
# The runner is stopped only when it was running. A service that was already
# stopped — a provision run mid-re-register, a deregistration cut off — stays
# stopped: maintenance must not restart what it did not stop. No .service at
# all (or a name whose unit is not loaded) is the same state with nothing to
# stop; the host-side stop_runner reads it the same way and upgrades on.
was_active=0
if [ -n "$unit" ] && systemctl is-active --quiet "$unit"; then
  was_active=1
  systemctl stop "$unit"
fi
# Whatever happens below, the runner comes back up — but only if it was up.
trap 'if [ "$was_active" = 1 ]; then
        systemctl start "$unit" ||
          echo "homefield-maintenance: could not start ${unit}; check the guest" >&2
      fi' EXIT
export DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a
apt-get update -q
apt-get upgrade -y -q --with-new-pkgs \
  -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold
apt-get autoremove -y -q --purge
# A kernel or libc update asks for a reboot. When maintenance stopped the
# runner itself, reboot now rather than start it and give it a job to lose:
# its service is enabled, so it comes back on boot. A guest reboot keeps the
# VM running under Lima's vz backend (verified with Lima 2.2.0). When the
# runner was already stopped, whatever stopped it — a provision run, most
# likely — owns the restart, and a reboot now could cut that run short; the
# next idle run applies it.
if [ -f /var/run/reboot-required ]; then
  if [ "$was_active" = 1 ]; then
    echo "homefield-maintenance: rebooting to finish the upgrade"
    trap - EXIT
    systemctl reboot || systemctl start "$unit"
  else
    echo "homefield-maintenance: a reboot is required, but the runner was already stopped; skipping the reboot"
  fi
fi

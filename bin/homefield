#!/usr/bin/env bash
# Set up, upgrade, inspect and remove the local GitHub Actions runner on this
# Mac: a Lima VM from vm/lima.yaml, provisioned by vm/provision.sh. Wraps the
# manual steps in docs/runbook.md, which stays the reference for what each one
# does and why.
#
#   bin/homefield setup [--url https://github.com/<org>[/<repo>]] [options]
#   bin/homefield install [--url https://github.com/<org>[/<repo>]] [options]
#   bin/homefield upgrade [--packages "..."] [--force]
#   bin/homefield status
#   bin/homefield diagnose [--json]
#   bin/homefield uninstall [--keep-vm]
#   bin/homefield reset [--keep-vm] [--keep-group] [--remove-tool]
#   bin/homefield route <hosted|local> --repo <owner>/<repo> [--repo ...]
#   bin/homefield adopt --repo <owner>/<repo> [--jobs "ci.yml:lint,..."] [--setup] [--events E] [--dependabot hosted|local] [--fallback IMAGE] [--no-switch] [--dry-run]
#   bin/homefield memory [--days N]
#   bin/homefield report --repo <owner>/<repo> [--repo ...] [--since DATE]
#   bin/homefield version
#
# install.sh puts this on the PATH as `homefield`; the messages below say
# bin/homefield, which is the same file in a checkout.
#
# Every command takes --instance NAME (default homefield, or $HOMEFIELD_INSTANCE)
# to pick the Lima VM. Run `bin/homefield help` for the options.
set -euo pipefail
# Runs on macOS's stock bash 3.2, which turns `set -e` off inside $(...). A
# function that can fail inside one says `|| exit 1` where it calls another.

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIMA_YAML="$ROOT/vm/lima.yaml"
PROVISION="$ROOT/vm/provision.sh"
GUEST_PROVISION="/tmp/provision.sh"
INSTANCE="${HOMEFIELD_INSTANCE:-homefield}"
RUNNER_HOME="/opt/actions-runner"
# Seconds runner_on_github waits for gh before calling the answer "not
# checked" (#103): gh has no timeout flag, and on a black-holed network a
# connect can take ~75 s on macOS. Tests drive it low through the env.
GH_TIMEOUT="${HOMEFIELD_GH_TIMEOUT:-15}"
case "$GH_TIMEOUT" in ''|*[!0-9]*) GH_TIMEOUT=15 ;; esac

usage() {
  cat <<'EOF'
Usage: bin/homefield <command> [options]

Commands:
  setup      The whole first-time setup in one command: preflight must pass in
             full (any failed check stops it with nothing created), then the
             same steps as install, ending with a summary of what is done (and
             what needs attention) and the next steps, including the
             repositories that can already use the runner. Takes install's
             options. On an instance that is already registered it upgrades,
             like install.
  install    Create the VM (if needed), provision it and register the runner.
             For an organization it also creates the runner group, and it
             waits until the runner shows online. On an instance that is
             already registered, this is an upgrade. The lower-level command
             setup runs: it reports preflight but does not stop on it.
  upgrade    Re-run provisioning on a registered runner: packages, hooks,
             runner binary. Refuses while a job is running, unless --force.
             Also refuses when the VM cannot be asked whether one is.
  status     Show the VM, the registration (and whether GitHub still lists
             it) and whether a job is running.
  diagnose   One read-only report for when something went wrong: the VM
             (created, isolated, registered, listed on GitHub, service,
             version, npm), the runner group on GitHub's side (its access and
             which repositories are in it) and the prerequisites, ending in a
             summary that names the command fixing each problem. Exits 0 when
             healthy, 1 when it found a problem. Starts and changes nothing:
             a VM that is not running is reported, not started.
  uninstall  Deregister the runner and delete the VM.
  reset      Roll back an install, complete or half-finished: deregister the
             runner if it registered, delete the VM, and delete the runner
             group if this install created it (and nothing else is in it).
             Lists what it will remove and asks first; HOMEFIELD_YES=1 answers
             yes. Nothing to undo is not an error. Unlike uninstall it does
             not need a VM to exist.
  route      Switch repositories' routed jobs to hosted or local
             (the CI_RUNNER variable). Switching to hosted also cancels and
             re-runs runs whose jobs are stuck waiting for the local runner.
  preflight  Check prerequisites for a fresh install: macOS, Apple Silicon,
              Lima, gh, python3, brew. Exits 0 when all pass, 1
              otherwise (with messages pointing to the exact fix command).
              Designed to be run before install; setup and install call it
              first (setup stops on a failure, install only reports it).
  adopt      Prepare a repository to use the runner: check that its routing is
             merged, and only then give it access to the runner group and
             switch it to local. Refuses a public repository.
  memory     Show the VM's memory use from its per-minute log: average and
             peak per day, and out-of-memory kills.
  report     Queue wait, duration and minutes of the jobs in repositories,
             local against hosted, from the GitHub API.
  version    Show which version of this tool is installed, and whether a
             newer one is available (checked with gh).

Options:
  --instance NAME    Lima instance (default homefield, or $HOMEFIELD_INSTANCE)

install (and setup, which takes the same options):
  --url URL          https://github.com/<org> or https://github.com/<owner>/<repo>
                     (asked for on a terminal when a new registration has none).
                     Whether the owner is an organization or a personal account
                     is looked up first (gh, else the public API). A personal
                     account has no account-wide runners and no runner groups,
                     so it needs a repository URL; with only its owner URL,
                     a terminal is asked for the repository, and without one
                     install stops, naming --url https://github.com/<you>/<repo>
  --personal         treat the owner as a personal account without looking it
                     up (the lookup needs the API, and a token that can see the
                     account). Cannot be combined with --org
  --org              treat the owner as an organization without looking it up.
                     Cannot be combined with --personal
  --label LABEL      routing label (default homefield-ci)
  --name NAME        runner name (default: this Mac's local hostname and the
                     instance, e.g. my-mac-homefield). Must be free in the
                     scope: a name already registered there is refused
  --replace          if the name is taken, remove that registration (a stale
                     one of this Mac's, say) right before registering. If it
                     is another machine's runner, that runner stops working
  --group GROUP      org runner group (default homefield-ci; ignored for a repo
                     or a personal account).
                     Created if missing: selected repositories, no public ones.
                     On the GitHub Free plan, use Default: custom groups
                     need Team or Enterprise
  --group-exists     the group exists and you checked it (selected
                     repositories, public ones off): go on when gh cannot
                     list the groups, instead of asking. Registration still
                     fails if the group is missing
  --packages "A B"   extra apt packages (RUNNER_EXTRA_PACKAGES)
  --cpus N           VM CPUs, when creating it (default: vm/lima.yaml)
  --memory GIB       VM memory in GiB, when creating it (default: vm/lima.yaml)
  --no-autostart     do not start the VM at login

upgrade:
  --packages "A B"   replace the saved extra packages
  --force            upgrade even while a job is running (the job is cancelled)

diagnose:
  --json             machine-readable output: the same facts, a top-level
                     healthy boolean and a problems array; nothing else on
                     stdout. Needs neither jq nor python3. A check that needs
                     GitHub waits at most HOMEFIELD_GH_TIMEOUT seconds (15).

uninstall:
  --keep-vm          only deregister; keep the VM

reset:
  --keep-vm          only deregister; keep the VM
  --keep-group       keep the runner group. Without this, the group is deleted
                     only if install created it (recorded in
                     ~/.local/state/homefield/<instance>.state, or under
                     $HOMEFIELD_STATE_DIR), it is not Default, GitHub still
                     lists it with that id and name, and no runner other than
                     this one is in it
  --remove-tool      also remove the `homefield` command and the tool's files
                     install.sh put on this Mac. They are shared by every
                     instance, so this is not the default. Done last, and
                     only when every other step worked

route <hosted|local>:
  --repo OWNER/REPO  repository to switch (repeat for several; required)
  --label LABEL      routing label of the stuck jobs to look for (default homefield-ci)
  --dry-run          show what would change, change nothing
  Needs gh with write access to the repositories' variables and runs. Does
  not need the VM.

adopt:
  --repo OWNER/REPO  the repository to adopt (required, one)
  --label LABEL      routing label (default homefield-ci; a routing-guard step
                     with another label in the workflows is used as it is)
  --events "E,..."   events whose jobs are routed (default pull_request; also
                     push, workflow_dispatch, schedule). Like
                     --label: shapes the printed expression when there is no
                     guard yet, and must equal the guard's `events` when there
                     is one. Jobs on push, workflow_dispatch and schedule wait
                     for the Mac: a deploy gated on CI can queue behind it
  --dependabot hosted|local
                     keep Dependabot's jobs hosted (default) or route them
                     too; same rules as --events. Dependabot's install
                     scripts then run on a VM that is not thrown away
  --fallback IMAGE   hosted image used when CI_RUNNER is not local (default
                     ubuntu-latest; ubuntu-*, windows-* or macos-*); same
                     rules as --events
  --group GROUP      runner group the repository needs access to (default
                     homefield-ci; skipped for Default and for personal accounts)
  --jobs "F:J,..."   file:job entries you mean to route, for the snippets it
                     prints when the routing is not in place yet and, with
                     --setup, the hosted jobs to route on top of those
                     already routed (the latter always stay listed)
  --setup            open a pull request that writes steps 1-4 of
                     docs/adopting.md instead of waiting for them: every job
                     of a workflow that runs on pull requests and asks today
                     for a GitHub-hosted image gets the canonical expression
                     (with a comment pointing at the guide), the routing guard
                     lists exactly those jobs (written to
                     .github/workflows/homefield-routing.yml when the
                     repository has no guard yet), and the cache keys built
                     from runner.os in those files gain runner.arch. A
                     workflow whose file name holds a space or comma is never
                     routed (a guard jobs: list cannot hold it); the run says
                     so. Exits 1 with "nothing to route" when no job
                     qualifies. It needs write access to the repository, and
                     touches neither the runner group nor CI_RUNNER: after you
                     merge it, run adopt without --setup
                     (docs/adopting.md, step 5).
  --no-switch        do everything except set CI_RUNNER
  --dry-run          read-only: report what would change, change nothing
  Reads the repository's workflows on its default branch. Only when the
  routing guard is there (the pinned action, in a workflow that runs
  on pull requests), passes and at least one job is routed does it add the
  repository to the group and switch it; otherwise it prints what to add and
  exits 1, having changed nothing. Adding the repository to the group needs
  admin:org; without it, it says so and goes on. --setup stops earlier: it
  opens the routing pull request and changes nothing else. Needs gh and
  python3. Does not need the VM.

memory:
  --days N           how many days to show (default 7)
  The log is written by the guest every minute from samples taken every 2
  seconds, so a short spike is kept. "Used" is total minus available memory.

report:
  --repo OWNER/REPO  repository to include (repeat for several; required)
  --since DATE       first day, YYYY-MM-DD, UTC (default: the 1st of this month)
  --until DATE       last day, inclusive (default: today)
  --label LABEL      routing label that marks a job as local (default homefield-ci)
  --json             machine-readable output
  Needs gh with read access to the repositories' runs. Does not need the VM.
  Queue wait is from a job being queued to it starting; minutes are each
  job's duration rounded up to the minute, as GitHub bills hosted jobs. For
  local jobs that is what they would have cost. Looks at every attempt of
  every run, so it makes one API call per run: allow a few minutes a month.

Registration and removal need a one-hour token. It is fetched with `gh` when
your gh credentials allow it (org owner with admin:org, or repository admin);
otherwise you are asked to paste one from the "New runner" page. Tokens go to
the VM on stdin, never on a command line. For an organization, gh also reads
and creates the runner group, which needs the same admin:org scope: on a
terminal you are offered `gh auth refresh -s admin:org` if it is missing;
without one, pass --group-exists for a group you created and checked by hand.
EOF
}

die() {
  echo "homefield: $*" >&2
  exit 1
}
log() { echo "homefield: $*"; }

# ── Host and VM ─────────────────────────────────────────────────────────────
check_host() {
  [ "$(uname -s)" = "Darwin" ] || die "needs macOS (Lima with Apple's Virtualization.framework)"
  [ "$(uname -m)" = "arm64" ] || die "needs an Apple Silicon Mac: the VM is arm64"
  command -v limactl >/dev/null || die "needs Lima >= 2.0: brew install lima"
  local version major minor
  version="$(limactl --version | awk '{print $NF}')"
  major="${version%%.*}"
  minor="${version#*.}"
  minor="${minor%%.*}"
  # 2.0 is the first release documented to accept the `template:` locator in
  # vm/lima.yaml; it deprecated `template://` (Lima 2.0.0 release notes).
  if ! [[ "$major" =~ ^[0-9]+$ && "$minor" =~ ^[0-9]+$ ]] || [ "$major" -lt 2 ]; then
    die "needs Lima >= 2.0, found ${version}"
  fi
}

# preflight_collect: everything an install needs, checked one by one instead of
# stopping at the first failure like check_host, into PF_NAME / PF_LEVEL /
# PF_MSG (parallel arrays, in the order preflight prints them). PF_LEVEL is ok,
# warn or fail, and a failure's message carries the command that fixes it.
# cmd_preflight prints the arrays; diagnose reads them, so the two cannot
# disagree about what a prerequisite is.
# gh is not strictly needed: without it, install asks for a pasted token, so
# gh missing is a failure to fix, gh logged out is a failure too, and a token
# without admin:org only warns (an organization URL is what needs that scope,
# a repository URL is registered with repo; `gh auth refresh -s admin:org`).
# Lima >= 2.0 is the same check as check_host's.
PF_NAME=()
PF_LEVEL=()
PF_MSG=()
pf_add() {
  PF_NAME+=("$1")
  PF_LEVEL+=("$2")
  PF_MSG+=("$3")
}
preflight_collect() {
  local version major minor login scopes whoami py_version
  PF_NAME=()
  PF_LEVEL=()
  PF_MSG=()
  # Lima
  if ! command -v limactl >/dev/null 2>&1; then
    pf_add lima fail "Lima not found: run 'brew install lima'"
  else
    version="$(limactl --version 2>/dev/null | awk '{print $NF}')"
    major="${version%%.*}"
    minor="${version#*.}"
    minor="${minor%%.*}"
    if ! [[ "$major" =~ ^[0-9]+$ && "$minor" =~ ^[0-9]+$ ]] || [ "$major" -lt 2 ]; then
      pf_add lima fail "Lima >= 2.0 required, found ${version:-unknown}: run 'brew install lima'"
    else
      pf_add lima ok "Lima $version"
    fi
  fi
  # gh: the active account, by login and scopes. App-installed tokens report no
  # scopes; the `Token scopes` line of `gh auth status` is absent for them, and
  # `gh auth status` also lists accounts that are not active.
  if ! command -v gh >/dev/null 2>&1; then
    pf_add gh fail "gh (GitHub CLI) not found: run 'brew install gh'"
  else
    whoami="$(gh auth status --json hosts --jq '.hosts["github.com"] // [] | map(select(.active)) | (.[0] // {}) | "\(.login // "")|\(.scopes // "")"' 2>/dev/null)" || whoami="|"
    login="${whoami%%|*}"
    scopes="${whoami#*|}"
    if [ -z "$login" ]; then
      pf_add gh fail "gh not logged in: run 'gh auth login'"
    elif [ -z "$scopes" ]; then
      pf_add gh ok "gh authenticated as $login (no scope reported; an organization URL needs admin:org)"
    elif case ",$scopes," in *,admin:org,*) true ;; *) false ;; esac; then
      pf_add gh ok "gh authenticated as $login (admin:org scope)"
    else
      pf_add gh warn "gh authenticated as $login, no admin:org scope (an organization URL needs it: gh auth refresh -s admin:org)"
    fi
  fi
  # python3: resolving on PATH is not enough — a broken shim prints but exits
  # non-zero, so the version command's own status decides.
  if ! command -v python3 >/dev/null 2>&1; then
    pf_add python3 fail "python3 not found: run 'brew install python'"
  elif py_version="$(python3 --version 2>&1)"; then
    pf_add python3 ok "python3 ($py_version)"
  else
    pf_add python3 fail "python3 cannot run (${py_version:-no output}): reinstall it, e.g. run 'brew install python'"
  fi
  # brew
  if command -v brew >/dev/null 2>&1; then
    pf_add brew ok "brew available"
  else
    pf_add brew fail "brew not found: install Homebrew from https://brew.sh"
  fi
  # macOS (Darwin), by product version rather than kernel release
  if [ "$(uname -s)" = "Darwin" ]; then
    pf_add macos ok "macOS $(sw_vers -productVersion)"
  else
    pf_add macos fail "needs macOS (Darwin): found $(uname -s)"
  fi
  # Apple Silicon
  if [ "$(uname -m)" = "arm64" ]; then
    pf_add arm64 ok "arm64 (Apple Silicon)"
  else
    pf_add arm64 fail "needs Apple Silicon (arm64): found $(uname -m)"
  fi
}

# cmd_preflight: preflight_collect's checks, one line each, each failure with
# the command that fixes it. Exits 0 when every check passes, 1 otherwise.
cmd_preflight() {
  local failed=0 total i level
  preflight_collect
  total=${#PF_NAME[@]}
  for ((i = 0; i < total; i++)); do
    case "${PF_LEVEL[i]}" in
      ok) level=OK ;;
      warn) level=WARN ;;
      *) level=FAIL; failed=$((failed + 1)) ;;
    esac
    printf '  %-6s%s\n' "$level" "${PF_MSG[i]}"
  done
  # Summary
  echo ""
  if [ "$failed" -eq 0 ]; then
    echo "All checks passed (${total}/${total})."
    return 0
  fi
  echo "FAILED ${failed}/${total} check(s). Fix the above and retry."
  return 1
}

# check_instance: INSTANCE is a name Lima accepts (ValidateInstName, Lima 1.2
# on; 1.1 checks the same characters and length, not the .yml/.yaml ending),
# the same check as install.sh's. Anything else would reach limactl as an
# option (--help) or a path.

check_instance() {
  local re='^[A-Za-z0-9]+([._-][A-Za-z0-9]+)*$'
  [[ "$INSTANCE" =~ $re && ${#INSTANCE} -le 76 && ! "$INSTANCE" =~ [.][Yy][Aa]?[Mm][Ll]$ ]] ||
    die "--instance (or HOMEFIELD_INSTANCE) must be a Lima instance name: letters and digits, with a single '.', '_' or '-' between them, at most 76 characters, not ending in .yml or .yaml; got: $INSTANCE"
}

# vm_status: prints the VM's status (Running, Stopped, ...), or nothing when
# there is no such VM. Returns 2 when Lima could not be asked, or lists the VM
# without a status. It lists every
# instance and picks its own: `limactl list NAME` exits 1 for a missing VM
# ("unmatched instances", Lima 2.2.0) as it does when Lima itself fails, so
# only a successful list can say "no VM".
vm_status() {
  local rows name status
  rows="$(limactl list --format '{{.Name}} {{.Status}}' 2>/dev/null)" || return 2
  while read -r name status; do
    if [ "$name" = "$INSTANCE" ]; then
      # Listed with no status: its config is broken (Lima warns and lists it
      # with an empty status). It exists, so it is not "no VM".
      [ -n "$status" ] || return 2
      echo "$status"
      return 0
    fi
  done <<<"$rows"
  return 0
}
# vm_lookup: vm_status into VM_STATUS (empty: no VM), for the commands that act
# on "no VM": create one, or report that there is none. A Lima that could not be
# asked ends the command (install would otherwise register a runner group and
# then fail to create a VM that exists). Not a $(...), so die ends the command.
VM_STATUS=""
vm_lookup() {
  VM_STATUS="$(vm_status)" || die "could not ask Lima about VM ${INSTANCE} (limactl list failed, or lists it without a status); stopping here"
}

# --workdir /: the host's working directory does not exist in the guest, which
# has no mounts. stdin is closed, or `limactl shell` would swallow whatever is
# typed ahead, such as a token meant for the prompt; guest_stdin is for the
# two calls that feed a token in on purpose.
guest() { limactl shell --workdir / "$INSTANCE" "$@" </dev/null; }
guest_stdin() { limactl shell --workdir / "$INSTANCE" "$@"; }

ensure_vm() {
  local cpus="$1" memory="$2" status
  vm_lookup
  status="$VM_STATUS"
  if [ -z "$status" ]; then
    log "creating VM ${INSTANCE}"
    local args=(--name="$INSTANCE" --mount-none --tty=false)
    [ -n "$cpus" ] && args+=(--cpus="$cpus")
    [ -n "$memory" ] && args+=(--memory="$memory")
    limactl create "${args[@]}" "$LIMA_YAML"
    status="Stopped"
  fi
  if [ "$status" != "Running" ]; then
    log "starting VM ${INSTANCE}"
    limactl start --tty=false "$INSTANCE"
  fi
}

# The VM is the isolation boundary, so nothing runs in it until it is shown to
# have no host mounts and no view of the Mac's home directories. A guest
# command that cannot run at all is reported as such: treating its empty
# output as "no mounts found" would misread a broken VM as a safe one.
#
# isolation_probe is the check itself, for the callers that report instead of
# stopping (diagnose): 0 verified, 1 broken (host mounts, or /Users visible),
# 2 the guest could not be asked. It prints nothing; ISOLATION_WHY says what it
# found, and ISOLATION_SUFFIX is what verify_isolation adds to that in its die.
ISOLATION_WHY=""
ISOLATION_SUFFIX=""
isolation_fail() {
  ISOLATION_WHY="$2"
  ISOLATION_SUFFIX="$3"
  return "$1"
}
isolation_probe() {
  local mounts users=0
  ISOLATION_WHY=""
  ISOLATION_SUFFIX=""
  # mount is run on its own: in a pipe its failure would be hidden, and grep
  # would count nothing in its empty output. grep -c exits 1 for a count of 0,
  # which is an answer; a status above 1 is not.
  # shellcheck disable=SC2016  # the guest's shell expands these, not this one
  if ! mounts="$(guest sh -c 'out="$(mount)" || exit 3; printf "%s\n" "$out" | grep -Ec "virtiofs|9p|sshfs|reverse-sshfs"; test $? -le 1')"; then
    isolation_fail 2 "could not run the isolation check in VM ${INSTANCE}" "; is it running? (see docs/runbook.md, Setup)" || return
  fi
  case "$mounts" in
    ''|*[!0-9]*) isolation_fail 2 "could not read the mount count from VM ${INSTANCE}" "; refusing to continue (see docs/runbook.md, Setup)" || return ;;
  esac
  [ "$mounts" = "0" ] || { isolation_fail 1 "VM ${INSTANCE} has host mounts" "; refusing to continue (see docs/runbook.md, Setup)" || return; }
  guest_sees /Users || users=$?
  case "$users" in
    0) isolation_fail 1 "VM ${INSTANCE} can see /Users" "; refusing to continue" || return ;;
    1) ;;
    *) isolation_fail 2 "could not run the /Users check in VM ${INSTANCE}" "; refusing to continue (see docs/runbook.md, Setup)" || return ;;
  esac
  return 0
}
verify_isolation() {
  local rc=0
  isolation_probe || rc=$?
  [ "$rc" -eq 0 ] || die "${ISOLATION_WHY}${ISOLATION_SUFFIX}"
  log "isolation verified: no host mounts"
  verify_loopback
}

# lima_at_least MAJOR MINOR: is the installed limactl at least that release?
# The same version parsing as check_host's; an unreadable version answers no.
lima_at_least() {
  local version major minor
  version="$(limactl --version 2>/dev/null | awk '{print $NF}')"
  major="${version%%.*}"
  minor="${version#*.}"
  minor="${minor%%.*}"
  [[ "$major" =~ ^[0-9]+$ && "$minor" =~ ^[0-9]+$ ]] || return 1
  if [ "$major" -gt "$1" ]; then return 0; fi
  [ "$major" -eq "$1" ] && [ "$minor" -ge "$2" ]
}

# verify_loopback: the #18 probe. vm/lima.yaml asks Lima to stop mapping the
# host's loopback to host.lima.internal (networkOpts.hostLoopback: false);
# Lima >= 2.3.0 (lima-vm/lima#5581) honours that, Lima 2.0-2.2 warn about the
# unknown field and ignore it. The isolation claim is tested, not inferred: a
# throwaway listener on the Mac's 127.0.0.1 answers whether the guest can
# really reach it, and open, closed and unknown stay three different answers
# (an unknown is never read as closed).
#   closed  - logged; loopback-only services are out of PR code's reach.
#   open    - fatal only when the VM's own config asks for the block AND the
#             Lima is new enough to honour it: the boundary is claimed but
#             broken. Otherwise a warning naming the way to close it, because
#             this is the documented state until Lima 2.3.0 is released.
#   unknown - a warning that nothing was proven; the run goes on.
verify_loopback() {
  local port listener answer config asks_closed i got token tokenfile ok
  if ! command -v nc >/dev/null 2>&1; then
    echo "homefield: warning: #18 probe skipped (no nc on PATH); assume the guest can still reach the Mac's loopback (docs/runbook.md, Host loopback exposure)" >&2
    return 0
  fi
  port=$((20000 + RANDOM % 20000))
  # What answers on the port must be provably this probe's listener: nc
  # serves this token from its stdin, and a local connect that reads it
  # back found our nc rather than some service that already held the port
  # (whose answer would say nothing about the guest). HOMEFIELD_PROBE_TOKEN
  # lets the test suite know the token in advance.
  token="${HOMEFIELD_PROBE_TOKEN:-homefield-probe-$$-$port}"
  tokenfile="$(mktemp)" || tokenfile=""
  if [ -z "$tokenfile" ]; then
    echo "homefield: warning: #18 probe skipped (no temp file for the port token); assume the guest can still reach the Mac's loopback (docs/runbook.md, Host loopback exposure)" >&2
    return 0
  fi
  printf '%s' "$token" >"$tokenfile"
  # stderr goes to a file, not to /dev/null: it is how the listener reports
  # that it never bound the port (a foreign service holds it), which is a
  # different story from a listener that bound and then died.
  errfile="$(mktemp)" || errfile=""
  if [ -z "$errfile" ]; then
    rm -f "$tokenfile"
    echo "homefield: warning: #18 probe skipped (no temp file for the listener's report); assume the guest can still reach the Mac's loopback (docs/runbook.md, Host loopback exposure)" >&2
    return 0
  fi
  nc -k -l 127.0.0.1 "$port" <"$tokenfile" >"$errfile" 2>&1 &
  listener=$!
  # The guest's answer means nothing until the token comes back locally:
  # the bind is asynchronous (retry a moment), and an answer that is not the
  # token is some service that already held the port — attribution is lost
  # and the probe skips rather than misread.
  got=""
  i=0
  while [ "$i" -lt 6 ]; do
    got="$(nc -w 2 127.0.0.1 "$port" 2>/dev/null || true)"
    [ "$got" = "$token" ] && break
    i=$((i + 1))
    sleep 0.5
  done
  if [ "$got" != "$token" ]; then
    kill "$listener" 2>/dev/null || true
    wait "$listener" 2>/dev/null || true
    # The wait reaps the listener, so what it left behind is final: its
    # stderr naming a taken port is the surest sign the bind was lost — a
    # liveness check cannot see this before the reap (an exited child is
    # still kill -0-able as a zombie), and that is why no check lives in
    # the loop above.
    bind_lost=0
    if [ -s "$errfile" ] && grep -qi "Address already in use" "$errfile"; then bind_lost=1; fi
    rm -f "$tokenfile" "$errfile"
    if [ -n "$got" ]; then
      echo "homefield: warning: #18 probe skipped (127.0.0.1:${port} answered, but not with the token: another service holds the port); assume the guest can still reach the Mac's loopback (docs/runbook.md, Host loopback exposure)" >&2
    elif [ "$bind_lost" = 1 ]; then
      echo "homefield: warning: #18 probe skipped (127.0.0.1:${port} was already taken: the probe's listener could not bind it); assume the guest can still reach the Mac's loopback (docs/runbook.md, Host loopback exposure)" >&2
    else
      echo "homefield: warning: #18 probe skipped (nothing answered on 127.0.0.1:${port}; is the port in use?); assume the guest can still reach the Mac's loopback (docs/runbook.md, Host loopback exposure)" >&2
    fi
    return 0
  fi
  rm -f "$errfile"
  # Still accepting after serving the token: an nc without -k dies with the
  # connection it served, and its dead port would read as a false closed
  # from the guest. A second local connect is the real test — liveness
  # checks on processes would read a killed-but-unreaped one as alive. The
  # token is gone from nc's stdin by now (one-shot file), so this connect
  # only needs to succeed: the token above already proved the port is ours.
  i=0 ok=0
  while [ "$i" -lt 3 ]; do
    if nc -w 2 127.0.0.1 "$port" >/dev/null 2>&1; then ok=1; break; fi
    i=$((i + 1))
    sleep 0.2
  done
  if [ "$ok" != 1 ]; then
    kill "$listener" 2>/dev/null || true
    wait "$listener" 2>/dev/null || true
    rm -f "$tokenfile"
    echo "homefield: warning: #18 probe skipped (the nc listener died after one connection; does it support -k?); assume the guest can still reach the Mac's loopback (docs/runbook.md, Host loopback exposure)" >&2
    return 0
  fi
  # The guest's side: a TCP connect to the same port. bash's /dev/tcp exits
  # 1 for a refused connect AND for a name that did not resolve, so status
  # alone is not a boundary: only bash's own "Connection refused" message
  # closes. The words are open, closed-1 (refused), closed-124 (the 3 s
  # connect timeout), tools (a guest without timeout/bash/grep cannot be
  # asked) and unknown-<status> (unresolved name, no route, anything
  # else); an empty answer is the limactl call having failed.
  # shellcheck disable=SC2016  # the guest's shell expands these, not this one
  answer="$(guest sh -c 'if ! command -v timeout >/dev/null 2>&1 || ! command -v bash >/dev/null 2>&1 || ! command -v grep >/dev/null 2>&1; then echo tools; else out=$(timeout 3 bash -c "exec 3<>/dev/tcp/host.lima.internal/$1" 2>&1); rc=$?; if [ "$rc" = 0 ]; then echo open; elif [ "$rc" = 124 ]; then echo closed-124; elif [ "$rc" = 1 ] && printf %s "$out" | grep -q "Connection refused"; then echo closed-1; else echo "unknown-$rc"; fi; fi' sh "$port")" || answer=""
  kill "$listener" 2>/dev/null || true
  wait "$listener" 2>/dev/null || true
  rm -f "$tokenfile"
  case "$answer" in
    open)
      # Was this VM asked to block the loopback? Its own stored config says
      # (the file limactl create wrote; a custom LIMA_HOME is honoured). A
      # config that cannot be read is not evidence of a block, so it takes
      # the warning path, never the fatal one.
      config="${LIMA_HOME:-$HOME/.lima}/${INSTANCE}/lima.yaml"
      asks_closed=0
      [ -f "$config" ] && grep -Eq '^[[:space:]]*hostLoopback:[[:space:]]*false' "$config" && asks_closed=1
      if [ "$asks_closed" = 1 ] && lima_at_least 2 3; then
        # The gate is the limactl binary; a VM still running from before a
        # Lima upgrade keeps its old gateway, so the message makes the first
        # step a restart, and only what survives a restart is a broken
        # boundary.
        die "VM ${INSTANCE} reaches the Mac's loopback through host.lima.internal although its config sets networkOpts.hostLoopback: false. If the VM has been running since before Lima was upgraded, its gateway is the old one: stop it, start it, and run this again (the mapping is applied at VM start). If it still reaches the loopback after that the boundary is broken — nothing was registered, but a fresh install leaves the VM (and possibly the runner group) behind: docs/runbook.md, Host loopback exposure"
      fi
      if lima_at_least 2 3; then
        echo "homefield: warning: #18: jobs in VM ${INSTANCE} can reach the Mac's loopback; its stored config does not show networkOpts.hostLoopback: false (absent, or unreadable): recreate the VM, or stop it and add the setting with limactl edit (docs/runbook.md, Host loopback exposure)" >&2
      else
        echo "homefield: warning: #18: jobs in VM ${INSTANCE} can reach the Mac's loopback; Lima $(limactl --version 2>/dev/null | awk '{print $NF}') ignores networkOpts.hostLoopback — it closes for VMs created on Lima >= 2.3.0 (docs/runbook.md, Host loopback exposure)" >&2
      fi
      ;;
    closed-1|closed-124)
      log "loopback probe: closed (the guest cannot reach the Mac's 127.0.0.1)"
      ;;
    *)
      echo "homefield: warning: #18 probe got no clear answer from VM ${INSTANCE} (answer: ${answer:-none}); assume it can reach the Mac's loopback (docs/runbook.md, Host loopback exposure)" >&2
      ;;
  esac
  return 0
}

# guest_sees PATH: like guest_has_file for any kind of path, without sudo:
# 0 if the guest can see it, 1 if not, 2 if the guest could not be asked.
guest_sees() {
  local answer
  # shellcheck disable=SC2016  # the guest's shell expands $1, not this one
  answer="$(guest sh -c 'if test -e "$1"; then echo yes; else echo no; fi' sh "$1")" || return 2
  case "$answer" in
    yes) return 0 ;;
    no) return 1 ;;
    *) return 2 ;;
  esac
}

# guest_has_file PATH: 0 if the file is there, 1 if the guest says it is not,
# 2 if the guest could not be asked (limactl or sudo failed, or the answer was
# neither). The test runs in the guest and prints its answer, so a failed call
# cannot pass for "no": `test -f` alone exits 1 for a missing file and for a
# `limactl shell` that never reached the guest. A caller that acts on "no"
# has to stop on 2.
guest_has_file() {
  local answer
  # shellcheck disable=SC2016  # the guest's shell expands $1, not this one
  answer="$(guest sudo sh -c 'if test -f "$1"; then echo yes; else echo no; fi' sh "$1")" || return 2
  case "$answer" in
    yes) return 0 ;;
    no) return 1 ;;
    *) return 2 ;;
  esac
}

# registered: 0 if the runner is registered, 1 if not, 2 if the VM could not be
# asked. Commands that act on the answer call is_registered instead.
registered() { guest_has_file "$RUNNER_HOME/.runner"; }
# is_registered: registered, for the commands that act on "no". A VM that could
# not be asked ends the command: read as "not registered", it would let
# uninstall delete the VM and leave the registration on GitHub, and let install
# register again, where --replace removes this VM's own registration.
is_registered() {
  local rc=0
  registered || rc=$?
  [ "$rc" -lt 2 ] || die "could not ask VM ${INSTANCE} whether its runner is registered; is it running? Try again when bin/homefield status answers"
  return "$rc"
}

# runner_on_github <url> <id>: 0 if GitHub lists a runner with the id at <url>,
# 1 if it lists the scope's runners and that id is not among them, 2 if it
# could not be asked (no gh, no admin access, no network), 3 if the call was
# killed after GH_TIMEOUT seconds (a black-holed network stalls the connect
# for ~75 s on macOS, and status owes its other lines no such wait, #103).
# GitHub removes a
# runner that has not connected for more than 14 days, and the VM's .runner
# stays (#76). Matched by id: another Mac can register the name again. Never
# prompts, status calls it. On 0 it also leaves what GitHub says about that
# runner in RUNNER_GH_STATUS (online/offline) and RUNNER_GH_BUSY (true/false),
# which diagnose reports; status ignores them. (The list does not say which
# runner group a runner is in; group_of_runner asks the groups.)
RUNNER_GH_STATUS=""
RUNNER_GH_BUSY=""
runner_on_github() {
  local scope ids id st busy rc=0
  RUNNER_GH_STATUS=""
  RUNNER_GH_BUSY=""
  [ -n "$2" ] && command -v gh >/dev/null || return 2
  scope="$(api_scope "$1" 2>/dev/null)" || return 2
  # The killed-by-signal case is told from a plain failure by the exit code
  # (128 + TERM): the timer below is the only thing that kills this gh. The
  # timer's own kill can race gh finishing a heartbeat earlier; both answers
  # mean "not checked", and only the status wording differs.
  local tmp pid timer
  tmp="$(mktemp)" || return 2
  gh api --hostname github.com --paginate "${scope}/actions/runners?per_page=100" --jq '.runners[] | [.id, .status, .busy] | @tsv' </dev/null >"$tmp" 2>/dev/null &
  pid=$!
  # >/dev/null on the timer matters: sleep inherits stdout, and a caller
  # that runs status inside $(...) would wait for the whole timeout before
  # substitution closes.
  ( sleep "$GH_TIMEOUT"; kill -TERM "$pid" 2>/dev/null ) </dev/null >/dev/null 2>&1 & timer=$!
  wait "$pid" || rc=$?
  kill "$timer" 2>/dev/null || true
  wait "$timer" 2>/dev/null || true
  ids="$(cat "$tmp")"
  rm -f "$tmp"
  [ "$rc" -le 128 ] || return 3
  [ "$rc" = 0 ] || return 2
  while IFS=$'\t' read -r id st busy; do
    if [ "$id" = "$2" ]; then
      RUNNER_GH_STATUS="$st"
      RUNNER_GH_BUSY="$busy"
      return 0
    fi
  done <<<"$ids"
  return 1
}

# removed_recovery <url> <name>: how to register a runner GitHub removed again,
# under its old name. The label and group are not stored in the VM.
removed_recovery() {
  echo "bin/homefield uninstall --instance ${INSTANCE} --keep-vm, then bin/homefield install --instance ${INSTANCE} --url $1${2:+ --name $2}, with the --label and --group of the first install if they were not the defaults"
}

# job_running: 0 if a job is running, 1 if not, 2 if the guest could not be
# asked (the call failed, or pgrep did not run). `pgrep` alone exits 1 for "no
# job" and for a `limactl shell` that never reached the guest. The [R] keeps
# the pattern from matching this shell's own command line.
job_running() {
  local answer
  # shellcheck disable=SC2016  # the guest's shell expands these, not this one
  answer="$(guest sh -c 'pgrep -f "[R]unner.Worker" >/dev/null; case $? in 0) echo yes ;; 1) echo no ;; esac')" || return 2
  case "$answer" in
    yes) return 0 ;;
    no) return 1 ;;
    *) return 2 ;;
  esac
}
# is_job_running: job_running, for the commands that go on when it says "no".
# A guest that could not be asked ends the command, with --force too: --force
# overrides a job that is running, not a runner that cannot be reached.
is_job_running() {
  local rc=0
  job_running || rc=$?
  [ "$rc" -lt 2 ] || die "could not ask VM ${INSTANCE} whether a job is running; nothing was stopped. Try again when bin/homefield status answers"
  return "$rc"
}

# npm_state: whether the runner's bundled npm runs (#110), as with
# job_running: 0 ok, 1 broken, 2 the VM could not be asked. Verify only: the
# repair belongs to the job-started hook (vm/provision.sh), which relinks the
# externals symlinks a runner self-update flattens (actions/runner#2094)
# before every job. `cd /` keeps a project .npmrc out of the check.
npm_state() {
  local answer
  # shellcheck disable=SC2016  # the guest's shell expands these, not this one
  answer="$(guest sh -c 'for n in node20 node24; do d="/opt/actions-runner/externals/$n/bin"; [ -e "$d/npm" ] || continue; (cd / && "$d/node" "$d/npm" --version >/dev/null 2>&1) || { echo broken; exit 0; }; done; echo ok')" || return 2
  case "$answer" in
    ok) return 0 ;;
    broken) return 1 ;;
    *) return 2 ;;
  esac
}

# Maintenance (upgrade, uninstall) takes the runner offline first, straight
# after the idle check: a runner that is still listening can be handed a job
# at any moment, and apt restarting Docker or the service being uninstalled
# would then take that job down. If the command then fails, the runner is
# started again on the way out; a command that succeeds calls runner_back.
stopped_unit=""
stop_runner() {
  # No .service is a state of its own (provisioning never finished, or the
  # service was removed): nothing to stop. A guest that cannot be asked is not
  # that state, or the maintenance would go on with the runner listening.
  local has=0 unit
  guest_has_file "$RUNNER_HOME/.service" || has=$?
  case "$has" in
    0) ;;
    1) return 0 ;;
    *) die "could not ask VM ${INSTANCE} whether the runner has a service; nothing was stopped. Try again when bin/homefield status answers" ;;
  esac
  if ! unit="$(guest sudo cat "$RUNNER_HOME/.service")"; then
    die "could not read the runner's service name in VM ${INSTANCE}; nothing was stopped. Try again when bin/homefield status answers"
  fi
  # A file the guest answered for, with no name in it: no unit to stop.
  [ -n "$unit" ] || return 0
  # A name whose unit file is gone (an uninstall cut off before it deleted
  # .service) names nothing that runs. systemctl stop would fail with "not
  # loaded" and end the command before provisioning could repair it (#99).
  local load
  if ! load="$(guest systemctl show -p LoadState --value "$unit")"; then
    die "could not ask VM ${INSTANCE} whether ${unit} is installed; nothing was stopped. Try again when bin/homefield status answers"
  fi
  if [ "$load" = not-found ]; then
    log "${unit} is not installed; nothing to stop"
    return 0
  fi
  stopped_unit="$unit"
  trap restart_runner_on_failure EXIT
  log "stopping ${stopped_unit}: the runner takes no jobs until this finishes"
  guest sudo systemctl stop "$stopped_unit"
}
restart_runner_on_failure() {
  local rc=$?
  if [ "$rc" -ne 0 ] && [ -n "$stopped_unit" ]; then
    echo "homefield: failed; starting ${stopped_unit} again" >&2
    guest sudo systemctl start "$stopped_unit" ||
      echo "homefield: could not start ${stopped_unit}; check bin/homefield status" >&2
  fi
}
runner_back() {
  trap - EXIT
  stopped_unit=""
}

# Prints the named settings from the runner's config, one per line (empty for
# one that is missing): a name may contain spaces.
runner_setting() {
  guest sudo python3 -c 'import json,sys; d=json.load(open(sys.argv[1], encoding="utf-8-sig")); print(*(d.get(k, "") for k in sys.argv[2:]), sep="\n")' \
    "$RUNNER_HOME/.runner" "$@"
}

# What status and diagnose both say about a registered runner, from the VM.
# load_runner_settings: the runner's name, URL and id into RS_NAME / RS_URL /
# RS_ID (each empty when the settings could not be read).
RS_NAME=""
RS_URL=""
RS_ID=""
load_runner_settings() {
  RS_NAME=""
  RS_URL=""
  RS_ID=""
  # A read at end of input fails, and under `set -e` that ends the command:
  # fewer than three lines must reach the caller's check, not stop here.
  { read -r RS_NAME || true; read -r RS_URL || true; read -r RS_ID || true; } < <(runner_setting agentName gitHubUrl agentId)
}
# runner_service_state: 0 if the runner's service is running, 1 if not (or none
# is installed). SERVICE_UNIT is its name, empty when there is none.
SERVICE_UNIT=""
runner_service_state() {
  SERVICE_UNIT="$(guest sudo cat "$RUNNER_HOME/.service" 2>/dev/null)" || SERVICE_UNIT=""
  [ -n "$SERVICE_UNIT" ] && guest systemctl is-active --quiet "$SERVICE_UNIT"
}
# runner_version: the runner version provision.sh installed, or "unknown".
runner_version() { guest sudo cat "$RUNNER_HOME/.provisioned-version" 2>/dev/null || echo unknown; }
# runner_extra_packages: the saved extra apt packages, on one line.
runner_extra_packages() { guest sh -c 'cat /etc/homefield/extra-packages 2>/dev/null | tr "\n" " "'; }

# ── Tokens ──────────────────────────────────────────────────────────────────
# api_scope <url>: the REST path of the registration scope.
api_scope() {
  local url="${1%/}"
  if [[ "$url" =~ ^https://github\.com/([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)$ ]]; then
    echo "repos/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
  elif [[ "$url" =~ ^https://github\.com/([A-Za-z0-9_.-]+)$ ]]; then
    echo "orgs/${BASH_REMATCH[1]}"
  else
    die "--url must be https://github.com/<org> or https://github.com/<owner>/<repo>, got: $1"
  fi
}

# runners_page <url>: the settings page listing the scope's runners. An
# organization's settings live under /organizations/<org>/.
runners_page() {
  local scope
  scope="$(api_scope "$1")" || exit 1
  case "$scope" in
    orgs/*) echo "https://github.com/organizations/${scope#orgs/}/settings/actions/runners" ;;
    *) echo "https://github.com/${scope#repos/}/settings/actions/runners" ;;
  esac
}

# The runner APIs of an organization need the admin:org scope, which gh's
# default login does not have. offer_scope_refresh asks once per run to add
# it, on a terminal; it succeeds when the caller should retry its gh call.
# Callers in $(...) do not pass the flag back to their parent, which is fine:
# the group step runs in the parent first, and get_token alone in uninstall.
scope_refresh_asked=0
offer_scope_refresh() {
  [ "$scope_refresh_asked" = 0 ] || return 1
  scope_refresh_asked=1
  [ -t 0 ] && command -v gh >/dev/null || return 1
  if [ -n "${GITHUB_TOKEN:-}${GH_TOKEN:-}" ]; then
    # gh uses that variable instead of its stored login, so adding a scope to
    # the stored login changes nothing for this command.
    echo "homefield: GITHUB_TOKEN or GH_TOKEN is set, and gh uses it instead of its stored login, so" >&2
    echo "homefield: 'gh auth refresh' would not help. Unset it, or use a token with admin:org." >&2
    return 1
  fi
  local answer
  read -rp "gh needs the admin:org scope. Run 'gh auth refresh -h github.com -s admin:org' now? [Y/n] " answer
  case "$answer" in [Nn]*) return 1 ;; esac
  # gh prints its one-time code on stdout; the caller may be in $(...).
  gh auth refresh -h github.com -s admin:org >&2
}

# get_token <registration|remove> <url>: prints the token. From gh when it can,
# else pasted; never echoed.
get_token() {
  local kind="$1" url="$2" scope out token=""
  scope="$(api_scope "$url")" || exit 1
  # On an error gh prints the error body to stdout, so only its exit status
  # says whether this is a token.
  if command -v gh >/dev/null; then
    if out="$(gh api -X POST "${scope}/actions/runners/${kind}-token" -q .token 2>/dev/null)"; then
      token="$out"
    elif [[ "$scope" == orgs/* ]] && offer_scope_refresh &&
      out="$(gh api -X POST "${scope}/actions/runners/${kind}-token" -q .token 2>/dev/null)"; then
      token="$out"
    fi
  fi
  if [ -z "$token" ]; then
    [ -t 0 ] || die "could not get a ${kind} token with gh, and no terminal to paste one"
    echo "homefield: could not get a ${kind} token with gh (needs org owner + admin:org, or repository admin)." >&2
    echo "homefield: get one from $(runners_page "$url")/new and paste only the token." >&2
    read -rsp "${kind} token: " token
    echo >&2
  fi
  [[ "$token" =~ ^[A-Za-z0-9_-]+$ ]] || die "that does not look like a ${kind} token"
  printf '%s' "$token"
}

# Whether the URL's owner is a personal account or an organization decides the
# registration: an organization can have an account-wide runner and runner
# groups, a personal account only repository-scoped runners (GitHub's limit).
# --personal and --org set ACCOUNT_FORCE, which skips the lookup.
ACCOUNT_FORCE=""
# What check_scope_owner decided: "personal", "org", or "" when it could not
# tell (a repository URL whose owner could not be looked up).
ACCOUNT_MODE=""

# owner_type <owner>: prints GitHub's type for the account (User or
# Organization), or nothing when it cannot be told.
owner_type() {
  local out type=""
  # gh when it works, else the public API with curl (no python3 needed: a
  # stock Mac only has the stub that offers to install it).
  if command -v gh >/dev/null && out="$(gh api "users/${1}" -q .type 2>/dev/null </dev/null)"; then
    type="$out"
  elif out="$(curl -fsS "https://api.github.com/users/${1}" 2>/dev/null </dev/null)"; then
    type="$(printf '%s\n' "$out" | sed -n 's/^ *"type": *"\([A-Za-z]*\)".*/\1/p' | head -1)"
  fi
  printf '%s' "$type"
}

# have_terminal: stdin is a terminal to ask on (a seam for the tests).
have_terminal() { [ -t 0 ]; }

# check_scope_owner <url>: sets ACCOUNT_MODE for an owner or repository URL.
# An owner URL needs an organization: a personal account's is refused when
# there is no terminal to ask for a repository on, and an owner that cannot be
# looked up is refused. A repository URL worked without any lookup before, so
# one that fails is not fatal.
check_scope_owner() {
  local url="${1%/}" owner repo="" type=""
  ACCOUNT_MODE=""
  if [[ "$url" =~ ^https://github\.com/([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)$ ]]; then
    owner="${BASH_REMATCH[1]}"
    repo="${BASH_REMATCH[2]}"
  elif [[ "$url" =~ ^https://github\.com/([A-Za-z0-9_.-]+)$ ]]; then
    owner="${BASH_REMATCH[1]}"
  else
    return 0
  fi
  if [ -n "$ACCOUNT_FORCE" ]; then
    ACCOUNT_MODE="$ACCOUNT_FORCE"
  else
    type="$(owner_type "$owner")"
    case "$type" in
      Organization) ACCOUNT_MODE=org ;;
      User) ACCOUNT_MODE=personal ;;
      *) [ -n "$repo" ] || die "could not find ${owner} on GitHub (or reach api.github.com) to check that it is an organization; if it is one, pass --org to skip the check (--personal for a personal account)" ;;
    esac
  fi
  if [ "$ACCOUNT_MODE" = personal ] && [ -z "$repo" ] && ! have_terminal; then
    die "${owner} is a personal account, which cannot have account-wide runners; register a repository instead: --url https://github.com/${owner}/<repo>"
  fi
}

# validate_scope <url>: the URL's shape, and what kind of account owns it.
validate_scope() {
  api_scope "$1" >/dev/null
  check_scope_owner "$1"
}

# ask_url: prints the URL typed at the prompt. Needs a terminal; without one
# the URL has to come from --url.
ask_url() {
  local url
  [ -t 0 ] || die "install: --url is required for a new registration (no terminal to ask)"
  read -rp "GitHub organization or repository URL (https://github.com/<org> or https://github.com/<owner>/<repo>): " url
  [ -n "$url" ] || die "install: no URL given"
  printf '%s' "$url"
}

# ask_personal_repo <owner url>: prints the URL of the repository, in that
# personal account, that the typed answer names (a name, or a full URL).
# Needs a terminal; check_scope_owner has already refused without one.
ask_personal_repo() {
  local owner="${1%/}" answer url
  owner="${owner##*/}"
  echo "homefield: ${owner} is a personal account, which cannot have account-wide runners: a runner is registered for one repository." >&2
  read -rp "Repository of ${owner} to register for (name, or full URL): " answer
  [ -n "$answer" ] || die "install: no repository given"
  case "$answer" in
    https://*) url="${answer%/}" ;;
    *) url="https://github.com/${owner}/${answer}" ;;
  esac
  [[ "$url" =~ ^https://github\.com/([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)$ && "$(lower "${BASH_REMATCH[1]}")" = "$(lower "$owner")" ]] ||
    die "install: not a repository of ${owner}: ${answer}"
  printf '%s' "$url"
}

# announce_account <url> <group>: says which kind of account the registration
# is for and, for a personal one, the two separate limits. The caller's --group
# is passed in so that it can say a personal account ignores it.
announce_account() {
  local slug="${1%/}" group="$2" how="detected"
  slug="${slug#https://github.com/}"
  [ -z "$ACCOUNT_FORCE" ] || how="forced by --${ACCOUNT_FORCE}"
  case "$ACCOUNT_MODE" in
    personal)
      log "personal account (${slug%%/*}), ${how}. Two separate limits apply:"
      log "  - GitHub: no account-wide runners and no runner groups, so each repository registers on its own."
      log "  - HomeField: one VM runs one runner (until #14), so each personal repository needs its own --instance."
      log "Registering this runner for the repository ${slug} only."
      [ -z "$group" ] || log "--group ${group} is ignored: a personal account has no runner groups."
      ;;
    org) log "organization (${slug%%/*}), ${how}." ;;
    *) log "could not check whether ${slug%%/*} is a personal account or an organization (neither gh nor api.github.com answered); going on without it. --personal or --org skips the check." ;;
  esac
}

# prepare_registration: for cmd_install, whose url, group, name and replace
# it reads and sets (bash functions see their caller's locals). Asks for the
# URL if there is none, validates it, says which kind of account it is (a
# personal one is asked for a repository if the URL is only its owner), sorts
# out the runner group and the name.
prepare_registration() {
  [ -n "$url" ] || url="$(ask_url)" || exit 1
  validate_scope "$url"
  if [ "$ACCOUNT_MODE" = personal ] && [[ "${url%/}" =~ ^https://github\.com/[A-Za-z0-9_.-]+$ ]]; then
    url="$(ask_personal_repo "$url")" || exit 1
  fi
  announce_account "$url" "$group"
  ensure_group "$url" "${group:-homefield-ci}"
  [ -n "$name" ] || name="$(default_name)" || exit 1
  check_name_free "$url" "$name" "$replace"
}

# ── Runner name ─────────────────────────────────────────────────────────────
# The guest's hostname, lima-<instance>, is the same on every Mac, so a second
# Mac registering under it would take the first one's registration (#52). The
# default is this Mac's local hostname plus the instance instead: unique per
# Mac on a network, and it says which machine a runner is on.

# default_name: prints <local hostname>-<instance>, lower case, with anything
# but letters, digits, '.', '_' and '-' replaced by '-'.
default_name() {
  local host
  host="$(scutil --get LocalHostName 2>/dev/null)" || host=""
  [ -n "$host" ] || die "install: could not read this Mac's name (scutil --get LocalHostName); pass --name"
  lower "${host}-${INSTANCE}" | tr -c 'a-z0-9._\n-' '-'
}

# check_name_free <url> <name> <replace>: refuses a name that is already
# registered in the scope, before anything is created. Registration would
# refuse it too (provision.sh never passes --replace), but only after the VM
# is built. Names are compared ignoring case. A runners list that cannot be
# read is not a reason to stop, except for --replace, which has to find the
# registration it removes.
#
# --replace removes the old registration (remove_taken_name, after token
# retrieval but before provisioning) rather than using config.sh's --replace,
# which keeps the old registration's runner group and ignores the one asked for
# (actions/runner#4091). Sets REPLACE_ID to the id to remove.
REPLACE_ID=""
check_name_free() {
  local url="$1" name="$2" replace="$3" scope rows n status id taken="" taken_id="" page
  scope="$(api_scope "$url")" || exit 1
  page="$(runners_page "$url")" || exit 1
  if ! command -v gh >/dev/null || ! rows="$(gh api --paginate "${scope}/actions/runners?per_page=100" \
    --jq '.runners[] | [.name, .status, (.id | tostring)] | @tsv' 2>/dev/null)"; then
    [ "$replace" != 1 ] || die "--replace needs gh to list the runners at ${url} (org owner + admin:org, or repository admin); remove ${name} at ${page} instead and run this again without --replace"
    log "could not list the runners at ${url} to check that ${name} is free; registration refuses it if it is not"
    return 0
  fi
  while IFS=$'\t' read -r n status id; do
    [ -n "$n" ] || continue
    if [ "$(lower "$n")" = "$(lower "$name")" ]; then
      taken="$status"
      taken_id="$id"
    fi
  done <<<"$rows"
  [ -n "$taken" ] || return 0
  if [ "$replace" = 1 ]; then
    if [ "$taken" = online ]; then
      echo "homefield: warning: ${name} is registered and online at ${url}; --replace removes its registration, and the runner that has it stops working" >&2
    else
      log "${name} is registered (${taken}) at ${url}; --replace removes that registration before registering"
    fi
    REPLACE_ID="$taken_id"
    return 0
  fi
  if [ "$taken" = online ]; then
    die "a runner named ${name} is already registered and online at ${url}, most likely on another machine; pick another name with --name (${page})"
  fi
  die "a runner named ${name} is already registered (${taken}) at ${url}. If it is this Mac's old registration, run this again with --replace; otherwise pick another name with --name, or remove it at ${page}"
}

# remove_taken_name <url> <name>: for --replace, removes the registration
# check_name_free found under the name, so this one registers fresh, in the
# group asked for. This follows token retrieval but precedes provisioning;
# a failure between removal and registration leaves the name unregistered.
remove_taken_name() {
  local url="$1" name="$2" scope
  [ -n "$REPLACE_ID" ] || return 0
  scope="$(api_scope "$url")" || exit 1
  log "removing the registration of ${name} (id ${REPLACE_ID}) at ${url}"
  gh api -X DELETE "${scope}/actions/runners/${REPLACE_ID}" >/dev/null ||
    die "could not remove ${name} at ${url}; remove it at $(runners_page "$url") and run this again without --replace"
  REPLACE_ID=""
}

# ── Runner group ────────────────────────────────────────────────────────────
# The group is what keeps an organization's other repositories off the runner
# (docs/runbook.md, "Runner group"), so install makes sure it exists before
# the runner joins it, instead of leaving that to a manual step.

# list_groups_ids <org>: one line per runner group, tab separated: name,
# visibility, allows_public_repositories and id (the id for the calls that
# address a group by it). Tabs, because a name may have spaces.
list_groups_ids() {
  gh api --paginate "orgs/${1}/actions/runner-groups?per_page=100" \
    --jq '.runner_groups[] | [.name, .visibility, (.allows_public_repositories | tostring), (.id | tostring)] | @tsv' 2>/dev/null
}

# group_repositories <org> <group id>: the full names of the repositories a
# runner group admits, one per line. Meaningful for a group whose visibility is
# "selected"; the others admit repositories by their kind, not by a list.
group_repositories() {
  gh api --paginate "orgs/${1}/actions/runner-groups/${2}/repositories?per_page=100" \
    --jq '.repositories[].full_name' </dev/null 2>/dev/null
}

# group_runner_ids <org> <group id>: the ids of the runners in a runner group,
# one per line. GitHub's runner list does not say which group a runner is in,
# so the groups are asked instead.
group_runner_ids() {
  gh api --paginate "orgs/${1}/actions/runner-groups/${2}/runners?per_page=100" \
    --jq '.runners[].id' </dev/null 2>/dev/null
}

# find_runner_group <org> <runner id>: the runner-groups row (name, visibility,
# allows_public_repositories, id; tab separated) of the group the runner is in,
# found by asking each group which runners it holds. Status: 0 found (the row
# on stdout), 1 in none of the groups, 2 in none of the groups that answered
# (another group's list failed), 3 the groups cannot be listed.
find_runner_group() {
  local rows name vis pub gid ids unasked=0
  rows="$(list_groups_ids "$1" </dev/null)" || return 3
  while IFS=$'\t' read -r name vis pub gid; do
    [ -n "$gid" ] || continue
    if ids="$(group_runner_ids "$1" "$gid")"; then
      case $'\n'"$ids"$'\n' in
        *$'\n'"$2"$'\n'*)
          printf '%s\t%s\t%s\t%s\n' "$name" "$vis" "$pub" "$gid"
          return 0
          ;;
      esac
    else
      unasked=1
    fi
  done <<<"$rows"
  [ "$unasked" = 0 ] || return 2
  return 1
}

# group_unchecked <group> <why>: the group could not be checked or created.
# Registering anyway would put the runner in a group nobody has looked at, or
# fail at the end, so ask first (default no); without a terminal, stop.
group_unchecked() {
  echo "homefield: could not check or create the runner group ${1}: ${2}" >&2
  echo "homefield: create it by hand (docs/runbook.md, \"Runner group\"): selected repositories, public repositories off." >&2
  [ -t 0 ] || die "stopping: the runner group ${1} is unchecked and there is no terminal to ask (if you created and checked it, pass --group-exists)"
  local answer
  read -rp "Continue without checking the group? [y/N] " answer
  case "$answer" in
    [Yy]*) ;;
    *) die "stopped: create the group ${1}, then run this again" ;;
  esac
}

# group_assumed <group> <why>: with --group-exists, a group gh cannot list is
# taken as there, and the closing message still says it is unchecked. Only for
# a group gh could not look at: a list that worked and lacks it is not
# overridden. Registration fails if the group is missing after all.
GROUP_EXISTS=0
group_assumed() {
  [ "$GROUP_EXISTS" = 1 ] || return 1
  log "runner group ${1}: not checked (${2}); going on because of --group-exists"
}

# token_hint: without a terminal offer_scope_refresh says nothing, so say here
# that gh may have a login with admin:org behind GITHUB_TOKEN or GH_TOKEN.
token_hint() {
  [ ! -t 0 ] && [ -n "${GITHUB_TOKEN:-}${GH_TOKEN:-}" ] || return 0
  echo "homefield: GITHUB_TOKEN or GH_TOKEN is set, and gh uses it instead of its stored login. If that login has admin:org, run this again with them empty for this one command: GITHUB_TOKEN= GH_TOKEN= homefield install ..." >&2
}

# lower <text>: in lower case (bash 3.2 has no ${var,,}).
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# What ensure_group found, for the closing message: "personal" (a personal
# account has no groups), "repo" (no groups), "default" (every repository in
# the org), "wide" (warned about), "narrow", "created" or "unchecked".
GROUP_STATE=""
# The id of the group GROUP_STATE "narrow" or "created" is about (empty when
# unknown, or for any other state), for the listing of its repositories.
GROUP_ID=""

# The instance's state file on this Mac: what install did that reset has to
# undo, as `key=value` lines. Today one key, group_created=<org>/<group
# name>/<group id>, set only when install itself created the runner group (a
# group that was already there is never recorded, so reset never deletes
# it). Per instance, and outside the tool's own directory, which install.sh
# replaces on every update. docs/runbook.md, "Rolling back a failed install".
state_file() { printf '%s/%s.state' "${HOMEFIELD_STATE_DIR:-$HOME/.local/state/homefield}" "$INSTANCE"; }

# state_get <key>: its value, or nothing.
state_get() {
  local f
  f="$(state_file)"
  [ -f "$f" ] || return 0
  sed -n "s/^${1}=//p" "$f" | head -1
}

# state_set <key> <value>: written to a temp file next to the state file and
# moved over it, so a reader never sees half a file; other keys are kept.
state_set() {
  local f dir tmp
  f="$(state_file)"
  dir="$(dirname "$f")"
  mkdir -p "$dir" || return 1
  tmp="$(mktemp "$dir/.${INSTANCE}.state.XXXXXX")" || return 1
  {
    [ ! -f "$f" ] || awk -v k="$1" 'index($0, k "=") != 1' "$f"
    printf '%s=%s\n' "$1" "$2"
  } >"$tmp" || { rm -f "$tmp"; return 1; }
  mv -f "$tmp" "$f" || { rm -f "$tmp"; return 1; }
}

# ensure_group <url> <group>: for an organization URL, finds the group by name
# and warns when it is wider than it should be, or creates it. A repository
# URL has no groups, and Default always exists. GitHub treats group names
# case-insensitively, so they are compared that way. A personal account
# (ACCOUNT_MODE) has no groups at all: nothing is asked of GitHub.
ensure_group() {
  local url="$1" group="${2:-homefield-ci}" scope org groups="" name vis pub found=0 why="" out gid
  GROUP_ID=""
  scope="$(api_scope "$url")" || exit 1
  if [ "$ACCOUNT_MODE" = personal ]; then
    GROUP_STATE=personal
    return 0
  fi
  if [[ "$scope" != orgs/* ]]; then
    GROUP_STATE=repo
    return 0
  fi
  if [ "$(lower "$group")" = default ]; then
    GROUP_STATE=default
    return 0
  fi
  org="${scope#orgs/}"
  GROUP_STATE=unchecked

  if ! command -v gh >/dev/null; then
    group_assumed "$group" "gh is not installed" || group_unchecked "$group" "gh is not installed"
    return 0
  fi
  if ! groups="$(list_groups_ids "$org")"; then
    if offer_scope_refresh; then
      groups="$(list_groups_ids "$org")" || why="gh could not list the organization's runner groups, even after the scope refresh"
    else
      why="gh could not list the organization's runner groups (needs an org owner with the admin:org scope)"
    fi
    if [ -n "$why" ]; then
      group_assumed "$group" "$why" && return 0
      token_hint
      group_unchecked "$group" "$why"
      return 0
    fi
  fi
  # Listing groups needs admin:org, so the scope is there: a later failure
  # (the registration token) has another cause, and a refresh would not help.
  scope_refresh_asked=1

  while IFS=$'\t' read -r name vis pub gid; do
    [ "$(lower "$name")" = "$(lower "$group")" ] || continue
    found=1
    why=""
    case "$vis" in
      all) why="every repository in ${org} can use it" ;;
      private) why="every private repository in ${org} can use it" ;;
    esac
    [ "$pub" != true ] || why="${why:+${why}, and }public repositories can use it"
    if [ -n "$why" ]; then
      GROUP_STATE=wide
      echo "homefield: warning: runner group ${name} is wider than it should be: ${why}." >&2
      echo "homefield: narrow it to selected repositories with public ones off (docs/runbook.md, \"Runner group\")." >&2
    else
      GROUP_STATE=narrow
      GROUP_ID="$gid"
      log "runner group ${name} exists (selected repositories only, no public ones)"
    fi
  done <<<"$groups"
  [ "$found" = 0 ] || return 0

  [ "$GROUP_EXISTS" = 0 ] ||
    echo "homefield: warning: --group-exists, but gh listed the runner groups of ${org} and ${group} is not among them" >&2
  log "creating runner group ${group}: selected repositories, public repositories off"
  if ! out="$(gh api -X POST "orgs/${org}/actions/runner-groups" -f name="$group" -f visibility=selected \
    -F allows_public_repositories=false 2>&1)"; then
    # Only wording about the plan counts as a plan problem. A bare 403 or 422
    # can be SAML enforcement, a missing permission or a taken name, and the
    # plan advice (--group Default) would open the runner to every repository.
    case "$(lower "$out")" in
      *saml*)
        group_unchecked "$group" "the organization enforces SAML single sign-on and gh's token is not authorized for it (authorize it for SSO, or gh auth refresh): ${out}"
        ;;
      *plan* | *upgrade* | *"not available"*)
        echo "homefield: gh said: ${out}" >&2
        die "could not create runner group ${group}: custom runner groups need the GitHub Team plan or Enterprise. On the Free plan, pass --group Default (every repository in ${org} can then use the runner, so only do that if you trust them all) or use a repository URL (https://github.com/<owner>/<repo>)"
        ;;
      *)
        group_unchecked "$group" "gh said: ${out} (custom runner groups need the Team plan or Enterprise)"
        ;;
    esac
    return 0
  fi
  GROUP_STATE=created
  # Recorded now, before the VM exists, so that a failed install still leaves
  # reset the one fact it needs to undo this (the first "id" in the response is
  # the group's). Without an id, reset finds the group by its name.
  gid="$(printf '%s' "$out" | grep -o '"id": *[0-9][0-9]*' | head -1 | tr -cd '0-9')" || gid=""
  GROUP_ID="$gid"
  state_set group_created "${org}/${group}/${gid}" ||
    echo "homefield: warning: could not record that this install created the runner group ${group} (${org}); reset will not delete it, so remove it by hand if you roll back (docs/runbook.md, \"Rolling back a failed install\")" >&2
  log "created runner group ${group}. No repository can use it yet: homefield adopt --repo <owner>/<repo> adds one (docs/adopting.md, step 5)"
}

# ── Waiting for the runner ──────────────────────────────────────────────────
# ONLINE_WAIT_TRIES / ONLINE_WAIT_INTERVAL / ONLINE_PROGRESS_CYCLES can be
# overridden by environment variables (tests run the wait with 3 tries and no
# interval); the defaults below are for real runs.
ONLINE_WAIT_TRIES=${ONLINE_WAIT_TRIES:-18}
ONLINE_WAIT_INTERVAL=${ONLINE_WAIT_INTERVAL:-5}
# Progress reports during the wait: one every 3 poll cycles (every 15 seconds),
# so a long wait is never silent and never looks hung. If the runner comes
# online sooner, no progress output is needed. A value below 1 would make the
# divide in the loop below fail, so a non-number or non-positive falls back.
ONLINE_PROGRESS_CYCLES=${ONLINE_PROGRESS_CYCLES:-3}
[ "$ONLINE_PROGRESS_CYCLES" -ge 1 ] 2>/dev/null || ONLINE_PROGRESS_CYCLES=3

# wait_online <url> <name> <group>: until the runner shows as online on
# GitHub, up to about 90 seconds. Never fails: it only reports, because the
# registration has already happened and GitHub can be slow to list it. The
# runners list does not say which group a runner is in, so once the runner is
# online an organization's groups are asked for it (find_runner_group); when
# that cannot be done, the report says what was observed instead of assuming
# the expected group.
#
# What it saw is also left for setup's summary, whatever the log said:
# WAIT_RESULT is "online", "not-online" (the wait ran out; WAIT_SEEN is the
# status GitHub listed, if any) or "unchecked" (nothing could be asked).
# When online, WAIT_LABELS is GitHub's comma-separated label list, and for an
# organization WAIT_GROUP_STATE says whether the groups confirmed the runner is
# in the expected group ("match"), in another ("mismatch", WAIT_GROUP naming it)
# or could not say ("unconfirmed"); empty when the groups were not asked.
WAIT_RESULT=""
WAIT_SEEN=""
WAIT_LABELS=""
WAIT_GROUP=""
WAIT_GROUP_STATE=""
wait_online() {
  local url="$1" name="$2" group="$3" scope org rows="" n status rid labels grp row rc tries=0 page seen=""
  WAIT_RESULT="unchecked"
  WAIT_SEEN=""
  WAIT_LABELS=""
  WAIT_GROUP=""
  WAIT_GROUP_STATE=""
  page="$(runners_page "$url")" || exit 1
  if [ -z "$name" ] || ! command -v gh >/dev/null; then
    log "check that the runner is online at ${page}"
    return 0
  fi
  scope="$(api_scope "$url")" || exit 1
  log "waiting for ${name} to show as online (up to $((ONLINE_WAIT_TRIES * ONLINE_WAIT_INTERVAL)) s)"
  while [ "$tries" -lt "$ONLINE_WAIT_TRIES" ]; do
    # Progress: the first 15 seconds give no feedback, then a message every
    # 15 seconds while the wait continues.
    if [ $((tries % ONLINE_PROGRESS_CYCLES)) -eq 0 ] && [ "$tries" -gt 0 ]; then
      log "waiting for ${name} (up to $((ONLINE_WAIT_TRIES * ONLINE_WAIT_INTERVAL)) s, waited $((tries * ONLINE_WAIT_INTERVAL)) s)"
    fi
    if ! rows="$(gh api --paginate "${scope}/actions/runners?per_page=100" \
      --jq '.runners[] | [.name, .status, (.id | tostring), (.labels | map(.name) | join(","))] | @tsv' 2>/dev/null)"; then
      log "could not read the runners list with gh; check that the runner is online at ${page}"
      return 0
    fi
    while IFS=$'\t' read -r n status rid labels; do
      [ "$n" = "$name" ] || continue
      seen="$status"
      if [ "$status" = online ]; then
        WAIT_RESULT=online
        WAIT_LABELS="$labels"
        if [[ "$scope" == orgs/* ]]; then
          org="${scope#orgs/}"
          rc=0
          row="$(find_runner_group "$org" "$rid")" || rc=$?
          case $rc in
            0)
              IFS=$'\t' read -r grp _ <<<"$row"
              WAIT_GROUP="$grp"
              if [ "$grp" = "$group" ]; then
                WAIT_GROUP_STATE=match
                log "${name} is online: labels ${labels}, group ${grp}"
              else
                WAIT_GROUP_STATE=mismatch
                log "${name} is online: labels ${labels}, group ${grp} (expected ${group})"
              fi
              ;;
            1)
              WAIT_GROUP_STATE=unconfirmed
              log "${name} is online: labels ${labels}, in none of the runner groups gh listed for ${org}"
              ;;
            2)
              WAIT_GROUP_STATE=unconfirmed
              log "${name} is online: labels ${labels}, group not found (gh could not list the runners of every runner group in ${org})"
              ;;
            *)
              WAIT_GROUP_STATE=unconfirmed
              log "${name} is online: labels ${labels}, group not checked (gh could not list the runner groups of ${org})"
              ;;
          esac
        else
          log "${name} is online: labels ${labels}"
        fi
        return 0
      fi
    done <<<"$rows"
    tries=$((tries + 1))
    [ "$tries" -ge "$ONLINE_WAIT_TRIES" ] || sleep "$ONLINE_WAIT_INTERVAL"
  done
  WAIT_RESULT="not-online"
  WAIT_SEEN="$seen"
  echo "homefield: warning: ${name} is not online after $((ONLINE_WAIT_TRIES * ONLINE_WAIT_INTERVAL)) s (${seen:-not listed yet}); check ${page} and bin/homefield status" >&2
  return 0
}

# ── Provisioning ────────────────────────────────────────────────────────────
# run_provision <stdin text> [VAR=value ...]
run_provision() {
  local input="$1"
  shift
  limactl copy "$PROVISION" "${INSTANCE}:${GUEST_PROVISION}"
  printf '%s' "$input" | guest_stdin sudo "$@" bash "$GUEST_PROVISION"
}

enable_autostart() {
  if limactl autostart enable "$INSTANCE" >/dev/null 2>&1 ||
    limactl start-at-login --enabled "$INSTANCE" >/dev/null 2>&1; then
    log "VM ${INSTANCE} starts at login"
  else
    log "could not enable autostart; see docs/runbook.md, Setup (Autostart)" >&2
  fi
}

# ── Commands ────────────────────────────────────────────────────────────────
# group_advice <group> <slug> <first> <rest>: the advice about the runner group
# that ensure_group found (GROUP_STATE), for install's closing message and
# setup's next steps. <first> starts its first line and <rest> the following
# ones, so each caller can make it a bullet or a numbered item.
group_advice() {
  local group="${1:-homefield-ci}" slug="$2" first="$3" rest="$4" verb=install
  [ "$SETUP" != 1 ] || verb=setup
  case "$GROUP_STATE" in
    narrow | created)
      echo "${first}It is in the runner group ${group}, which admits only the"
      echo "${rest}repositories added to it: homefield adopt --repo <owner>/<repo> adds one."
      ;;
    default)
      echo "${first}It is in the Default group: every repository in the organization can"
      echo "${rest}use it (docs/runbook.md, \"Runner group\")."
      ;;
    wide)
      echo "${first}Narrow the runner group ${group} as warned above, then add"
      echo "${rest}the repositories that should use it (docs/runbook.md, \"Runner group\")."
      ;;
    unchecked)
      echo "${first}Check the runner group ${group} by hand: selected repositories,"
      echo "${rest}public ones off (docs/runbook.md, \"Runner group\")."
      ;;
    personal)
      echo "${first}It serves only ${slug}: a personal account has no account-wide runners or"
      echo "${rest}runner groups. Another repository needs its own registration and its own VM:"
      echo "${rest}homefield ${verb} --instance <name> --url https://github.com/<owner>/<repo>."
      ;;
  esac
}

# registered_next_steps <group> <url>: install's closing advice, by what
# ensure_group found (GROUP_STATE).
registered_next_steps() {
  local group="$1" slug="${2%/}"
  slug="${slug#https://github.com/}"
  echo
  echo "Registered. Next:"
  group_advice "$group" "$slug" "  - " "    "
  cat <<EOF
  - Route jobs from a repository: docs/adopting.md, then
    homefield adopt --repo <owner>/<repo> (group access and the switch).
  - bin/homefield status   shows the runner at any time.
EOF
}

# ── setup's summary ─────────────────────────────────────────────────────────
# `homefield setup` is install behind a stricter gate (preflight must pass in
# full) and with a closing summary instead of registered_next_steps. A line
# starts with a check mark for what was done and is true, or "!" for what
# needs attention; nothing is claimed that was not seen. SETUP is 1 for setup.
SETUP=0
# What the VM's status was before install touched it (empty: there was none).
SETUP_VM_WAS=""

# setup_vm_lines: the VM and its isolation. Both are facts by the time this is
# called: ensure_vm left the VM running, and verify_isolation dies otherwise.
setup_vm_lines() {
  if [ -z "$SETUP_VM_WAS" ]; then
    echo "✓ VM ${INSTANCE} created (Running)"
  elif [ "$SETUP_VM_WAS" = Running ]; then
    echo "✓ VM ${INSTANCE} already existed (Running)"
  else
    echo "✓ VM ${INSTANCE} already existed (${SETUP_VM_WAS}); started"
  fi
  echo "✓ Isolation verified (no host mounts)"
}

# setup_group_line <group> <slug>: the runner group, by what ensure_group found.
setup_group_line() {
  local group="${1:-homefield-ci}" slug="$2"
  case "$GROUP_STATE" in
    created) echo "✓ Runner group ${group} created (selected repositories, public off)" ;;
    narrow) echo "✓ Runner group ${group} exists (selected repositories, public off)" ;;
    default) echo "✓ Runner group Default (every repository in the organization can use it)" ;;
    wide) echo "! Runner group ${group} is wider than recommended: narrow it (docs/runbook.md, \"Runner group\")" ;;
    unchecked) echo "! Runner group ${group} was not checked: confirm it by hand (selected repositories, public off)" ;;
    personal) echo "✓ Registered to ${slug} only (a personal account has no runner groups)" ;;
    repo) echo "✓ Registered to ${slug} only (a repository has no runner groups)" ;;
  esac
}

# setup_runner_lines <url> <name> <id>: the registration, and what wait_online
# saw of the runner on GitHub.
setup_runner_lines() {
  local url="$1" name="$2" id="$3"
  if [ -z "$name" ]; then
    echo "! Runner registered, but its name could not be read from the VM: see $(runners_page "$url")"
  elif [ -n "$id" ]; then
    echo "✓ Runner registered (${name}, id ${id})"
  else
    echo "✓ Runner registered (${name})"
  fi
  case "$WAIT_RESULT" in
    online)
      case "$WAIT_GROUP_STATE" in
        match) echo "✓ Runner online (labels: ${WAIT_LABELS//,/ }; group ${WAIT_GROUP})" ;;
        *) echo "✓ Runner online (labels: ${WAIT_LABELS//,/ })" ;;
      esac
      case "$WAIT_GROUP_STATE" in
        mismatch) echo "! Runner is in the runner group ${WAIT_GROUP}, not the one asked for: check it at $(runners_page "$url")" ;;
        unconfirmed) echo "! Its runner group could not be confirmed: check it at $(runners_page "$url")" ;;
      esac
      ;;
    not-online)
      echo "! Runner not online yet (GitHub lists it as: ${WAIT_SEEN:-not listed yet}): check $(runners_page "$url") and homefield status"
      ;;
    *)
      echo "! Runner online check skipped (GitHub could not be asked): check $(runners_page "$url")"
      ;;
  esac
}

# setup_repositories <slug>: who can use the runner now. This is group access,
# not whether a repository's CI_RUNNER switch is on, so it says "can use". A
# list that could not be read is said so, never printed as an empty one.
setup_repositories() {
  local slug="$1" org="${1%%/*}" repos r
  echo
  echo "Repositories that can use this runner:"
  case "$GROUP_STATE" in
    personal | repo)
      echo "  ${slug} (this runner is registered to it)"
      ;;
    narrow | created)
      if [ -z "$GROUP_ID" ]; then
        echo "  could not be listed (the group's id is not known); see the runner group's page in ${org}'s settings"
      elif repos="$(group_repositories "$org" "$GROUP_ID")"; then
        if [ -z "$repos" ]; then
          echo "  none yet: homefield adopt --repo <owner>/<repo> adds one"
        else
          while IFS= read -r r; do
            if [ -n "$r" ]; then echo "  ${r}"; fi
          done <<<"$repos"
        fi
      else
        echo "  could not be listed (gh could not read the runner group's repositories); see the runner group's page in ${org}'s settings"
      fi
      ;;
    default) echo "  every repository in ${org} (the Default group admits them all)" ;;
    wide) echo "  not listed: this group admits repositories by kind, not from a list (narrow it, as warned above)" ;;
    *) echo "  not listed: the runner group was not checked, so who can use it is unknown" ;;
  esac
}

# setup_next_steps <group> <slug>: what to do now, then who can use the runner.
setup_next_steps() {
  local group="$1" slug="$2"
  echo
  echo "Next steps:"
  echo "  1. Route a repository: homefield adopt --repo <owner>/<repo>"
  echo "     (add --setup and it opens the pull request with the routing edits)"
  echo "  2. See docs/adopting.md for the full guide"
  group_advice "$group" "$slug" "  3. " "     "
  setup_repositories "$slug"
}

# setup_summary <group> <url> <name> <id>: the end of a fresh setup.
setup_summary() {
  local group="$1" url="$2" slug="${2%/}"
  slug="${slug#https://github.com/}"
  echo
  setup_vm_lines
  setup_group_line "$group" "$slug"
  setup_runner_lines "$url" "$3" "$4"
  setup_next_steps "$group" "$slug"
}

# setup_upgrade_summary: the end of a setup that found its runner registered and
# upgraded it. The registration and its group were not looked at again, so
# neither is claimed. Its settings are read back from the VM for the line.
setup_upgrade_summary() {
  local name="" id=""
  { IFS= read -r name || true; IFS= read -r id || true; } < <(runner_setting agentName agentId)
  echo
  setup_vm_lines
  if [ -n "$name" ] && [ -n "$id" ]; then
    echo "✓ Runner ${name} (id ${id}) was already registered: upgraded in place"
  elif [ -n "$name" ]; then
    echo "✓ Runner ${name} was already registered: upgraded in place"
  else
    echo "✓ The runner was already registered: upgraded in place"
  fi
  echo
  echo "Next steps:"
  echo "  1. Route a repository: homefield adopt --repo <owner>/<repo>"
  echo "     (add --setup and it opens the pull request with the routing edits)"
  echo "  2. See docs/adopting.md for the full guide"
  echo "  3. homefield status shows the runner at any time"
}

# cmd_setup: install's options and steps, with the stricter preflight gate and
# the summary (SETUP, read by cmd_install).
cmd_setup() {
  SETUP=1
  cmd_install "$@"
}

cmd_install() {
  local url="" label="" name="" group="" packages="" packages_set=0 cpus="" memory="" autostart=1 replace=0 cmd=install
  [ "$SETUP" != 1 ] || cmd=setup
  while [ $# -gt 0 ]; do
    case "$1" in
      --url) url="${2:?--url needs a value}"; shift 2 ;;
      --label) label="${2:?--label needs a value}"; shift 2 ;;
      --name) name="${2:?--name needs a value}"; shift 2 ;;
      --group) group="${2:?--group needs a value}"; shift 2 ;;
      --packages) packages="${2?--packages needs a value (may be empty)}"; packages_set=1; shift 2 ;;
      --cpus) cpus="${2:?--cpus needs a value}"; shift 2 ;;
      --memory) memory="${2:?--memory needs a value}"; shift 2 ;;
      --no-autostart) autostart=0; shift ;;
      --group-exists) GROUP_EXISTS=1; shift ;;
      --replace) replace=1; shift ;;
      --personal)
        [ "$ACCOUNT_FORCE" != org ] || die "${cmd}: --personal and --org cannot be used together"
        ACCOUNT_FORCE=personal; shift ;;
      --org)
        [ "$ACCOUNT_FORCE" != personal ] || die "${cmd}: --personal and --org cannot be used together"
        ACCOUNT_FORCE=org; shift ;;
      *) die "${cmd}: unknown option $1 (see bin/homefield help)" ;;
    esac
  done
  # The readiness report comes first, before anything is created, and install
  # then gates on its own subset of it — macOS, arm64, Lima — which check_host
  # is: gh, python3 and brew are what the tool needs elsewhere (adopt, report,
  # the one-liner), and install itself can proceed without them.
  # setup stops on a failed check instead (FAIL only: a WARN is not one), and
  # before anything else, so a failed setup has created and touched nothing.
  if [ "$SETUP" = 1 ]; then
    local preflight_rc=0
    cmd_preflight || preflight_rc=$?
    [ "$preflight_rc" -eq 0 ] ||
      die "setup stopped: fix the failed checks above and run it again; nothing was created"
  else
    cmd_preflight || true
  fi
  check_host
  # Everything that can be checked is checked before anything is created: the
  # URL (asked for if it was not given), the organization, the runner group.
  # Whether the instance is registered is only known once its VM is up and
  # verified, but a VM that does not exist yet is certainly not registered, so
  # in that case it all happens first. With a VM already there, a URL that
  # was given is still validated before the VM is started, and the rest waits
  # for the answer to "registered?" (a registered instance is just upgraded).
  local prepared=0
  vm_lookup
  SETUP_VM_WAS="$VM_STATUS"
  if [ -z "$VM_STATUS" ]; then
    prepare_registration
    prepared=1
  elif [ -n "$url" ]; then
    validate_scope "$url"
  fi
  ensure_vm "$cpus" "$memory"
  verify_isolation

  if is_registered; then
    log "${INSTANCE} is already registered; upgrading instead (registration settings are kept)"
    local args=()
    [ "$packages_set" = 1 ] && args+=(--packages "$packages")
    cmd_upgrade "${args[@]+"${args[@]}"}"
    [ "$SETUP" != 1 ] || setup_upgrade_summary
    return
  fi

  [ "$prepared" = 1 ] || prepare_registration
  local env=(RUNNER_URL="$url" RUNNER_NAME="$name")
  [ -n "$label" ] && env+=(RUNNER_LABEL="$label")
  [ -n "$group" ] && env+=(RUNNER_GROUP="$group")
  [ "$packages_set" = 1 ] && env+=(RUNNER_EXTRA_PACKAGES="$packages")

  local token
  token="$(get_token registration "$url")"
  remove_taken_name "$url" "$name"
  log "provisioning ${INSTANCE} and registering at ${url}"
  run_provision "RUNNER_TOKEN=${token}"$'\n' "${env[@]}"
  token=""
  [ "$autostart" = 1 ] && enable_autostart
  # The name and id the runner registered under, read back from its config.
  local registered_name="" registered_id=""
  { IFS= read -r registered_name || true; IFS= read -r registered_id || true; } < <(runner_setting agentName agentId)
  wait_online "$url" "$registered_name" "${group:-homefield-ci}"
  if [ "$SETUP" = 1 ]; then
    setup_summary "${group:-homefield-ci}" "$url" "$registered_name" "$registered_id"
  else
    registered_next_steps "${group:-homefield-ci}" "$url"
  fi
}

cmd_upgrade() {
  local packages="" packages_set=0 force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --packages) packages="${2?--packages needs a value (may be empty)}"; packages_set=1; shift 2 ;;
      --force) force=1; shift ;;
      *) die "upgrade: unknown option $1 (see bin/homefield help)" ;;
    esac
  done
  check_host
  vm_lookup
  [ -n "$VM_STATUS" ] || die "no VM ${INSTANCE}; run bin/homefield install"
  ensure_vm "" ""
  verify_isolation
  is_registered || die "${INSTANCE} is not registered; run bin/homefield install --url ..."
  # A registration GitHub removed would only fail at the end, when the runner
  # cannot start a session; one that cannot be checked goes ahead.
  local url="" id="" name="" on=0
  { read -r url || true; read -r id || true; read -r name || true; } < <(runner_setting gitHubUrl agentId agentName)
  runner_on_github "$url" "$id" || on=$?
  [ "$on" != 1 ] || die "GitHub no longer has ${INSTANCE}'s runner (id ${id}) at ${url}: it removes runners that have not connected for more than 14 days. Nothing was stopped. Register it again: $(removed_recovery "$url" "$name")"
  # An upgrade can restart Docker (apt) or the runner (a new binary), which
  # would take down a running job.
  if is_job_running && [ "$force" != 1 ]; then
    die "a job is running on ${INSTANCE}; try again when it is idle, or pass --force"
  fi
  stop_runner
  local env=()
  [ "$packages_set" = 1 ] && env+=(RUNNER_EXTRA_PACKAGES="$packages")
  log "upgrading ${INSTANCE}"
  # provision.sh starts the service again at the end, and waits until it is
  # listening for jobs.
  run_provision "" "${env[@]+"${env[@]}"}"
  runner_back
}

cmd_status() {
  [ $# -eq 0 ] || die "status takes no options besides --instance"
  command -v limactl >/dev/null || die "Lima is not installed"
  local status
  if ! status="$(vm_status)"; then
    echo "VM ${INSTANCE}: unknown (could not ask Lima)"
    return 1
  fi
  if [ -z "$status" ]; then
    echo "VM ${INSTANCE}: not created"
    return
  fi
  echo "VM ${INSTANCE}: ${status}"
  [ "$status" = "Running" ] || return 0
  local reg=0
  registered || reg=$?
  if [ "$reg" -ge 2 ]; then
    echo "runner: unknown (could not ask the VM)"
    return 1
  fi
  if [ "$reg" = 1 ]; then
    echo "runner: not registered"
    return
  fi
  local name url id removed=0 on=0
  # Fewer than three lines read must reach the check below, not stop here.
  load_runner_settings
  name="$RS_NAME" url="$RS_URL" id="$RS_ID"
  if [ -n "$name" ] && [ -n "$url" ]; then
    echo "runner: ${name}, registered at ${url}"
    runner_on_github "$url" "$id" || on=$?
    case "$on" in
      0) echo "github: listed" ;;
      1)
        echo "github: NOT listed: GitHub removes runners that have not connected for more than 14 days."
        echo "  Register it again: $(removed_recovery "$url" "$name")"
        removed=1
        ;;
      3)
        echo "github: not checked (timed out after ${GH_TIMEOUT}s; the network may be down)"
        ;;
      *)
        if [ -n "$id" ]; then
          echo "github: not checked (needs gh with admin access to ${url})"
        else
          echo "github: not checked (no runner id in the VM's settings)"
        fi
        ;;
    esac
  else
    # The registration exists (.runner is there) but its details could not be
    # read just now; the rest of the report still stands on its own.
    echo "runner: registered, but its details could not be read"
  fi
  if runner_service_state; then
    echo "service: running"
  else
    echo "service: NOT running (${SERVICE_UNIT:-no service installed})"
  fi
  local job=0 unknown=0
  job_running || job=$?
  case "$job" in
    0) echo "job: running" ;;
    1) echo "job: idle" ;;
    *) echo "job: unknown (could not ask the VM)"; unknown=1 ;;
  esac
  echo "runner version: $(runner_version)"
  local npm=0
  npm_state || npm=$?
  case "$npm" in
    0) echo "npm: ok" ;;
    1)
      echo "npm: BROKEN (a runner self-update can flatten the externals symlinks; docs/runbook.md, \"Runner updates\")"
      unknown=1
      ;;
    *) echo "npm: unknown (could not ask the VM)"; unknown=1 ;;
  esac
  echo "extra packages: $(runner_extra_packages)"
  [ -n "$url" ] && echo "labels: see $(runners_page "$url") (not stored in the VM)"
  [ "$removed" = 0 ] || return 1
  return "$unknown"
}

# ── diagnose ────────────────────────────────────────────────────────────────
# One read-only report over state the other commands already look at, for the
# moment an install, upgrade or adopt has gone wrong: the VM (status's checks,
# plus isolation), the runner group on GitHub's side, and preflight's
# prerequisites. It collects everything into DG_* first and prints afterwards,
# so the human and the --json form say the same thing, and --json prints
# nothing but the JSON on stdout.
#
# Read-only is a property to keep: nothing here starts or stops the VM or the
# runner, registers, or writes. `limactl shell` starts a stopped instance, so
# the guest is only asked about a VM that lists as Running. Unlike the
# loopback probe of install, nothing opens a listener on the Mac.
#
# Every gh call is bounded by runner_on_github's GH_TIMEOUT, which comes first
# and decides whether the later ones are made at all: the runner group and its
# repositories are only read once GitHub has answered it.

# json_str <text>: <text> as a JSON string literal. Plain bash: a stock Mac has
# no jq, and its python3 may be only a stub. Escapes the quote, the backslash
# and every control character; the rest, UTF-8 included, passes through.
json_str() {
  local s="$1" out="" c i n code
  case "$s" in
    *[\"\\[:cntrl:]]*) ;;
    *) printf '"%s"' "$s"; return 0 ;;
  esac
  n=${#s}
  for ((i = 0; i < n; i++)); do
    c="${s:i:1}"
    case "$c" in
      '"') out="$out\\\"" ;;
      \\) out="$out\\\\" ;;
      $'\n') out="$out\\n" ;;
      $'\r') out="$out\\r" ;;
      $'\t') out="$out\\t" ;;
      [[:cntrl:]]) printf -v code '\\u%04x' "'$c"; out="$out$code" ;;
      *) out="$out$c" ;;
    esac
  done
  printf '"%s"' "$out"
}
# json_nstr <text>: json_str, or null for an empty text.
json_nstr() { if [ -n "$1" ]; then json_str "$1"; else printf null; fi; }
# json_bool <yes|no|true|false>: true or false; null for anything else.
json_bool() {
  case "$1" in
    yes | true) printf true ;;
    no | false) printf false ;;
    *) printf null ;;
  esac
}
# json_words <text>: the words of <text> as a JSON array of strings.
json_words() {
  local words=() i first=1
  read -ra words <<<"$1"
  printf '['
  for ((i = 0; i < ${#words[@]}; i++)); do
    [ "$first" = 1 ] || printf ', '
    first=0
    json_str "${words[i]}"
  done
  printf ']'
}
# json_lines <text>: the lines of <text> as a JSON array of strings.
json_lines() {
  local line first=1
  printf '['
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    [ "$first" = 1 ] || printf ', '
    first=0
    json_str "$line"
  done <<<"$1"
  printf ']'
}

# What diagnose found. A state is a short word; "skipped" says the question was
# not asked, and DG_SKIP_WHY why (the first reason the guest checks stopped).
DG_CREATED="" DG_VM_STATUS="" DG_GUEST="" DG_SKIP_WHY=""
DG_ISO="" DG_ISO_WHY="" DG_REG="" DG_NAME="" DG_URL="" DG_ID=""
DG_GH="" DG_GH_WHY="" DG_GH_STATUS="" DG_GH_BUSY=""
DG_SVC="" DG_UNIT="" DG_VER="" DG_PKGS_STATE="" DG_PKGS="" DG_NPM=""
DG_SCOPE="" DG_GROUP="" DG_GROUP_WHY="" DG_GROUP_NAME="" DG_GROUP_ID=""
DG_GROUP_VIS="" DG_GROUP_PUB="" DG_REPOS=""
DG_P_CHECK=() DG_P_MSG=() DG_P_FIX=() DG_WARN=() DG_HINT=()

dg_reset() {
  DG_CREATED="unknown" DG_VM_STATUS="" DG_GUEST="skipped" DG_SKIP_WHY=""
  DG_ISO="skipped" DG_ISO_WHY="" DG_REG="skipped" DG_NAME="" DG_URL="" DG_ID=""
  DG_GH="skipped" DG_GH_WHY="" DG_GH_STATUS="" DG_GH_BUSY=""
  DG_SVC="skipped" DG_UNIT="" DG_VER="" DG_PKGS_STATE="skipped" DG_PKGS="" DG_NPM="skipped"
  DG_SCOPE="" DG_GROUP="skipped" DG_GROUP_WHY="" DG_GROUP_NAME="" DG_GROUP_ID=""
  DG_GROUP_VIS="" DG_GROUP_PUB="" DG_REPOS=""
  DG_P_CHECK=() DG_P_MSG=() DG_P_FIX=() DG_WARN=() DG_HINT=()
}
# dg_problem <check> <what is wrong> <what fixes it>: makes the run exit 1.
dg_problem() {
  DG_P_CHECK+=("$1")
  DG_P_MSG+=("$2")
  DG_P_FIX+=("$3")
}
# dg_warn <text>: something that could not be checked; not a problem found.
dg_warn() { DG_WARN+=("$1"); }
# dg_hint <text>: a next step, for a runner that is otherwise healthy.
dg_hint() { DG_HINT+=("$1"); }

# dg_collect_guest: the checks that ask the VM, for one that is Running. They
# stop at the first answer that makes the rest meaningless (the guest cannot be
# asked, no runner is registered), saying so in DG_SKIP_WHY.
dg_collect_guest() {
  local rc=0 on=0 raw words=() i
  DG_GUEST="checked"
  isolation_probe || rc=$?
  case "$rc" in
    0) DG_ISO="verified" ;;
    1)
      DG_ISO="failed"
      DG_ISO_WHY="$ISOLATION_WHY"
      dg_problem isolation "$ISOLATION_WHY" "recreate the VM without host mounts: bin/homefield uninstall --instance ${INSTANCE}, then install again (docs/runbook.md, \"Setup\")"
      ;;
    *)
      DG_ISO="unknown"
      DG_ISO_WHY="$ISOLATION_WHY"
      DG_SKIP_WHY="the VM could not be asked"
      dg_problem isolation "$ISOLATION_WHY" "limactl shell ${INSTANCE} true shows why the VM does not answer"
      return 0
      ;;
  esac
  rc=0
  registered || rc=$?
  case "$rc" in
    0) DG_REG="yes" ;;
    1)
      DG_REG="no"
      DG_SKIP_WHY="no runner is registered"
      dg_problem registration "no runner is registered in VM ${INSTANCE}" "bin/homefield install --instance ${INSTANCE} --url https://github.com/<org>[/<repo>]"
      return 0
      ;;
    *)
      DG_REG="unknown"
      DG_SKIP_WHY="the VM could not be asked"
      dg_problem registration "could not ask VM ${INSTANCE} whether its runner is registered" "limactl shell ${INSTANCE} true shows why the VM does not answer"
      return 0
      ;;
  esac
  load_runner_settings
  DG_NAME="$RS_NAME" DG_URL="$RS_URL" DG_ID="$RS_ID"
  if [ -z "$DG_NAME" ] || [ -z "$DG_URL" ]; then
    DG_GH_WHY="the runner's settings could not be read"
    dg_problem registration "the runner is registered, but its settings (${RUNNER_HOME}/.runner) could not be read" "see docs/runbook.md, \"Failure modes\""
  else
    runner_on_github "$DG_URL" "$DG_ID" || on=$?
    case "$on" in
      0)
        DG_GH="listed"
        DG_GH_STATUS="$RUNNER_GH_STATUS"
        DG_GH_BUSY="$RUNNER_GH_BUSY"
        if [ "$DG_GH_STATUS" = offline ]; then
          dg_problem github "GitHub lists the runner ${DG_NAME} as offline" "see docs/runbook.md, \"Failure modes\" (the service below, and the VM's network)"
        fi
        ;;
      1)
        DG_GH="not-listed"
        dg_problem github "GitHub does not list the runner ${DG_NAME}: it removes runners that have not connected for more than 14 days" "$(removed_recovery "$DG_URL" "$DG_NAME")"
        ;;
      3)
        DG_GH="timed-out"
        DG_GH_WHY="timed out after ${GH_TIMEOUT}s; the network may be down"
        dg_warn "GitHub was not asked: ${DG_GH_WHY}"
        ;;
      *)
        DG_GH="not-checked"
        if [ -n "$DG_ID" ]; then
          DG_GH_WHY="needs gh with admin access to ${DG_URL}"
        else
          DG_GH_WHY="no runner id in the VM's settings"
        fi
        dg_warn "GitHub was not asked: ${DG_GH_WHY}"
        ;;
    esac
  fi
  if runner_service_state; then
    DG_SVC="running"
    DG_UNIT="$SERVICE_UNIT"
  else
    DG_SVC="stopped"
    DG_UNIT="$SERVICE_UNIT"
    if [ -n "$SERVICE_UNIT" ]; then
      dg_problem service "the runner's service ${SERVICE_UNIT} is not running" "limactl shell ${INSTANCE} sudo systemctl start ${SERVICE_UNIT}"
    else
      dg_problem service "the runner has no service installed" "bin/homefield install --instance ${INSTANCE} (on a registered runner this re-provisions it)"
    fi
  fi
  DG_VER="$(runner_version)"
  raw="$(runner_extra_packages)"
  read -ra words <<<"$raw"
  for ((i = 0; i < ${#words[@]}; i++)); do
    DG_PKGS="${DG_PKGS:+$DG_PKGS }${words[i]}"
  done
  DG_PKGS_STATE="listed"
  rc=0
  npm_state || rc=$?
  case "$rc" in
    0) DG_NPM="ok" ;;
    1)
      DG_NPM="broken"
      dg_problem npm "the runner's bundled npm is broken: JS actions fail at \"Set up runner\"" "bin/homefield upgrade --instance ${INSTANCE} (docs/runbook.md, \"Runner updates\")"
      ;;
    *)
      DG_NPM="unknown"
      dg_problem npm "could not ask VM ${INSTANCE} whether the runner's npm works" "limactl shell ${INSTANCE} true shows why the VM does not answer"
      ;;
  esac
}

# dg_collect_vm: whether the VM is there, and for a Running one the guest
# checks. Anything else is reported and the guest is left alone.
dg_collect_vm() {
  if ! command -v limactl >/dev/null 2>&1; then
    # The prerequisites already carry this as a problem.
    DG_SKIP_WHY="Lima is not installed"
    return 0
  fi
  if ! DG_VM_STATUS="$(vm_status)"; then
    DG_VM_STATUS=""
    DG_SKIP_WHY="Lima could not be asked"
    dg_problem vm "could not ask Lima about VM ${INSTANCE} (limactl list failed, or lists it without a status)" "limactl list"
    return 0
  fi
  if [ -z "$DG_VM_STATUS" ]; then
    DG_CREATED="no"
    DG_SKIP_WHY="the VM does not exist"
    dg_problem vm "VM ${INSTANCE} is not created" "bin/homefield install --instance ${INSTANCE} --url https://github.com/<org>[/<repo>]"
    return 0
  fi
  DG_CREATED="yes"
  if [ "$DG_VM_STATUS" != "Running" ]; then
    DG_SKIP_WHY="the VM is ${DG_VM_STATUS}, and diagnose never starts it"
    dg_problem vm "VM ${INSTANCE} is ${DG_VM_STATUS}, not Running: the runner takes no jobs" "limactl start ${INSTANCE}"
    return 0
  fi
  dg_collect_guest
}

# dg_collect_group: the runner group the runner is in, from GitHub. Only an
# organization's runner has one; a repository's (and so a personal account's)
# registration has none, which is not an error.
dg_collect_group() {
  local scope org row name vis pub gid rc wide="" repos
  if [ -z "$DG_URL" ]; then
    DG_GROUP_WHY="$DG_SKIP_WHY"
    [ -n "$DG_GROUP_WHY" ] || DG_GROUP_WHY="the runner's registration was not read"
    return 0
  fi
  if ! scope="$(api_scope "$DG_URL" 2>/dev/null)"; then
    DG_GROUP_WHY="the runner's URL (${DG_URL}) is not an organization or repository"
    return 0
  fi
  case "$scope" in
    repos/*)
      DG_SCOPE="repository"
      DG_GROUP="n/a"
      return 0
      ;;
  esac
  DG_SCOPE="organization"
  org="${scope#orgs/}"
  if [ "$DG_GH" != "listed" ]; then
    DG_GROUP_WHY="GitHub did not list the runner, so its group is unknown"
    return 0
  fi
  # Reached only after GitHub answered the runner list in time (see above).
  # The runner list names no group, so find_runner_group asks each group which
  # runners it holds.
  rc=0
  row="$(find_runner_group "$org" "$DG_ID")" || rc=$?
  if [ "$rc" = 3 ]; then
    DG_GROUP="not-checked"
    DG_GROUP_WHY="gh could not list the runner groups of ${org} (needs an organization owner with the admin:org scope)"
    dg_warn "runner group not checked: ${DG_GROUP_WHY}; gh auth refresh -h github.com -s admin:org"
    return 0
  fi
  if [ "$rc" != 0 ]; then
    DG_GROUP="not-checked"
    if [ "$rc" = 2 ]; then
      DG_GROUP_WHY="gh could not list the runners of every runner group in ${org}, and the runner is in none of the others"
    else
      DG_GROUP_WHY="the runner (id ${DG_ID}) is in none of the runner groups gh listed for ${org}"
    fi
    dg_warn "runner group not checked: ${DG_GROUP_WHY}"
    return 0
  fi
  IFS=$'\t' read -r name vis pub gid <<<"$row"
  DG_GROUP="checked"
  DG_GROUP_NAME="$name" DG_GROUP_ID="$gid" DG_GROUP_VIS="$vis" DG_GROUP_PUB="$pub"
  # The same test as ensure_group's. The Default group is open to the whole
  # organization on purpose on a plan without custom groups (docs/runbook.md,
  # "Plans"), so that alone is a note; public repositories are never fine.
  case "$vis" in
    all) wide="every repository in ${org} can use it" ;;
    private) wide="every private repository in ${org} can use it" ;;
  esac
  [ "$pub" != true ] || wide="${wide:+${wide}, and }public repositories can use it"
  if [ -n "$wide" ]; then
    if [ "$(lower "$name")" = default ] && [ "$pub" != true ]; then
      dg_warn "runner group ${name}: ${wide}; right only if you trust every repository in ${org} (docs/runbook.md, \"Runner group\")"
    else
      dg_problem group "runner group ${name} is wider than it should be: ${wide}" "narrow it to selected repositories with public ones off in ${org}'s Actions settings, Runner groups (docs/runbook.md, \"Runner group\")"
    fi
  fi
  if [ "$vis" = selected ]; then
    if repos="$(group_repositories "$org" "$gid")"; then
      DG_REPOS="$repos"
      if [ -z "$repos" ]; then
        dg_hint "no repository is in runner group ${name} yet: bin/homefield adopt --repo <owner>/<repo>"
      fi
    else
      DG_GROUP="not-checked"
      DG_GROUP_WHY="gh could not list the repositories of runner group ${name}"
      dg_warn "runner group ${name}: ${DG_GROUP_WHY}"
    fi
  fi
}

# dg_collect_prerequisites: preflight's checks, from the same code. A failed
# check is a problem (its message names the fix); a warning is shown with the
# checks and is not a problem, as in preflight.
dg_collect_prerequisites() {
  local i
  preflight_collect
  for ((i = 0; i < ${#PF_NAME[@]}; i++)); do
    [ "${PF_LEVEL[i]}" != fail ] || dg_problem "prerequisite:${PF_NAME[i]}" "${PF_MSG[i]}" ""
  done
}

# dg_gh_text: the "On GitHub" line.
dg_gh_text() {
  case "$DG_GH" in
    listed)
      if [ -n "$DG_GH_STATUS" ]; then
        local busy=""
        if [ "$DG_GH_BUSY" = true ]; then busy=", busy"; elif [ "$DG_GH_BUSY" = false ]; then busy=", idle"; fi
        echo "listed (${DG_GH_STATUS}${busy})"
      else
        echo "listed"
      fi
      ;;
    not-listed) echo "NOT listed (GitHub removes runners that have not connected for more than 14 days)" ;;
    timed-out | not-checked) echo "not checked (${DG_GH_WHY})" ;;
    *) echo "skipped (${DG_SKIP_WHY:-${DG_GH_WHY}})" ;;
  esac
}

dg_render_human() {
  local i n why repo list
  why="${DG_SKIP_WHY:-nothing to ask}"
  echo "VM ${INSTANCE}:"
  case "$DG_CREATED" in
    yes) echo "  - Created: yes (${DG_VM_STATUS})" ;;
    no) echo "  - Created: no" ;;
    *) echo "  - Created: unknown" ;;
  esac
  if [ "$DG_GUEST" != "checked" ]; then
    echo "  - Guest checks: skipped (${why})"
  else
    case "$DG_ISO" in
      verified) echo "  - Isolation: verified (no host mounts, /Users hidden)" ;;
      failed) echo "  - Isolation: BROKEN (${DG_ISO_WHY})" ;;
      *) echo "  - Isolation: unknown (${DG_ISO_WHY})" ;;
    esac
    case "$DG_REG" in
      yes)
        if [ -n "$DG_NAME" ] && [ -n "$DG_URL" ]; then
          echo "  - Registered: yes (${DG_NAME}${DG_ID:+, id ${DG_ID}}, at ${DG_URL})"
        else
          echo "  - Registered: yes (its details could not be read)"
        fi
        ;;
      no) echo "  - Registered: no" ;;
      unknown) echo "  - Registered: unknown (could not ask the VM)" ;;
      *) echo "  - Registered: skipped (${why})" ;;
    esac
    if [ "$DG_REG" = yes ]; then
      echo "  - On GitHub: $(dg_gh_text)"
      case "$DG_SVC" in
        running) echo "  - Service: running (${DG_UNIT})" ;;
        *) echo "  - Service: NOT running (${DG_UNIT:-no service installed})" ;;
      esac
      echo "  - Version: ${DG_VER}"
      echo "  - Extra packages: ${DG_PKGS:-none}"
      case "$DG_NPM" in
        ok) echo "  - npm: ok" ;;
        broken) echo "  - npm: BROKEN (a runner self-update can flatten the externals symlinks; docs/runbook.md, \"Runner updates\")" ;;
        *) echo "  - npm: unknown (could not ask the VM)" ;;
      esac
    else
      echo "  - On GitHub: skipped (${why})"
      echo "  - Service: skipped (${why})"
      echo "  - Version: skipped (${why})"
      echo "  - Extra packages: skipped (${why})"
      echo "  - npm: skipped (${why})"
    fi
  fi
  echo ""
  echo "GitHub:"
  case "$DG_GROUP" in
    n/a)
      echo "  - Group: n/a (repository-scoped registration)"
      echo "  - Repositories in group: n/a (a repository-scoped runner serves only ${DG_URL#https://github.com/})"
      ;;
    checked | not-checked)
      if [ -n "$DG_GROUP_NAME" ]; then
        list="${DG_GROUP_VIS} repositories"
        [ "$DG_GROUP_VIS" != selected ] || list="selected repositories"
        echo "  - Group: ${DG_GROUP_NAME} (${list}, public $([ "$DG_GROUP_PUB" = true ] && echo on || echo off))"
        case "$DG_GROUP_VIS" in
          selected)
            if [ "$DG_GROUP" = "not-checked" ]; then
              echo "  - Repositories in group: not checked (${DG_GROUP_WHY})"
            elif [ -z "$DG_REPOS" ]; then
              echo "  - Repositories in group: none (run 'bin/homefield adopt --repo <owner>/<repo>')"
            else
              list=""
              while IFS= read -r repo; do
                [ -n "$repo" ] || continue
                list="${list:+${list}, }${repo}"
              done <<<"$DG_REPOS"
              echo "  - Repositories in group: ${list}"
            fi
            ;;
          private) echo "  - Repositories in group: every private repository in the organization" ;;
          *) echo "  - Repositories in group: every repository in the organization" ;;
        esac
      else
        echo "  - Group: not checked (${DG_GROUP_WHY})"
      fi
      ;;
    *) echo "  - Group: skipped (${DG_GROUP_WHY:-${why}})" ;;
  esac
  echo ""
  echo "Prerequisites:"
  n=${#PF_NAME[@]}
  for ((i = 0; i < n; i++)); do
    case "${PF_LEVEL[i]}" in
      ok) printf '  - %-6s%s\n' OK "${PF_MSG[i]}" ;;
      warn) printf '  - %-6s%s\n' WARN "${PF_MSG[i]}" ;;
      *) printf '  - %-6s%s\n' FAIL "${PF_MSG[i]}" ;;
    esac
  done
  echo ""
  n=${#DG_P_MSG[@]}
  if [ "$n" -eq 0 ]; then
    if [ "${#DG_WARN[@]}" -eq 0 ]; then
      echo "Summary: healthy."
    else
      echo "Summary: healthy as far as it could be checked."
    fi
  else
    if [ "$n" -eq 1 ]; then echo "Summary: 1 problem found."; else echo "Summary: ${n} problems found."; fi
    for ((i = 0; i < n; i++)); do
      echo "  $((i + 1)). ${DG_P_MSG[i]}"
      [ -z "${DG_P_FIX[i]}" ] || echo "     Fix: ${DG_P_FIX[i]}"
    done
  fi
  for ((i = 0; i < ${#DG_WARN[@]}; i++)); do
    echo "  Note: ${DG_WARN[i]}"
  done
  if [ "$n" -eq 0 ]; then
    for ((i = 0; i < ${#DG_HINT[@]}; i++)); do
      echo "  Next: ${DG_HINT[i]}"
    done
  else
    echo "  The other failure modes: docs/runbook.md, \"Failure modes\"."
  fi
}

dg_render_json() {
  local i n first
  printf '{\n'
  printf '  "instance": %s,\n' "$(json_str "$INSTANCE")"
  if [ "${#DG_P_MSG[@]}" -eq 0 ]; then printf '  "healthy": true,\n'; else printf '  "healthy": false,\n'; fi
  printf '  "vm": {\n'
  printf '    "created": %s,\n' "$(json_bool "$DG_CREATED")"
  printf '    "status": %s,\n' "$(json_nstr "$DG_VM_STATUS")"
  printf '    "guest_checked": %s,\n' "$([ "$DG_GUEST" = checked ] && echo true || echo false)"
  printf '    "skipped_reason": %s,\n' "$(json_nstr "$DG_SKIP_WHY")"
  printf '    "isolation": {"state": %s, "detail": %s},\n' "$(json_str "$DG_ISO")" "$(json_nstr "$DG_ISO_WHY")"
  printf '    "registered": %s,\n' "$(json_bool "$DG_REG")"
  if [ "$DG_REG" = yes ]; then
    printf '    "runner": {"name": %s, "id": %s, "url": %s},\n' "$(json_nstr "$DG_NAME")" "$(json_nstr "$DG_ID")" "$(json_nstr "$DG_URL")"
  else
    printf '    "runner": null,\n'
  fi
  printf '    "on_github": {"state": %s, "status": %s, "busy": %s, "detail": %s},\n' \
    "$(json_str "$DG_GH")" "$(json_nstr "$DG_GH_STATUS")" "$(json_bool "$DG_GH_BUSY")" "$(json_nstr "$DG_GH_WHY")"
  printf '    "service": {"state": %s, "unit": %s},\n' "$(json_str "$DG_SVC")" "$(json_nstr "$DG_UNIT")"
  printf '    "version": %s,\n' "$(json_nstr "$DG_VER")"
  if [ "$DG_PKGS_STATE" = listed ]; then
    printf '    "extra_packages": %s,\n' "$(json_words "$DG_PKGS")"
  else
    printf '    "extra_packages": null,\n'
  fi
  printf '    "npm": %s\n' "$(json_str "$DG_NPM")"
  printf '  },\n'
  printf '  "github": {\n'
  printf '    "scope": %s,\n' "$(json_nstr "$DG_SCOPE")"
  printf '    "group": {"state": %s, "name": %s, "id": %s, "visibility": %s, "allows_public": %s, "repositories": ' \
    "$(json_str "$DG_GROUP")" "$(json_nstr "$DG_GROUP_NAME")" "$(json_nstr "$DG_GROUP_ID")" "$(json_nstr "$DG_GROUP_VIS")" "$(json_bool "$DG_GROUP_PUB")"
  if [ "$DG_GROUP_VIS" = selected ] && [ "$DG_GROUP" = checked ]; then json_lines "$DG_REPOS"; else printf null; fi
  printf ', "detail": %s}\n' "$(json_nstr "$DG_GROUP_WHY")"
  printf '  },\n'
  printf '  "prerequisites": ['
  n=${#PF_NAME[@]}
  first=1
  for ((i = 0; i < n; i++)); do
    [ "$first" = 1 ] || printf ','
    first=0
    printf '\n    {"name": %s, "status": %s, "message": %s}' "$(json_str "${PF_NAME[i]}")" "$(json_str "${PF_LEVEL[i]}")" "$(json_str "${PF_MSG[i]}")"
  done
  printf '\n  ],\n'
  printf '  "problems": ['
  n=${#DG_P_MSG[@]}
  first=1
  for ((i = 0; i < n; i++)); do
    [ "$first" = 1 ] || printf ','
    first=0
    printf '\n    {"check": %s, "message": %s, "fix": %s}' "$(json_str "${DG_P_CHECK[i]}")" "$(json_str "${DG_P_MSG[i]}")" "$(json_nstr "${DG_P_FIX[i]}")"
  done
  if [ "$n" -eq 0 ]; then printf '],\n'; else printf '\n  ],\n'; fi
  printf '  "warnings": ['
  n=${#DG_WARN[@]}
  first=1
  for ((i = 0; i < n; i++)); do
    [ "$first" = 1 ] || printf ', '
    first=0
    json_str "${DG_WARN[i]}"
  done
  printf '],\n'
  printf '  "hints": ['
  n=${#DG_HINT[@]}
  first=1
  for ((i = 0; i < n; i++)); do
    [ "$first" = 1 ] || printf ', '
    first=0
    json_str "${DG_HINT[i]}"
  done
  printf ']\n}\n'
}

cmd_diagnose() {
  local json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      *) die "diagnose: unknown option $1 (see bin/homefield help)" ;;
    esac
  done
  dg_reset
  dg_collect_prerequisites
  dg_collect_vm
  dg_collect_group
  if [ "$json" = 1 ]; then dg_render_json; else dg_render_human; fi
  [ "${#DG_P_MSG[@]}" -eq 0 ]
}

# deregister_script: what uninstall runs in the guest, as root, with the remove
# token on its stdin. config.sh refuses to remove a runner whose service is
# installed, so the service goes first, and if anything after that fails (svc.sh
# uninstall partway through, or GitHub refusing the removal: a rejected token,
# a network failure) the runner is still registered and has to get its service
# back. provision.sh's ensure-service does that and starts it (#99): this
# release's copy, put in the guest by cmd_uninstall, so a VM provisioned by an
# older one gets it too. If that fails as well, the runner is registered with
# no service, and `homefield install` sets the service up again.
#
# deregister_script local: for a runner GitHub no longer has (#76), removes
# only the VM's copy of the registration (`config.sh remove --local`, which
# asks GitHub nothing), with an empty line for the token.
deregister_script() {
  # shellcheck disable=SC2016  # the guest's shell expands these, not this one
  local script='cd @HOME@ && read -r t && s=0 && { [ ! -f .service ] || s=1; } && { [ "$s" = 0 ] || ./svc.sh uninstall || { rc=$?; bash @PROVISION@ ensure-service --start; exit "$rc"; }; } && { ACTIONS_RUNNER_INPUT_TOKEN="$t" sudo --preserve-env=ACTIONS_RUNNER_INPUT_TOKEN -u runner ./config.sh remove@LOCAL@ || { rc=$?; [ "$s" = 0 ] || bash @PROVISION@ ensure-service --start; exit "$rc"; }; }'
  local flag=""
  [ "${1:-}" != local ] || flag=" --local"
  script="${script//@HOME@/$RUNNER_HOME}"
  script="${script//@LOCAL@/$flag}"
  printf '%s' "${script//@PROVISION@/$GUEST_PROVISION}"
}

# deregister_runner <url> <id> <on>: takes the registered runner out of
# service and deregisters it; <on> is runner_on_github's answer for it (1:
# GitHub no longer has it, so only the VM's copy of the registration goes).
# Shared by uninstall and reset. The caller has checked that no job is
# running. A failure ends the command (die, or `set -e`) after
# restart_runner_on_failure has given the runner its service back, so call it
# as a plain command, never from a condition: errexit is off in there and the
# failure would pass for success.
deregister_runner() {
  local url="$1" id="$2" on="$3" token
  echo "homefield: switch every repository that routes to this runner to hosted first:" >&2
  echo "homefield:   gh variable set CI_RUNNER --repo <owner>/<repo> --body hosted" >&2
  # The restore deregister_script falls back on, copied in while nothing
  # has changed yet.
  limactl copy "$PROVISION" "${INSTANCE}:${GUEST_PROVISION}" ||
    die "could not copy provision.sh into VM ${INSTANCE}; nothing was changed"
  # Offline before the token is fetched or typed, which can take a while.
  stop_runner
  if [ "$on" = 1 ]; then
    # A full removal would ask GitHub to delete a runner it does not have.
    log "GitHub no longer has this runner (id ${id}) at ${url}; removing its registration from the VM only"
    printf '\n' | guest_stdin sudo sh -c "$(deregister_script local)"
  else
    token="$(get_token remove "$url")"
    log "deregistering from ${url}"
    printf '%s\n' "$token" | guest_stdin sudo sh -c "$(deregister_script)"
    token=""
  fi
  runner_back
}

# delete_vm: takes the VM out of start at login, stops it and deletes it.
# Returns limactl delete's status when that fails: uninstall calls it as a plain
# command, so errexit ends it as before; reset checks the status.
delete_vm() {
  limactl autostart disable "$INSTANCE" >/dev/null 2>&1 || limactl start-at-login --enabled=false "$INSTANCE" >/dev/null 2>&1 || true
  limactl stop --force "$INSTANCE" >/dev/null 2>&1 || true
  limactl delete --force "$INSTANCE" || return $?
  log "deleted VM ${INSTANCE}"
}

cmd_uninstall() {
  local keep_vm=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --keep-vm) keep_vm=1; shift ;;
      *) die "uninstall: unknown option $1 (see bin/homefield help)" ;;
    esac
  done
  check_host
  local status
  vm_lookup
  status="$VM_STATUS"
  [ -n "$status" ] || die "no VM ${INSTANCE}"
  [ "$status" = "Running" ] || limactl start --tty=false "$INSTANCE"
  if is_registered; then
    is_job_running && die "a job is running on ${INSTANCE}; uninstall when it is idle"
    local url="" id="" on=0
    { read -r url || true; read -r id || true; } < <(runner_setting gitHubUrl agentId)
    [ -n "$url" ] || die "could not read the runner's registration in VM ${INSTANCE}; nothing was changed"
    runner_on_github "$url" "$id" || on=$?
    deregister_runner "$url" "$id" "$on"
  else
    log "${INSTANCE} is not registered; nothing to deregister"
  fi
  if [ "$keep_vm" = 1 ]; then
    log "kept VM ${INSTANCE}"
    return
  fi
  delete_vm
}

# ── reset ───────────────────────────────────────────────────────────────────
# reset rolls back a complete or half-finished install of one instance: the
# runner's registration, the VM and the runner group install created, and with
# --remove-tool the tool itself. It works from what exists now, so a failed
# install, an uninstall that stopped partway and a VM deleted by hand are all
# one case; nothing existing is a no-op. What it removes is in the plan it
# prints and asks about before any change, and in the report it ends with.

# Where install.sh put the tool: the same defaults as install.sh's
# HOMEFIELD_HOME and pick_bin_dir. install.sh cannot be sourced from here (it
# runs on load), so the two are kept in step by hand, and tests/reset.sh
# removes a wrapper that install.sh itself wrote.
tool_install_dir() { printf '%s' "${HOMEFIELD_HOME:-$HOME/.local/share/homefield}"; }
# tool_bin_dirs: every place the command can be; the Homebrew prefix install.sh
# found then may not be the one found now.
tool_bin_dirs() {
  local prefix
  if [ -n "${HOMEFIELD_BIN_DIR:-}" ]; then
    printf '%s\n' "$HOMEFIELD_BIN_DIR"
    return 0
  fi
  if command -v brew >/dev/null 2>&1 && prefix="$(brew --prefix 2>/dev/null)" && [ -n "$prefix" ]; then
    printf '%s\n' "$prefix/bin"
  fi
  printf '%s\n' "$HOME/.local/bin"
}
# tool_wrappers: the `homefield` commands that run this install dir, one per
# line. install.sh's write_wrapper only replaces a regular file whose last line
# runs <dir>/bin/homefield; this also needs the line to name the install dir
# being removed, so another installation's command is left alone.
tool_wrappers() {
  local install_dir dir
  install_dir="$(tool_install_dir)"
  while IFS= read -r dir; do
    if [ -f "$dir/homefield" ] && [ ! -L "$dir/homefield" ] &&
      grep -qxF "exec \"${install_dir}/bin/homefield\" \"\$@\"" "$dir/homefield"; then
      printf '%s\n' "$dir/homefield"
    fi
  done < <(tool_bin_dirs)
  return 0
}
# tool_dir: the install dir, if install.sh put it there (it writes
# .homefield-ref; a git checkout has none) and it is a path install.sh would
# have accepted. Nothing otherwise.
tool_dir() {
  local dir dir_re='^/[A-Za-z0-9_./@+ -]+$'
  dir="$(tool_install_dir)"
  if [[ "$dir" =~ $dir_re && "$dir" != *..* && "$dir" != "$HOME" ]] &&
    [ -d "$dir" ] && [ ! -L "$dir" ] && [ -f "$dir/.homefield-ref" ]; then
    printf '%s\n' "$dir"
  fi
  return 0
}

# The runner as the VM says, set by reset_inspect: R_REG 1 when registered,
# its URL and id, and R_ON runner_on_github's answer for it.
R_REG=0
R_URL=""
R_ID=""
R_ON=2
# reset_inspect: reads the above from a running VM. A running job ends the
# command, before anything is asked or changed.
reset_inspect() {
  R_REG=0
  R_URL=""
  R_ID=""
  R_ON=2
  is_registered || return 0
  R_REG=1
  is_job_running && die "a job is running on ${INSTANCE}; reset when it is idle (no runner was touched)"
  { read -r R_URL || true; read -r R_ID || true; } < <(runner_setting gitHubUrl agentId)
  [ -n "$R_URL" ] || die "could not read the runner's registration in VM ${INSTANCE}; no runner was touched"
  R_ON=0
  runner_on_github "$R_URL" "$R_ID" || R_ON=$?
}

# The runner group install created, from the state file (state_get): org, name
# and id (empty when install could not read it from GitHub's answer), and
# RG_BAD 1 for a record that does not parse.
RG_ORG=""
RG_NAME=""
RG_ID=""
RG_BAD=0
RG_LABEL=""
RG_PAGE=""
reset_load_group() {
  local raw re='^([A-Za-z0-9_.-]+)/(.+)/([0-9]*)$'
  RG_ORG=""
  RG_NAME=""
  RG_ID=""
  RG_BAD=0
  raw="$(state_get group_created)"
  [ -n "$raw" ] || return 0
  if [[ "$raw" =~ $re ]]; then
    RG_ORG="${BASH_REMATCH[1]}"
    RG_NAME="${BASH_REMATCH[2]}"
    RG_ID="${BASH_REMATCH[3]}"
    RG_LABEL="${RG_ORG}/${RG_NAME}"
    RG_PAGE="https://github.com/organizations/${RG_ORG}/settings/actions/runner-groups"
  else
    RG_BAD=1
  fi
}

# What reset did, one line each, printed at the end. RESET_RC is the exit
# status (1 once a requested step failed); RG_KEEP 1 keeps the state file,
# because a group it records still exists.
REPORT=()
RESET_RC=0
RG_KEEP=0
rep() { REPORT+=("$1"); }
# group_kept <why> [problem]: the group stays, and so does its record, so that
# a later reset can still delete it. With a second argument it is a failure.
group_kept() {
  rep "runner group ${RG_LABEL}: kept, ${1}${RG_PAGE:+ (delete it at ${RG_PAGE} if it is not wanted)}"
  RG_KEEP=1
  [ -z "${2:-}" ] || RESET_RC=1
}

# reset_group <keep> <own runner id>: deletes the runner group the state file
# says install created, only when every guard holds: it is not the Default
# group; GitHub lists it now with the recorded id (or, with no id recorded,
# the recorded name) and name; nothing but this instance's own runner (<own>,
# empty if it is not in the group) is in it, because deleting a group moves its
# runners to Default; and --keep-group was not given. A group that cannot be
# checked is not deleted.
reset_group() {
  local keep="$1" own="$2" rows="" ids="" name vis pub id rid found_id="" found_name="" others=0 out
  if [ "$keep" = 1 ]; then
    group_kept "--keep-group was given"
    return 0
  fi
  if [ "$(lower "$RG_NAME")" = default ]; then
    rep "runner group ${RG_LABEL}: not deleted, it is the Default group"
    return 0
  fi
  if ! command -v gh >/dev/null; then
    group_kept "gh is not installed, so it was not checked" problem
    return 0
  fi
  if ! rows="$(list_groups_ids "$RG_ORG")"; then
    group_kept "gh could not list the runner groups of ${RG_ORG} (needs an org owner with the admin:org scope)" problem
    return 0
  fi
  while IFS=$'\t' read -r name vis pub id; do
    [ -n "$id" ] || continue
    if [ -n "$RG_ID" ]; then
      [ "$id" = "$RG_ID" ] || continue
    else
      [ "$(lower "$name")" = "$(lower "$RG_NAME")" ] || continue
    fi
    found_id="$id"
    found_name="$name"
  done <<<"$rows"
  if [ -z "$found_id" ]; then
    rep "runner group ${RG_LABEL}${RG_ID:+ (id ${RG_ID})}: not on GitHub any more, nothing to delete"
    return 0
  fi
  if [ "$(lower "$found_name")" != "$(lower "$RG_NAME")" ]; then
    group_kept "group id ${found_id} is now named ${found_name}, not the group install created"
    return 0
  fi
  if ! ids="$(group_runner_ids "$RG_ORG" "$found_id")"; then
    group_kept "gh could not list its runners, so it was not checked" problem
    return 0
  fi
  while IFS= read -r rid; do
    [ -n "$rid" ] || continue
    if [ -n "$own" ] && [ "$rid" = "$own" ]; then continue; fi
    others=$((others + 1))
  done <<<"$ids"
  if [ "$others" -gt 0 ]; then
    group_kept "it holds ${others} other runner(s), and deleting a group moves its runners to Default"
    return 0
  fi
  if out="$(gh api -X DELETE "orgs/${RG_ORG}/actions/runner-groups/${found_id}" </dev/null 2>&1)"; then
    rep "runner group ${RG_LABEL} (id ${found_id}): deleted"
  else
    group_kept "gh could not delete it (${out:-no message}; needs an org owner with the admin:org scope)" problem
  fi
}

# confirm_reset: reset is destructive. HOMEFIELD_YES=1 (install.sh's switch
# for the same purpose) answers yes; otherwise a terminal is asked, and
# without one this stops, before anything is changed.
confirm_reset() {
  local answer
  [ "${HOMEFIELD_YES:-}" != 1 ] || return 0
  have_terminal || die "reset removes what is listed above and there is no terminal to ask on; run it again with HOMEFIELD_YES=1 to go ahead (nothing was changed)"
  read -rp "Remove all of the above? [y/N] " answer || answer=""
  case "$answer" in
    [Yy]*) ;;
    *) die "stopped: nothing was changed" ;;
  esac
}

cmd_reset() {
  local keep_vm=0 keep_group=0 remove_tool=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --keep-vm) keep_vm=1; shift ;;
      --keep-group) keep_group=1; shift ;;
      --remove-tool) remove_tool=1; shift ;;
      *) die "reset: unknown option $1 (see bin/homefield help)" ;;
    esac
  done
  check_host
  local vm wrappers="" dir="" plan=() line
  # Not vm_lookup: a VM Lima cannot describe is the usual half-built one, and
  # the way out has to be named.
  VM_STATUS="$(vm_status)" || die "could not ask Lima about VM ${INSTANCE} (limactl list failed, or lists it without a status), so reset cannot tell what is there. If its runner registered, remove that on GitHub's runners page first; then delete the VM by hand: limactl delete --force ${INSTANCE}"
  vm="$VM_STATUS"
  R_REG=0
  R_ON=2
  reset_load_group
  # A running VM can be asked now; a stopped one is started only after the
  # answer, which makes the plan say so. asked_early: the answer is from before
  # the confirmation, so it is checked again after it.
  local asked_early=0
  if [ "$vm" = Running ]; then
    asked_early=1
    reset_inspect
  fi
  if [ "$remove_tool" = 1 ]; then
    wrappers="$(tool_wrappers)"
    dir="$(tool_dir)"
  fi

  if [ -n "$vm" ]; then
    if [ "$vm" != Running ]; then
      plan+=("start VM ${INSTANCE} (${vm}) to look for a registered runner in it")
    elif [ "$R_REG" = 1 ] && [ "$R_ON" = 1 ]; then
      plan+=("remove the runner's registration from VM ${INSTANCE}; GitHub no longer lists it (${R_URL})")
    elif [ "$R_REG" = 1 ]; then
      plan+=("deregister the runner from ${R_URL}")
    fi
    [ "$keep_vm" = 1 ] || plan+=("delete VM ${INSTANCE}")
  fi
  if [ -n "$RG_ORG" ] && [ "$keep_group" = 0 ]; then
    plan+=("delete the runner group ${RG_LABEL}, which install created, unless it holds other runners")
  fi
  if [ -n "$wrappers" ]; then
    plan+=("remove the command ${wrappers}, shared by every instance on this Mac")
  fi
  if [ -n "$dir" ]; then
    plan+=("remove the tool in ${dir}, shared by every instance on this Mac")
  fi
  if [ "${#plan[@]}" -gt 0 ]; then
    echo "Reset of ${INSTANCE} will:"
    for line in "${plan[@]}"; do echo "  - ${line}"; done
    confirm_reset
  fi

  REPORT=()
  RESET_RC=0
  RG_KEEP=0
  if [ -n "$vm" ]; then
    if [ "$vm" != Running ]; then
      log "starting VM ${INSTANCE}"
      limactl start --tty=false "$INSTANCE" ||
        die "could not start VM ${INSTANCE} to look for a registered runner; if one registered, remove it on GitHub's runners page, then delete the VM by hand: limactl delete --force ${INSTANCE}"
      reset_inspect
    fi
    if [ "$R_REG" = 1 ]; then
      # The runner stayed online while the plan was read and confirmed, and may
      # have taken a job since; nothing has been changed yet.
      if [ "$asked_early" = 1 ] && is_job_running; then
        die "a job started on ${INSTANCE} while you were deciding; reset when it is idle (no runner was touched)"
      fi
      # Plain command, not a condition: a failure here ends reset with the VM
      # kept and the runner's service back, and nothing after it is done.
      deregister_runner "$R_URL" "$R_ID" "$R_ON"
      if [ "$R_ON" = 1 ]; then
        rep "runner: removed from the VM only, GitHub no longer listed it (${R_URL})"
      else
        rep "runner: deregistered from ${R_URL}"
      fi
    else
      rep "runner: not registered"
    fi
    if [ "$keep_vm" = 1 ]; then
      rep "VM ${INSTANCE}: kept (--keep-vm)"
    elif delete_vm; then
      rep "VM ${INSTANCE}: deleted"
    else
      rep "VM ${INSTANCE}: could not be deleted (limactl said why above); delete it by hand: limactl delete --force ${INSTANCE}"
      RESET_RC=1
    fi
  fi
  if [ -n "$RG_ORG" ]; then
    # R_ID is set only for a runner that was registered here and is now
    # deregistered (or the command would have ended): the one runner that may
    # still show in the group for a moment.
    reset_group "$keep_group" "$R_ID"
  elif [ "$RG_BAD" = 1 ]; then
    rep "runner group: the group_created record in $(state_file) does not parse, so no group was touched"
    RG_KEEP=1
  fi
  if [ -e "$(state_file)" ]; then
    if [ "$RG_KEEP" = 1 ]; then
      rep "state file $(state_file): kept, it still records the group"
    elif rm -f "$(state_file)"; then
      rep "state file $(state_file): removed"
    else
      rep "state file $(state_file): could not be removed"
      RESET_RC=1
    fi
  fi
  # Last, and only when the rest went well: the tool is how the rest is run
  # again. After this nothing reads from it, and the script exits.
  if [ "$remove_tool" = 1 ]; then
    if [ "$RESET_RC" != 0 ]; then
      rep "tool: kept, a step above failed; run reset --remove-tool again after fixing it"
    else
      if [ -z "$wrappers" ]; then
        rep "command: no homefield wrapper of this install found in $(tool_bin_dirs | tr '\n' ' ')(HOMEFIELD_BIN_DIR names another place)"
      else
        while IFS= read -r line; do
          if rm -f -- "$line"; then rep "command ${line}: removed"; else rep "command ${line}: could not be removed"; RESET_RC=1; fi
        done <<<"$wrappers"
      fi
      if [ -n "$dir" ]; then
        if rm -rf -- "$dir"; then rep "tool ${dir}: removed"; else rep "tool ${dir}: could not be removed"; RESET_RC=1; fi
      else
        rep "tool: $(tool_install_dir) was not put there by install.sh (no .homefield-ref), left alone"
      fi
    fi
  fi

  if [ "${#REPORT[@]}" -eq 0 ]; then
    log "nothing to reset for ${INSTANCE}: no VM and no runner group it created"
  else
    echo "Reset of ${INSTANCE}:"
    for line in "${REPORT[@]}"; do echo "  - ${line}"; done
  fi
  if [ "$remove_tool" = 1 ]; then exit "$RESET_RC"; fi
  return "$RESET_RC"
}

# stuck_runs <owner/repo> <label>: ids of the repository's active runs that
# have a job still queued for a runner with the label: the jobs that keep
# waiting after a switch to hosted, because runs-on was decided when they
# were queued.
stuck_runs() {
  local repo="$1" label="$2" status ids id waiting
  label="$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')"
  # --paginate: after a long outage there can be more than one page of
  # active runs, or of jobs in a run. With --paginate, --jq runs per page,
  # so both filters emit one line per match and a match on any page counts.
  for status in queued in_progress; do
    ids="$(gh api --paginate "repos/${repo}/actions/runs?status=${status}&per_page=100" --jq '.workflow_runs[].id')" || exit 1
    for id in $ids; do
      waiting="$(gh api --paginate "repos/${repo}/actions/runs/${id}/jobs?per_page=100" \
        --jq ".jobs[] | select(.status == \"queued\" and ((.labels | map(ascii_downcase)) | index(\"${label}\"))) | .id")" || exit 1
      [ -n "$waiting" ] && echo "$id"
    done
  done
  return 0
}

cmd_route() {
  local target="${1:-}" label="homefield-ci" dry=0 repos=() repo current stuck id status tries
  [ $# -gt 0 ] && shift
  case "$target" in
    hosted | local) ;;
    *) die "route: say where to: bin/homefield route <hosted|local> --repo <owner>/<repo>" ;;
  esac
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repos+=("${2:?--repo needs a value}"); shift 2 ;;
      --label) label="${2:?--label needs a value}"; shift 2 ;;
      --dry-run) dry=1; shift ;;
      *) die "route: unknown option $1 (see bin/homefield help)" ;;
    esac
  done
  [ "${#repos[@]}" -gt 0 ] || die "route: --repo <owner>/<repo> is required"
  [[ "$label" =~ ^[A-Za-z0-9._-]+$ ]] || die "route: --label must be one label"
  command -v gh >/dev/null || die "route needs gh (https://cli.github.com)"

  for repo in "${repos[@]}"; do
    [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "route: --repo must be <owner>/<repo>, got: $repo"
    current="$(gh variable get CI_RUNNER --repo "$repo" 2>/dev/null || echo "(unset)")"
    if [ "$dry" = 1 ]; then
      log "${repo}: CI_RUNNER ${current} -> ${target} (dry run)"
    else
      gh variable set CI_RUNNER --repo "$repo" --body "$target" >/dev/null
      log "${repo}: CI_RUNNER ${current} -> ${target}"
    fi
    [ "$target" = hosted ] || continue

    # runs-on was fixed when these jobs were queued, so they wait for the
    # local runner whatever the variable says now. Cancel and re-run them;
    # the re-run is routed afresh, to hosted.
    # A failed lookup must not read as "nothing stuck".
    stuck="$(stuck_runs "$repo" "$label")" || die "${repo}: could not list its runs with gh"
    for id in $stuck; do
      if [ "$dry" = 1 ]; then
        log "${repo}: run ${id} has jobs waiting for ${label}; would cancel and re-run it"
        continue
      fi
      log "${repo}: run ${id} has jobs waiting for ${label}; cancelling and re-running it"
      gh run cancel "$id" --repo "$repo" >/dev/null
      # Up to a minute for the cancel to land; a re-run is refused before.
      # A shell counter, so nothing outside bash can make the wait vanish.
      status=""
      tries=0
      while [ "$tries" -lt 30 ]; do
        status="$(gh run view "$id" --repo "$repo" --json status --jq .status)" || exit 1
        [ "$status" = completed ] && break
        sleep 2
        tries=$((tries + 1))
      done
      if [ "$status" != completed ]; then
        log "${repo}: run ${id} is still ${status} after a minute; re-run it yourself: gh run rerun ${id} --repo ${repo}" >&2
        continue
      fi
      gh run rerun "$id" --repo "$repo" >/dev/null
      log "${repo}: run ${id} re-run"
    done
  done
}

# ── adopt ───────────────────────────────────────────────────────────────────
# Everything docs/adopting.md asks for that is not a workflow edit: a check that
# the routing is merged, the runner group's access list, and the switch. The
# group and the switch both wait for the routing: a repository that can reach
# the runner before its jobs carry the guarded expression has nothing keeping
# the runner to pull requests from its own branches.

# Set by the steps below, for the ones after them and the summary.
ADOPT_TMP=""
ADOPT_REPO_ID=""
ADOPT_BRANCH=""
ADOPT_OWNER_TYPE=""
ADOPT_GROUP_OUTCOME=""
ADOPT_SWITCH_OUTCOME=""
ADOPT_READY=0
ADOPT_REASONS=""
ADOPT_NOTES=""
ADOPT_LABEL=""
# The label of the first routing guard that passes its check, when
# adopt did not get --label: a passing guard says which label the repository
# actually routes on, and that is the one to advise with.
ADOPT_LABEL_OK=""
ADOPT_GUARDS=0
ADOPT_ROUTED=""
ADOPT_WORKFLOWS=0

adopt_warn() { echo "homefield: warning: $*" >&2; }

# adopt_repository <owner/repo>: sets ADOPT_REPO_ID, ADOPT_BRANCH and
# ADOPT_OWNER_TYPE. Only private repositories may reach the runner.
adopt_repository() {
  local repo="$1" info private
  if ! info="$(gh api "repos/${repo}" --jq '[.private, .id, .default_branch, .owner.type] | @tsv' 2>/dev/null)"; then
    die "adopt: could not read ${repo} with gh: it does not exist, or this gh login cannot see it"
  fi
  IFS=$'\t' read -r private ADOPT_REPO_ID ADOPT_BRANCH ADOPT_OWNER_TYPE <<<"$info"
  case "$private" in
    true) ;;
    false) die "adopt: ${repo} is public. The runner is for private repositories only: a pull request runs the workflow files from its own branch, so anyone who can open one could run code on the VM (README, \"Security model\")" ;;
    *) die "adopt: gh gave an answer for ${repo} that this tool cannot read: ${info}" ;;
  esac
  [[ -n "$ADOPT_REPO_ID" && -n "$ADOPT_BRANCH" ]] || die "adopt: gh gave an answer for ${repo} that this tool cannot read: ${info}"
  log "repository: ${repo} is private (default branch ${ADOPT_BRANCH})"
}

# adopt_group_access <owner/repo> <group> <dry>: makes sure the runner group
# admits the repository, but only writes to it (the PUT) when the routing is
# ready (ADOPT_READY): group access is what lets a repository's jobs reach the
# runner, so it must not come before the routing that keeps them to its own
# pull requests. When the routing is not ready this still reads the group, to
# say whether the repository is already in it. Not being able to check is a
# warning, not an error: group access is an organization-admin matter that the
# person running this may not be, and the rest of the checks are still worth
# having. A group that allows public repositories is a warning too, and goes on
# into the outcome line: whatever else it says, the group is not the boundary
# the docs describe.
adopt_group_access() {
  local repo="$1" group="$2" dry="$3" org="${1%%/*}" rows="" listed=0 name vis pub gid
  local found="" members byhand="" widen=""
  [ "$ADOPT_READY" = 0 ] || byhand="; add ${repo} by hand (docs/adopting.md step 5)"
  if [ "$ADOPT_OWNER_TYPE" != Organization ]; then
    ADOPT_GROUP_OUTCOME="none needed (${org} is a personal account)"
    log "runner group: skipped, ${org} is a personal account and has no runner groups"
    return 0
  fi
  if [ "$(lower "$group")" = default ]; then
    ADOPT_GROUP_OUTCOME="none needed (Default group)"
    log "runner group: skipped, the Default group is open to every repository in ${org}"
    return 0
  fi
  if rows="$(list_groups_ids "$org")"; then
    listed=1
  elif offer_scope_refresh && rows="$(list_groups_ids "$org")"; then
    listed=1
  fi
  if [ "$listed" = 0 ]; then
    ADOPT_GROUP_OUTCOME="not checked"
    adopt_warn "could not check runner group access${byhand}"
    return 0
  fi
  while IFS=$'\t' read -r name vis pub gid; do
    [ -n "$name" ] || continue
    [ "$(lower "$name")" = "$(lower "$group")" ] || continue
    found="$name"
    break
  done <<<"$rows"
  if [ -z "$found" ]; then
    ADOPT_GROUP_OUTCOME="none needed (no group ${group})"
    log "runner group: ${org} has no group ${group}; the runner may be repository-scoped or in another group, so nothing was changed"
    return 0
  fi
  [ "$pub" != true ] || widen=", but the group allows public repositories"
  if [ "$vis" != selected ]; then
    ADOPT_GROUP_OUTCOME="already open (${vis})${widen}"
    adopt_warn "runner group ${found} is open to ${vis} repositories in ${org}${widen:+ and allows public ones}, so ${repo} already has access and nothing was added; narrow it to selected repositories with public ones off (docs/runbook.md, \"Runner group\")"
    return 0
  fi
  if [ -n "$widen" ]; then
    adopt_warn "runner group ${found} allows public repositories. ${repo} is private, but anyone who can add a public repository to the group lets that repository's pull requests run their own workflow files on the runner, and the README's security model rests on there being none. The group stays that way after this adoption; turn off Allow public repositories for it (docs/runbook.md, \"Runner group\")"
  fi
  if ! members="$(gh api --paginate "orgs/${org}/actions/runner-groups/${gid}/repositories?per_page=100" --jq '.repositories[].id' 2>/dev/null)"; then
    ADOPT_GROUP_OUTCOME="not checked${widen}"
    adopt_warn "could not read the repositories of runner group ${found}${byhand}"
    return 0
  fi
  if printf '%s\n' "$members" | grep -qx "$ADOPT_REPO_ID"; then
    ADOPT_GROUP_OUTCOME="already a member${widen}"
    log "runner group: ${repo} already has access to ${found}"
    if [ "$ADOPT_READY" = 0 ]; then
      adopt_warn "${repo} is already in runner group ${found}, so its workflows can already send jobs to the runner although its routing is not ready; take it out of the group until the routing is merged (docs/runbook.md, \"Runner group\")"
    fi
  elif [ "$ADOPT_READY" = 0 ]; then
    ADOPT_GROUP_OUTCOME="not added (the routing is not ready)"
    log "runner group: not added, because the routing is not ready"
  elif [ "$dry" = 1 ]; then
    ADOPT_GROUP_OUTCOME="would be added (dry run)${widen}"
    log "runner group: would add ${repo} to ${found} (dry run)"
  else
    gh api -X PUT "orgs/${org}/actions/runner-groups/${gid}/repositories/${ADOPT_REPO_ID}" >/dev/null ||
      die "adopt: could not add ${repo} to runner group ${found}; add it by hand (docs/adopting.md step 5)"
    ADOPT_GROUP_OUTCOME="added${widen}"
    log "runner group: added ${repo} to ${found}"
  fi
}

# adopt_fetch_workflows <owner/repo> <branch> <dir>: the repository's
# .github/workflows at the branch, into dir; sets ADOPT_WORKFLOWS to how many.
# A repository without the directory has none, which is not an error here.
adopt_fetch_workflows() {
  local repo="$1" branch="$2" dir="$3" names name enc
  mkdir -p "$dir"
  ADOPT_WORKFLOWS=0
  if ! names="$(gh api -X GET "repos/${repo}/contents/.github/workflows" -f ref="$branch" \
    --jq '.[] | select(.type == "file") | .name' 2>"$ADOPT_TMP/err")"; then
    if grep -q 404 "$ADOPT_TMP/err"; then
      names=""
    else
      die "adopt: could not list .github/workflows in ${repo} with gh: $(head -1 "$ADOPT_TMP/err")"
    fi
  fi
  while IFS= read -r name; do
    case "$name" in
      */* | "") continue ;;
      *.yml | *.yaml) ;;
      *) continue ;;
    esac
    # A name may have spaces or other characters a URL path cannot carry.
    enc="$(python3 -I "$ROOT/tools/adopt.py" quote "$name" </dev/null)" || exit 1
    gh api -X GET "repos/${repo}/contents/.github/workflows/${enc}" -f ref="$branch" \
      -H 'Accept: application/vnd.github.raw' >"$dir/$name" 2>"$ADOPT_TMP/err" </dev/null ||
      die "adopt: could not download .github/workflows/${name} from ${repo}: $(head -1 "$ADOPT_TMP/err")"
    ADOPT_WORKFLOWS=$((ADOPT_WORKFLOWS + 1))
  done <<<"$names"
}

# adopt_reason <text>: one reason the routing is not ready.
adopt_reason() {
  ADOPT_READY=0
  ADOPT_REASONS="${ADOPT_REASONS}  - $1"$'\n'
}

# adopt_note <text>: one thing to check about the guard, once.
adopt_note() {
  case $'\n'"$ADOPT_NOTES" in
    *$'\n'"$1"$'\n'*) ;;
    *) ADOPT_NOTES="${ADOPT_NOTES}$1"$'\n' ;;
  esac
}

# adopt_each <command> <items>: runs the command on each of the items, which
# tools/adopt.py joins with ";" ("-" is none).
adopt_each() {
  local cmd="$1" rest="$2" item
  [ "$rest" != - ] || return 0
  while [ -n "$rest" ]; do
    item="${rest%%;*}"
    if [ "$item" = "$rest" ]; then rest=""; else rest="${rest#*;}"; fi
    [ -z "$item" ] || "$cmd" "$item"
  done
}

# adopt_events_key <events>: the events in canonical order, comma-separated,
# so two spellings of the same set compare equal (the order of the list and
# the separators do not matter to routing_guard.py). Names it does not know
# are dropped; the guard check reports those.
adopt_events_key() {
  local padded e key=""
  padded=" $(printf '%s' "$1" | tr ',\n\t' '   ') "
  for e in pull_request push workflow_dispatch schedule; do
    case "$padded" in
      *" $e "*) key="${key:+${key},}${e}" ;;
    esac
  done
  printf '%s' "$key"
}

# adopt_routing_check <dir> <label> <label_given>: sets ADOPT_READY (1 when a
# usable routing-guard step is there, passes, and at least one job is routed),
# ADOPT_REASONS (why not), ADOPT_LABEL, ADOPT_EVENTS, ADOPT_DEPENDABOT,
# ADOPT_FALLBACK and ADOPT_ROUTED. The workflows' own guard says which label,
# options and jobs to expect; --events, --dependabot and --fallback arrive as
# ADOPT_FLAG_EVENTS, ADOPT_FLAG_DEPENDABOT and ADOPT_FLAG_FALLBACK (empty when
# not given) and are held to the guard the way --label is. The guard's arch is
# read too, and refused unless arm64: adopt sets up the arm64 VM, and there is
# no flag to change that (#21 is the x86-64 future). The checks are routing_guard.py,
# the same script the guard runs in CI, with the step's own arch, so what they
# report is what CI runs. A usable step is the action pinned to
# this copy's release or a commit, in a workflow that runs on pull requests
# (tools/adopt.py says which are).
adopt_routing_check() {
  local dir="$1" label="$2" label_given="$3" rows where gstatus glabel gblocks gwarns gjobs out rc lines
  local gevents gdependabot gfallback garch gmatch opts
  local candidates=0 deferred="" routed routedjob
  ADOPT_READY=1
  ADOPT_REASONS=""
  ADOPT_NOTES=""
    ADOPT_LABEL="$label"
  ADOPT_LABEL_OK=""
  ADOPT_EVENTS="${ADOPT_FLAG_EVENTS:-pull_request}"
  ADOPT_DEPENDABOT="${ADOPT_FLAG_DEPENDABOT:-hosted}"
  ADOPT_FALLBACK="${ADOPT_FLAG_FALLBACK:-ubuntu-latest}"
  ADOPT_GUARDS=0
  ADOPT_ROUTED=""
  rows="$(python3 -I "$ROOT/tools/adopt.py" guards "$dir")" || die "adopt: could not read the downloaded workflows"
  while IFS=$'\t' read -r where gstatus glabel gblocks gwarns gevents gdependabot gfallback garch gjobs; do
    [ -n "$where" ] || continue
    candidates=$((candidates + 1))
    case "$gstatus" in
      source)
        adopt_each adopt_reason "$gblocks"
        continue
        ;;
      blocked)
        # Only a reason when no step is usable: a leftover that cannot run is
        # not a guard, and does no harm next to one that can.
        [ "$gblocks" = - ] || deferred="${deferred:+${deferred};}${gblocks}"
        continue
        ;;
    esac
    if [ "$ADOPT_GUARDS" = 0 ]; then
      [ "$label_given" = 1 ] || ADOPT_LABEL="$glabel"
      [ -n "$ADOPT_FLAG_EVENTS" ] || ADOPT_EVENTS="$gevents"
      [ -n "$ADOPT_FLAG_DEPENDABOT" ] || ADOPT_DEPENDABOT="$gdependabot"
      [ -n "$ADOPT_FLAG_FALLBACK" ] || ADOPT_FALLBACK="$gfallback"
    fi
    ADOPT_GUARDS=$((ADOPT_GUARDS + 1))
    adopt_each adopt_note "$gwarns"
    gmatch=1
    if [ "$label_given" = 1 ] && [ "$glabel" != "$label" ]; then
      gmatch=0
      adopt_reason "the routing-guard step at ${where} uses label ${glabel}, but --label is ${label}"
    fi
    if [ -n "$ADOPT_FLAG_EVENTS" ] && [ "$(adopt_events_key "$gevents")" != "$(adopt_events_key "$ADOPT_FLAG_EVENTS")" ]; then
      gmatch=0
      adopt_reason "the routing-guard step at ${where} uses events ${gevents}, but --events is ${ADOPT_FLAG_EVENTS}"
    fi
    if [ -n "$ADOPT_FLAG_DEPENDABOT" ] && [ "$gdependabot" != "$ADOPT_FLAG_DEPENDABOT" ]; then
      gmatch=0
      adopt_reason "the routing-guard step at ${where} uses dependabot ${gdependabot}, but --dependabot is ${ADOPT_FLAG_DEPENDABOT}"
    fi
    if [ -n "$ADOPT_FLAG_FALLBACK" ] && [ "$gfallback" != "$ADOPT_FLAG_FALLBACK" ]; then
      gmatch=0
      adopt_reason "the routing-guard step at ${where} uses fallback ${gfallback}, but --fallback is ${ADOPT_FLAG_FALLBACK}"
    fi
    if [ "$garch" != arm64 ]; then
      gmatch=0
      adopt_reason "the routing-guard step at ${where} uses arch ${garch}, but adopt sets up an arm64 VM; a guard step for another architecture routes its jobs to a runner this Mac does not have (docs/adopting.md, step 3)"
    fi
    opts=(--label "$glabel" --events "$gevents" --dependabot "$gdependabot" --fallback "$gfallback" --arch "$garch")
    # Collect the jobs routed under this guard's label and options. A
    # repository can carry several routing-guard steps; jobs routed under any
    # of them count, not only the first guard's — unless a flag picked a
    # value, in which case only steps carrying it speak for it and the others
    # are already reported as a mismatch above.
    if [ "$gmatch" = 1 ]; then
      # A guard whose own options the script refuses fails here too: the
      # check below reports that, so an empty list is right for now.
      routed="$(python3 -I "$ROOT/routing-guard/routing_guard.py" --workflows-dir "$dir" "${opts[@]}" --list 2>/dev/null)" || routed=""
      while IFS= read -r routedjob; do
        [ -n "$routedjob" ] || continue
        case $'\n'"$ADOPT_ROUTED"$'\n' in
          *"$'\n'${routedjob}"$'\n'*) ;;
          *) ADOPT_ROUTED="${ADOPT_ROUTED:+${ADOPT_ROUTED}$'\n'}${routedjob}" ;;
        esac
      done <<<"$routed"
    fi
    rc=0
    out="$(python3 -I "$ROOT/routing-guard/routing_guard.py" --workflows-dir "$dir" "${opts[@]}" --jobs "$gjobs" 2>&1)" || rc=$?
    if [ "$rc" -eq 0 ]; then
      # The first guard that passes and agrees with the flags names the label
      # and options; they equal the flags' wherever one was given.
      if [ "$gmatch" = 1 ] && [ -z "$ADOPT_LABEL_OK" ]; then
        ADOPT_LABEL_OK="$glabel"
        ADOPT_OK_EVENTS="$gevents"
        ADOPT_OK_DEPENDABOT="$gdependabot"
        ADOPT_OK_FALLBACK="$gfallback"
      fi
      continue
    fi
    # The failure lines only: no colours, no passes, no header or totals.
    lines="$(printf '%s\n' "$out" | sed $'s/\033\\[[0-9;]*m//g' |
      grep -v -e PASS -e '^self-hosted runner routing' -e ' passed, ' -e '^$' || true)"
    adopt_reason "the routing-guard step at ${where} would fail:"
    ADOPT_REASONS="${ADOPT_REASONS}$(printf '%s\n' "$lines" | sed 's/^ */      /')"$'\n'
  done <<<"$rows"
  if [ "$ADOPT_GUARDS" = 0 ]; then
    adopt_each adopt_reason "${deferred:--}"
    if [ "$candidates" = 0 ]; then
      adopt_reason "no routing-guard step in .github/workflows (docs/adopting.md, step 3)"
    else
      adopt_reason "no routing-guard step that runs on pull requests (docs/adopting.md, step 3)"
    fi
    # No guard to say which label applies; look with the expected one, as before.
    # The options were checked above, so a failure here is the script not
    # running, not "no jobs": an empty list would hide it.
    ADOPT_ROUTED="$(python3 -I "$ROOT/routing-guard/routing_guard.py" --workflows-dir "$dir" --label "$ADOPT_LABEL" \
      --events "$ADOPT_EVENTS" --dependabot "$ADOPT_DEPENDABOT" --fallback "$ADOPT_FALLBACK" --list 2>/dev/null)" ||
      die "adopt: routing_guard.py could not list the routed jobs; run it by hand on the workflows to see why"
  elif [ -n "$ADOPT_LABEL_OK" ]; then
    ADOPT_LABEL="$ADOPT_LABEL_OK"
    ADOPT_EVENTS="$ADOPT_OK_EVENTS"
    ADOPT_DEPENDABOT="$ADOPT_OK_DEPENDABOT"
    ADOPT_FALLBACK="$ADOPT_OK_FALLBACK"
  fi
  if [ -z "$ADOPT_ROUTED" ]; then
    adopt_reason "no job uses the routing expression for label ${ADOPT_LABEL} (docs/adopting.md, step 2)"
  fi
  if [ "$ADOPT_READY" = 1 ]; then
    log "routing: ready, the guard passes and these jobs are routed: $(printf '%s' "$ADOPT_ROUTED" | tr '\n' ' ')"
  else
    log "routing: not ready"
    printf '%s' "$ADOPT_REASONS"
  fi
  if [ -n "$ADOPT_NOTES" ]; then
    adopt_warn "the routing guard may not run on every pull request. Check that every pull request that changes .github/workflows still runs it:"
    printf '%s' "$ADOPT_NOTES" | sed 's/^/homefield:   /' >&2
  fi
}

# adopt_fallback <image>: a warning only. routing_guard.py accepts any
# ubuntu-*, windows-* or macos-* name, so a typo such as ubuntu-lates passes
# the guard, and the jobs then wait for a runner that does not exist whenever
# CI_RUNNER is not local. This list is GitHub's standard hosted labels
# (docs.github.com, "GitHub-hosted runners", 2026-10). A label it does not
# know, a new image or a larger runner, only gets the warning.
adopt_fallback() {
  case "$1" in
    ubuntu-slim | ubuntu-latest | ubuntu-2[246].04 | ubuntu-2[246].04-arm | \
      windows-latest | windows-2022 | windows-2025 | windows-2025-vs2026 | \
      windows-11-arm | windows-11-vs2026-arm | \
      macos-latest | macos-1[45] | macos-26 | macos-1[45]-intel | macos-26-intel)
      log "fallback image: $1 is a standard GitHub-hosted label"
      ;;
    *)
      adopt_warn "fallback $1 is not one of GitHub's standard hosted labels that this version knows. If it is a typo, jobs wait for a runner that does not exist whenever CI_RUNNER is not local. Ignore this for a larger runner or an image newer than this list."
      ;;
  esac
}

# adopt_cache_keys <dir>: warnings only. See tools/adopt.py for what counts.
adopt_cache_keys() {
  local dir="$1" hits
  if [ "$ADOPT_WORKFLOWS" = 0 ]; then
    log "cache keys: no workflow files to look at"
    return 0
  fi
  hits="$(python3 -I "$ROOT/tools/adopt.py" cache-keys "$dir")" || die "adopt: could not read the downloaded workflows"
  # Only the routed jobs share caches across architectures, so once some are
  # routed, files without any routed job are left out (a nightly that stays
  # hosted is no concern). Before that, every file is a candidate.
  if [ -n "$ADOPT_ROUTED" ]; then
    local hit kept=""
    while IFS= read -r hit; do
      # ADOPT_ROUTED is file:job lines; a hit is file:line: text.
      case $'\n'"$ADOPT_ROUTED" in
        *$'\n'"${hit%%:*}":*) kept="${kept}${hit}"$'\n' ;;
      esac
    done <<<"$hits"
    hits="${kept%$'\n'}"
  fi
  if [ -z "$hits" ]; then
    log "cache keys: none found with runner.os and without runner.arch"
    return 0
  fi
  adopt_warn "cache keys with runner.os and no runner.arch (a text match; check what each one is the key of):"
  printf '%s\n' "$hits" | sed 's/^/homefield:   /' >&2
  adopt_warn "runner.os is Linux on the hosted runners and on this arm64 VM, so such a key lets the two architectures restore each other's build outputs. Add \${{ runner.arch }} (docs/adopting.md, step 4)."
}

# adopt_snippets <label> <jobs>: what to add to the workflows, with the
# options in ADOPT_EVENTS, ADOPT_DEPENDABOT and ADOPT_FALLBACK. The expression
# and the guard step come from the same code that checks them.
adopt_snippets() {
  local label="$1" jobs="$2" expr
  expr="$(python3 -I "$ROOT/routing-guard/routing_guard.py" --print-expression --label "$label" \
    --events "$ADOPT_EVENTS" --dependabot "$ADOPT_DEPENDABOT" --fallback "$ADOPT_FALLBACK")" ||
    die "adopt: the routing options cannot be routed on (label ${label}, events ${ADOPT_EVENTS}, dependabot ${ADOPT_DEPENDABOT}, fallback ${ADOPT_FALLBACK})"
  echo
  echo "Replace each job's runs-on with this expression, verbatim (docs/adopting.md, step 2):"
  echo
  echo "    runs-on: ${expr}"
  echo
  echo "Add the guard to a job that runs on every pull request, after checkout (step 3),"
  echo "listing every job you routed:"
  echo
  python3 -I "$ROOT/tools/adopt.py" guard-snippet --label "$label" --jobs "$jobs" \
    --events "$ADOPT_EVENTS" --dependabot "$ADOPT_DEPENDABOT" --fallback "$ADOPT_FALLBACK"
  echo
}

# adopt_switch <owner/repo> <label> <dry> <switch> <jobs>: sets CI_RUNNER to
# local through cmd_route when the routing is ready; otherwise prints what is
# missing and stops the command.
adopt_switch() {
  local repo="$1" label="$2" dry="$3" switch="$4" jobs="$5" current
  current="$(gh variable get CI_RUNNER --repo "$repo" 2>/dev/null || echo "(unset)")"
  if [ "$ADOPT_READY" = 1 ]; then
    if [ "$current" = local ]; then
      ADOPT_SWITCH_OUTCOME="is already local"
      log "switch: ${repo}: CI_RUNNER is already local; nothing to change"
    elif [ "$switch" = 0 ]; then
      ADOPT_SWITCH_OUTCOME="is ${current} (--no-switch)"
      log "switch: ${repo}: CI_RUNNER is ${current}; not switching (--no-switch)"
    elif [ "$dry" = 1 ]; then
      ADOPT_SWITCH_OUTCOME="would be set to local (dry run)"
      cmd_route local --repo "$repo" --label "$label" --dry-run
    else
      ADOPT_SWITCH_OUTCOME="set to local"
      cmd_route local --repo "$repo" --label "$label"
    fi
    return 0
  fi
  if [ "$current" = local ]; then
    adopt_warn "CI_RUNNER is already local on ${repo} although its routing is not in place; bin/homefield route hosted --repo ${repo} undoes that"
  fi
  adopt_snippets "$ADOPT_LABEL" "${jobs:-$(printf '%s' "$ADOPT_ROUTED" | tr '\n' ',')}"
  die "not switched: merge the routing first, then run homefield adopt again"
}

# The branch `adopt --setup` writes its pull request from (#124). A fixed
# name keeps a re-run pointed at the same pull request; an existing branch is
# refused rather than rewritten.
SETUP_BRANCH="homefield/route-to-local"
SETUP_MSG="Route CI jobs to the local HomeField runner"
# What adopt_setup has done so far, for the EXIT cleanup it installs.
ADOPT_SETUP_REPO=""
ADOPT_SETUP_BRANCH_MADE=0
ADOPT_SETUP_PR_MADE=0

# adopt_setup_cleanup: a run that died after creating the branch would leave
# its commits on GitHub with no pull request to review, and would refuse its
# own retry on the existing branch. Take the branch back. A branch that
# already existed, or one whose pull request was opened, is never touched.
adopt_setup_cleanup() {
  [ "$ADOPT_SETUP_BRANCH_MADE" = 1 ] && [ "$ADOPT_SETUP_PR_MADE" = 0 ] || return 0
  ADOPT_SETUP_BRANCH_MADE=0
  echo "homefield: removing ${SETUP_BRANCH} on ${ADOPT_SETUP_REPO}, which has no pull request" >&2
  gh api -X DELETE "repos/${ADOPT_SETUP_REPO}/git/refs/heads/${SETUP_BRANCH}" >/dev/null 2>&1 ||
    echo "homefield: could not remove ${SETUP_BRANCH} on ${ADOPT_SETUP_REPO}: delete it by hand" >&2
}

# adopt_setup <owner/repo> <label> <expr> <jobs> <dry>: the --setup path, the
# workflow edits of docs/adopting.md steps 1-4 opened as a pull request. The
# plan comes from tools/adopt.py setup over the same downloaded workflows a
# normal adopt checks; it is verified with routing_guard.py before anything
# leaves the Mac, then written to SETUP_BRANCH through the Contents API and
# opened with POST /pulls. Nothing here touches the runner group or CI_RUNNER:
# that is step 5, after the pull request is merged. Needs gh with write access
# to the repository; needs no VM.
adopt_setup() {
  local repo="$1" label="$2" expr="$3" jobs="$4" dry="$5"
  local setup="$ADOPT_TMP/setup" plan kind value name enc sha head_sha url body check line
  local opts=(--label "$label") routed="" files=""
  [ -z "$ADOPT_FLAG_EVENTS" ] || opts+=(--events "$ADOPT_FLAG_EVENTS")
  [ -z "$ADOPT_FLAG_DEPENDABOT" ] || opts+=(--dependabot "$ADOPT_FLAG_DEPENDABOT")
  [ -z "$ADOPT_FLAG_FALLBACK" ] || opts+=(--fallback "$ADOPT_FLAG_FALLBACK")
  ADOPT_SETUP_REPO="$repo"

  plan="$(python3 -I "$ROOT/tools/adopt.py" setup "$ADOPT_TMP/workflows" "$setup" \
    --expression "$expr" --jobs "$jobs" "${opts[@]}" 2>"$ADOPT_TMP/setup-err")" ||
    die "adopt: setup: $(head -1 "$ADOPT_TMP/setup-err")"
  while IFS=$'\t' read -r kind value; do
    case "$kind" in
      ROUTED) routed="${routed:+${routed},}${value}" ;;
      FILE) files="${files}${value}"$'\n' ;;
    esac
  done <<<"$plan"
  [ -n "$routed" ] || die "adopt: setup: no job was planned; run bin/homefield adopt without --setup to see why"
  while IFS= read -r line; do adopt_warn "$line"; done <"$ADOPT_TMP/setup-err"

  log "setup: routes $(printf '%s' "$routed" | tr ',' ' ')"
  while IFS= read -r name; do
    [ -n "$name" ] && log "setup: changes .github/workflows/${name}"
  done <<<"$files"
  # The staged files are checked with the very script the guard step runs, so
  # merging what we generate cannot fail CI on routing.
  check="$(python3 -I "$ROOT/routing-guard/routing_guard.py" --workflows-dir "$setup" "${opts[@]}" --jobs "$routed" 2>&1)" || {
    printf '%s\n' "$check" | sed $'s/\033\\[[0-9;]*m//g' |
      grep -v -e PASS -e '^self-hosted runner routing' -e ' passed, ' -e '^$' >&2 || true
    die "adopt: setup: the generated workflows would fail the routing guard; nothing was sent to ${repo}"
  }
  if [ "$dry" = 1 ]; then
    log "setup: dry run: nothing was sent to ${repo}"
    return 0
  fi

  head_sha="$(gh api "repos/${repo}/commits/${ADOPT_BRANCH}" --jq .sha 2>"$ADOPT_TMP/err")" ||
    die "adopt: setup: could not read ${ADOPT_BRANCH} on ${repo}: $(head -1 "$ADOPT_TMP/err")"
  if gh api "repos/${repo}/git/ref/heads/${SETUP_BRANCH}" --jq .object.sha >/dev/null 2>&1; then
    die "adopt: setup: the branch ${SETUP_BRANCH} already exists on ${repo}: merge or close its pull request, or delete the branch, and run again"
  fi
  gh api -X POST "repos/${repo}/git/refs" -f ref="refs/heads/${SETUP_BRANCH}" -f sha="$head_sha" >/dev/null ||
    die "adopt: setup: could not create ${SETUP_BRANCH} on ${repo}"
  ADOPT_SETUP_BRANCH_MADE=1
  trap 'adopt_setup_cleanup; rm -rf "$ADOPT_TMP"' EXIT
  log "setup: created ${SETUP_BRANCH} from ${ADOPT_BRANCH}"

  while IFS= read -r name; do
    [ -n "$name" ] || continue
    enc="$(python3 -I "$ROOT/tools/adopt.py" quote "$name" </dev/null)" || exit 1
    # A workflow that does not exist on the branch yet (the new guard file)
    # has no sha to update, and the Contents API creates it. -X GET matters:
    # -f alone would switch gh api to POST, which never answers this lookup.
    sha="$(gh api -X GET "repos/${repo}/contents/.github/workflows/${enc}" -f ref="$SETUP_BRANCH" --jq .sha 2>/dev/null)" || sha=""
    python3 -I "$ROOT/tools/adopt.py" contents-payload "$setup/$name" "${sha:-none}" "$SETUP_MSG" "$SETUP_BRANCH" \
      >"$ADOPT_TMP/put.json" || die "adopt: setup: could not stage .github/workflows/${name}"
    gh api -X PUT "repos/${repo}/contents/.github/workflows/${enc}" --input "$ADOPT_TMP/put.json" >/dev/null ||
      die "adopt: setup: could not write .github/workflows/${name} to ${SETUP_BRANCH} on ${repo}"
    log "setup: wrote .github/workflows/${name}"
  done <<<"$files"

  # shellcheck disable=SC2016  # `${{ runner.arch }}` is literal text for the PR body, not this shell's
  body="$(printf 'This PR routes these jobs to the local HomeField runner. See [docs/adopting.md](docs/adopting.md).\n\n%s\n\nGenerated by `homefield adopt --repo %s --setup`:\n\n- Every routed job now carries the canonical `runs-on` expression for label %s (docs/adopting.md, step 2).\n- The routing guard lists exactly these jobs (step 3).\n- Cache keys in the routed files that were built from `runner.os` gained `${{ runner.arch }}` (step 4).\n\nNothing is switched on by this PR: `CI_RUNNER` stays unset, so everything runs hosted. After merging, run `homefield adopt --repo %s` to add the repository to the runner group and route (step 5).\n' \
    "$(printf '%s\n' "$routed" | tr ',' '\n' | sed 's/^/- /')" "$repo" "$label" "$repo")"
  url="$(gh api -X POST "repos/${repo}/pulls" -f title="$SETUP_MSG" -f head="$SETUP_BRANCH" -f base="$ADOPT_BRANCH" -f body="$body" --jq .html_url 2>"$ADOPT_TMP/err")" ||
    die "adopt: setup: could not open the pull request on ${repo}: $(head -1 "$ADOPT_TMP/err")"
  ADOPT_SETUP_PR_MADE=1
  log "created pull request: ${url}"
  log "next: review and merge it, then homefield adopt --repo ${repo} (docs/adopting.md, step 5)"
}

cmd_adopt() {
  local repo="" nrepo=0 label="homefield-ci" label_given=0 group="homefield-ci" jobs="" switch=1 dry=0 setup=0 entry out
  ADOPT_FLAG_EVENTS="" ADOPT_FLAG_DEPENDABOT="" ADOPT_FLAG_FALLBACK=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repo="${2:?--repo needs a value}"; nrepo=$((nrepo + 1)); shift 2 ;;
      --label) label="${2:?--label needs a value}"; label_given=1; shift 2 ;;
      --events) ADOPT_FLAG_EVENTS="${2:?--events needs a value}"; shift 2 ;;
      --dependabot) ADOPT_FLAG_DEPENDABOT="${2:?--dependabot needs a value}"; shift 2 ;;
      --fallback) ADOPT_FLAG_FALLBACK="${2:?--fallback needs a value}"; shift 2 ;;
      --group) group="${2:?--group needs a value}"; shift 2 ;;
      --jobs) jobs="${2:?--jobs needs a value}"; shift 2 ;;
      --setup) setup=1; shift ;;
      --no-switch) switch=0; shift ;;
      --dry-run) dry=1; shift ;;
      *) die "adopt: unknown option $1 (see bin/homefield help)" ;;
    esac
  done
  [ "$nrepo" -gt 0 ] || die "adopt: --repo <owner>/<repo> is required"
  [ "$nrepo" -eq 1 ] || die "adopt: one --repo at a time"
  [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "adopt: --repo must be <owner>/<repo>, got: $repo"
  [[ "$label" =~ ^[A-Za-z0-9._-]+$ ]] || die "adopt: --label must be one label"
  [ -n "$group" ] || die "adopt: --group needs a name"
  for entry in $(printf '%s' "$jobs" | tr ',' ' '); do
    [[ "$entry" =~ ^[A-Za-z0-9._-]+\.ya?ml:[A-Za-z0-9_-]+$ ]] || die "adopt: --jobs entries are <workflow-file>:<job-id>, such as ci.yml:lint; got: $entry"
  done
  command -v gh >/dev/null || die "adopt needs gh (https://cli.github.com)"
  command -v python3 >/dev/null || die "adopt needs python3"
  # The same label and option rules as the guard, and a message from it when
  # they fail.
  out="$(python3 -I "$ROOT/routing-guard/routing_guard.py" --print-expression --label "$label" \
    --events "${ADOPT_FLAG_EVENTS:-pull_request}" --dependabot "${ADOPT_FLAG_DEPENDABOT:-hosted}" \
    --fallback "${ADOPT_FLAG_FALLBACK:-ubuntu-latest}" 2>&1)" ||
    die "adopt: the routing options cannot be routed on: $(printf '%s' "$out" | sed $'s/\033\\[[0-9;]*m//g')"
  [ "$dry" = 0 ] || log "dry run: nothing will be changed"

  ADOPT_TMP="$(mktemp -d)"
  trap 'rm -rf "$ADOPT_TMP"' EXIT
  adopt_repository "$repo"
  adopt_fetch_workflows "$repo" "$ADOPT_BRANCH" "$ADOPT_TMP/workflows"
  if [ "$setup" = 1 ]; then
    # --setup stops at the pull request: steps 1-4 as a review, no group
    # access and no switch, which stay the plain adopt run of step 5.
    adopt_setup "$repo" "$label" "$out" "$jobs" "$dry"
    return 0
  fi
  adopt_routing_check "$ADOPT_TMP/workflows" "$label" "$label_given"
  adopt_cache_keys "$ADOPT_TMP/workflows"
  adopt_fallback "$ADOPT_FALLBACK"
  adopt_group_access "$repo" "$group" "$dry"
  adopt_switch "$repo" "$ADOPT_LABEL" "$dry" "$switch" "$jobs"

  log "done: ${repo}: runner group ${ADOPT_GROUP_OUTCOME}; routing ready; CI_RUNNER ${ADOPT_SWITCH_OUTCOME}"
  log "still by hand: open a pull request and check the jobs ran on the local runner, add any tools they lack, and record the setup in the repository (docs/adopting.md, steps 6 and 7)"
}

# memory_cutoff_epoch <cutoff-day> <rows>: the cutoff day's midnight as an
# epoch, in the timezone the rows themselves carry. The summary selects
# rows by each row's own (guest) calendar day, so the epoch that decides a
# first row or a reboot must use the same day boundary — the host's
# midnight is a different instant when the zones differ (#91 review). The
# offset comes from the first row at/after the cutoff (an earlier row's day
# is outside the window). Empty when nothing is at/after the cutoff or the
# date cannot be parsed, which the summary then treats as "cannot decide".
memory_cutoff_epoch() {
  local cutoff="$1" rows="$2" offset
  offset="$(printf '%s\n' "$rows" | awk -F, -v cutoff="$cutoff" '
    $1 != "ts" && substr($1, 1, 10) >= cutoff { print substr($1, 20, 5); exit }')"
  [ -n "$offset" ] || return 0
  # ts is always YYYY-MM-DDTHH:MM:SS+HHMM (samplers %z), so the offset sits
  # at characters 20-24. BSD date first, GNU fallback: the tool runs only on
  # macOS, but the suites run here and on Linux CI.
  date -j -f "%Y-%m-%dT%H:%M:%S%z" "${cutoff}T00:00:00${offset}" +%s 2>/dev/null ||
    date -d "${cutoff}T00:00:00${offset}" +%s 2>/dev/null || true
}

# Per-day summary of the guest's memwatch rows (vm/provision.sh,
# homefield-memwatch): ts,samples,total_mib,used_avg_mib,used_max_mib,
# avail_min_mib,oom_kills,job[,boot]. Files sort by date, so rows arrive in
# time order and the cumulative oom counter can be diffed row to row. The
# counter restarts at a reboot, so: a boot change between two rows (column 9,
# added for #91) means the whole value is kills since that boot; same boot,
# take the difference. Both whole-counter cases count only when that boot is
# known (a 0 from an unreadable btime is unknown, not a boot at the epoch)
# and began inside the window (cutoff_epoch, compared as epochs) — kills
# under a boot older than the window span its start and cannot be split, and
# guessing would overcount, the #91 review's point against prev = 0. Rows
# from before column 9 (8 fields) fall back to the counter rule: a smaller
# value than before means a reboot; nothing can be decided for their first
# row, which stays uncounted.
# shellcheck disable=SC2016  # awk, not shell, expands the $n fields
MEMORY_AWK='
BEGIN { FS = ","; prev = -1; prev_boot = -1 }
$1 == "ts" || (NF != 8 && NF != 9) { next }
{
  day = substr($1, 1, 10)
  boot = (NF >= 9 && $9 + 0 > 0 ? $9 + 0 : -1)
  if (day < cutoff) { prev = $7; prev_boot = boot; next }
  if (!(day in n)) { order[++days] = day; mn[day] = -1 }
  n[day]++
  sum[day] += $4
  if ($5 > peak[day]) { peak[day] = $5; at[day] = substr($1, 12, 5) }
  if (mn[day] < 0 || $6 < mn[day]) mn[day] = $6
  if ($8 == 1) { busy[day]++; if ($5 > bpeak[day]) bpeak[day] = $5 }
  if (prev < 0) {
    if (boot >= 0 && cutoff_epoch != "" && boot >= cutoff_epoch + 0) oom[day] += $7
  } else if (boot >= 0 && prev_boot >= 0 && boot != prev_boot) {
    # Rebooted between rows: the counter is all kills since the NEW boot.
    # It counts only when that boot is inside the window — the previous row
    # can precede the window and the reboot can too, and then the counter
    # reaches across the boundary (#91 review).
    if (cutoff_epoch != "" && boot >= cutoff_epoch + 0) oom[day] += $7
  } else {
    oom[day] += ($7 >= prev ? $7 - prev : $7)
  }
  prev = $7
  prev_boot = boot
  total = $3
  tn++
  tsum += $4
  if ($5 > tpeak) { tpeak = $5; tday = day; tat = substr($1, 12, 5) }
}
END {
  if (days == 0) exit 3
  printf "%-10s %8s %9s %9s %10s %9s %5s\n", "day", "minutes", "avg MiB", "peak MiB", "job peak", "min avail", "OOM"
  for (i = 1; i <= days; i++) {
    d = order[i]
    printf "%-10s %8d %9d %9d %10s %9d %5d\n", d, n[d], sum[d] / n[d], peak[d], (busy[d] ? bpeak[d] : "-"), mn[d], oom[d]
    allOom += oom[d]
  }
  printf "\nVM memory %d MiB. Over %d minutes: average %d MiB, highest minute %d MiB (%d%%) on %s at %s, %d out-of-memory kills.\n", total, tn, tsum / tn, tpeak, tpeak * 100 / total, tday, tat, allOom
}'

cmd_memory() {
  local days=7 cutoff rows rc cutoff_epoch
  while [ $# -gt 0 ]; do
    case "$1" in
      --days) days="${2:?--days needs a value}"; shift 2 ;;
      *) die "memory: unknown option $1 (see bin/homefield help)" ;;
    esac
  done
  if ! [[ "$days" =~ ^[0-9]+$ ]] || [ "$days" -lt 1 ]; then
    die "memory: --days must be a positive number"
  fi
  check_host
  vm_lookup
  [ "$VM_STATUS" = "Running" ] || die "memory: VM ${INSTANCE} is not running"
  # BSD date, as on macOS: today minus (days - 1), so --days 1 is today.
  cutoff="$(date -v-"$((days - 1))"d +%F)"
  rows="$(guest sh -c 'cat /var/log/homefield/memwatch-*.csv 2>/dev/null; true')" || exit 1
  [ -n "$rows" ] || die "memory: no samples in ${INSTANCE} yet; the sampler is installed by bin/homefield upgrade"
  # The same instant as an epoch, for comparing the CSV's boot column
  # (#91): midnight at the start of the cutoff day, measured in the guests
  # timezone from the rows themselves, never the hosts.
  cutoff_epoch="$(memory_cutoff_epoch "$cutoff" "$rows")"
  rc=0
  printf '%s\n' "$rows" | awk -v cutoff="$cutoff" -v cutoff_epoch="$cutoff_epoch" "$MEMORY_AWK" || rc=$?
  [ "$rc" -ne 3 ] || die "memory: no samples since ${cutoff}"
  [ "$rc" -eq 0 ] || exit "$rc"
}

cmd_report() {
  command -v python3 >/dev/null || die "report needs python3"
  command -v gh >/dev/null || die "report needs gh (https://cli.github.com)"
  exec python3 "$ROOT/tools/report.py" "$@"
}

# update_command <repo> <ref>: the install.sh one-liner (README, Quick start)
# for that ref, plus the settings that differ from install.sh's defaults, so
# that it replaces this copy and not some other one. The default ref here is
# install.sh's: change both when a release is cut.
update_command() {
  local repo="$1" ref="$2" settings=""
  [ "$repo" = i2Dev-com/homefield ] || settings="${settings}HOMEFIELD_REPO=${repo} "
  [ "$ref" = v0.3.1 ] || settings="${settings}HOMEFIELD_REF=${ref} "
  [ "$ROOT" = "$HOME/.local/share/homefield" ] || settings="${settings}HOMEFIELD_HOME='${ROOT}' "
  echo "  curl -fsSL https://raw.githubusercontent.com/${repo}/${ref}/install.sh | ${settings}bash"
}

# github_read <gh|curl> <repo> <commits REF|tags>: the commit REF resolves to,
# or the repository's tag names (first 100), one per line. gh when it is there
# (it reads a private fork too); otherwise curl against the public API, which
# needs no login. A branch with a slash (release/1) goes into the path
# encoded, and curl follows redirects (a renamed repository answers 301).
github_read() {
  local via="$1" repo="$2" what="$3" ref="${4:-}"
  ref="${ref//\//%2F}"
  if [ "$via" = gh ]; then
    case "$what" in
      commits) gh api "repos/${repo}/commits/${ref}" --jq .sha ;;
      tags) gh api --paginate "repos/${repo}/tags?per_page=100" --jq '.[].name' ;;
    esac
    return
  fi
  case "$what" in
    commits) curl -fsSL --max-time 15 -H 'Accept: application/vnd.github.sha' "https://api.github.com/repos/${repo}/commits/${ref}" ;;
    tags)
      curl -fsSL --max-time 15 "https://api.github.com/repos/${repo}/tags?per_page=100" |
        sed -n 's/^ *"name": *"\([^"]*\)".*/\1/p'
      ;;
  esac
}

# update_check <repo> <ref> <commit>: says whether the ref this copy was
# installed from has moved, and whether a later release exists (the highest
# vMAJOR.MINOR.PATCH tag, when the installed ref is such a tag too). Reads
# GitHub through gh, or curl when gh is missing (github_read). Their own
# output is dropped: whatever goes wrong is one line here, and nothing here
# fails the command.
update_check() {
  local repo="$1" ref="$2" commit="$3" current="" tags="" tag="" latest="" advised=0
  local la="" lb="" lc="" a b c
  local repo_re='^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$' ref_re='^[A-Za-z0-9_./-]+$' sha_re='^[0-9a-f]{40}$'
  local tag_re='^v([0-9]+)[.]([0-9]+)[.]([0-9]+)$' via hint
  if command -v gh >/dev/null; then
    via=gh hint="see gh auth status"
  elif command -v curl >/dev/null; then
    via=curl hint="a private repository needs gh"
  else
    log "could not check for updates (neither gh nor curl is installed)"
    return 0
  fi
  if [[ ! "$repo" =~ $repo_re || "$repo" == *..* || ! "$ref" =~ $ref_re || "$ref" == *..* || "$ref" == -* ]]; then
    log "could not check for updates (.homefield-ref has no usable repo and ref)"
    return 0
  fi
  if [ -z "$commit" ]; then
    log "could not check for updates (.homefield-ref records no commit)"
    return 0
  fi
  # A branch or tag name resolves to the commit it points at (an annotated tag
  # is followed to its commit). A full commit hash cannot move.
  if [[ ! "$ref" =~ $sha_re ]]; then
    if ! current="$(github_read "$via" "$repo" commits "$ref" 2>/dev/null)"; then
      log "could not check for updates (${via} could not read ${ref} in ${repo}; ${hint})"
      return 0
    fi
    if [[ ! "$current" =~ $sha_re ]]; then
      log "could not check for updates (unexpected answer from ${via} for ${ref} in ${repo})"
      return 0
    fi
  fi
  if ! tags="$(github_read "$via" "$repo" tags 2>/dev/null)"; then
    log "could not check for updates (${via} could not list the tags of ${repo}; ${hint})"
    return 0
  fi
  # The highest release tag, compared part by part as numbers (no sort -V on
  # the bash 3.2 and BSD tools macOS ships).
  while IFS= read -r tag; do
    [[ "$tag" =~ $tag_re ]] || continue
    a="${BASH_REMATCH[1]}" b="${BASH_REMATCH[2]}" c="${BASH_REMATCH[3]}"
    if [ -z "$latest" ] || [ "$a" -gt "$la" ] ||
      { [ "$a" -eq "$la" ] && { [ "$b" -gt "$lb" ] || { [ "$b" -eq "$lb" ] && [ "$c" -gt "$lc" ]; }; }; }; then
      latest="$tag" la="$a" lb="$b" lc="$c"
    fi
  done <<<"$tags"

  # The recorded commit may be a short hash (install.sh falls back to one).
  if [ -z "$current" ]; then
    log "installed at a fixed commit (${commit:0:7}), so there is no ref to compare"
  elif [[ "$current" == "$commit"* ]]; then
    log "up to date with ${ref}"
  else
    log "${ref} has moved to ${current:0:7} since this copy was installed; update with:"
    update_command "$repo" "$ref"
    advised=1
  fi
  # Only when the installed ref is a release tag too: a branch follows its own
  # head, and a fixed commit has no release to compare.
  if [ -n "$latest" ] && [[ "$ref" =~ $tag_re ]]; then
    a="${BASH_REMATCH[1]}" b="${BASH_REMATCH[2]}" c="${BASH_REMATCH[3]}"
    if [ "$la" -gt "$a" ] || { [ "$la" -eq "$a" ] && { [ "$lb" -gt "$b" ] || { [ "$lb" -eq "$b" ] && [ "$lc" -gt "$c" ]; }; }; }; then
      log "${latest} is out (installed: ${ref}); read CHANGELOG.md for breaking changes, then update with:"
      update_command "$repo" "$latest"
      advised=1
    fi
  fi
  if [ "$advised" = 1 ]; then
    echo "That replaces the tool and leaves the VM alone; homefield upgrade updates the VM."
  fi
}

# What install.sh recorded when it installed this copy (repo, ref, commit),
# and whether that ref has moved on; a git checkout says where it is instead.
cmd_version() {
  [ $# -eq 0 ] || die "version takes no options besides --instance"
  local key value repo="" ref="" commit=""
  if [ -f "$ROOT/.homefield-ref" ]; then
    while IFS='=' read -r key value; do
      case "$key" in
        repo) repo="$value" ;;
        ref) ref="$value" ;;
        commit) commit="$value" ;;
      esac
    done <"$ROOT/.homefield-ref"
    echo "homefield ${ref:-unknown}${commit:+ (${commit:0:7})}, installed from ${repo:-unknown} in ${ROOT}"
    update_check "$repo" "$ref" "$commit"
  elif git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    echo "homefield $(git -C "$ROOT" describe --always), from a checkout in ${ROOT}"
  else
    echo "homefield (version unknown), in ${ROOT}"
  fi
}

# ── Main ────────────────────────────────────────────────────────────────────
# --instance may come before or after the command.
main() {
  local cmd="" rest=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --instance) INSTANCE="${2:?--instance needs a value}"; shift 2 ;;
      *)
        if [ -z "$cmd" ]; then cmd="$1"; else rest+=("$1"); fi
        shift
        ;;
    esac
  done
  [ -n "$cmd" ] || { usage >&2; exit 1; }
  # Only the commands that act on the VM: preflight, route, adopt, report and
  # version never use it, so a stale HOMEFIELD_INSTANCE does not stop them.
  case "$cmd" in setup | install | upgrade | status | diagnose | uninstall | reset | memory) check_instance ;; esac
  set -- "${rest[@]+"${rest[@]}"}"
  case "$cmd" in
    preflight) [ $# -eq 0 ] || die "preflight takes no options (see bin/homefield help)"; cmd_preflight ;;
    setup) cmd_setup "$@" ;;
    install) cmd_install "$@" ;;
    upgrade) cmd_upgrade "$@" ;;
    status) cmd_status "$@" ;;
    diagnose) cmd_diagnose "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    reset) cmd_reset "$@" ;;
    route) cmd_route "$@" ;;
    adopt) cmd_adopt "$@" ;;
    memory) cmd_memory "$@" ;;
    report) cmd_report "$@" ;;
    version | --version) cmd_version "$@" ;;
    help | -h | --help) usage ;;
    *) usage >&2; exit 1 ;;
  esac
}

# The tests source this file to call the functions above on their own.
[ "${HOMEFIELD_SOURCE_ONLY:-}" = 1 ] || main "$@"

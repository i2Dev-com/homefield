#!/usr/bin/env bash
# Set up, upgrade, inspect and remove the local GitHub Actions runner on this
# Mac: a Lima VM from vm/lima.yaml, provisioned by vm/provision.sh. Wraps the
# manual steps in docs/runbook.md, which stays the reference for what each one
# does and why.
#
#   bin/homefield setup [--url https://github.com/<org>[/<repo>]] [options]
#   bin/homefield install [--url https://github.com/<org>[/<repo>]] [options]
#   bin/homefield upgrade [--packages "..."] [--force]
#   bin/homefield status
#   bin/homefield diagnose [--json]
#   bin/homefield uninstall [--keep-vm]
#   bin/homefield reset [--keep-vm] [--keep-group] [--remove-tool]
#   bin/homefield route <hosted|local> --repo <owner>/<repo> [--repo ...]
#   bin/homefield adopt --repo <owner>/<repo> [--jobs "ci.yml:lint,..."] [--setup [--wait [--wait-timeout MIN]]] [--guards] [--events E] [--dependabot hosted|local] [--fallback IMAGE] [--no-switch] [--dry-run]
#   bin/homefield memory [--days N]
#   bin/homefield report --repo <owner>/<repo> [--repo ...] [--since DATE]
#   bin/homefield version
#
# install.sh puts this on the PATH as `homefield`; the messages below say
# bin/homefield, which is the same file in a checkout.
#
# Every command takes --instance NAME (default homefield, or $HOMEFIELD_INSTANCE)
# to pick the Lima VM. Run `bin/homefield help <command>` for a command's
# options, `bin/homefield help` for the full reference.
set -euo pipefail
# Runs on macOS's stock bash 3.2, which turns `set -e` off inside $(...). A
# function that can fail inside one says `|| exit 1` where it calls another.

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# The paths below are read across the modules (lib/vm.sh, cmd-undo.sh).
# shellcheck disable=SC2034
LIMA_YAML="$ROOT/vm/lima.yaml"
# shellcheck disable=SC2034  # read by lib/vm.sh and cmd-undo.sh
PROVISION="$ROOT/vm/provision.sh"
# The guest helpers provision.sh installs, staged beside it (see run_provision).
# shellcheck disable=SC2034  # read by lib/vm.sh
GUEST_DIR="$ROOT/vm/guest"
# The tool's modules: presentation, state, the VM, GitHub, and one file per
# command. Sourced in glob order, which is deterministic; every chunk is
# definitions and literal initializations, so order only decides which file
# a reader looks in.
# shellcheck disable=SC1090  # the module list is the glob: the manifest is the directory
for _hf_lib in "$ROOT"/bin/lib/*.sh "$ROOT"/bin/cmd-*.sh; do
  [ -f "$_hf_lib" ] || continue
  . "$_hf_lib"
done
unset _hf_lib
DEFAULT_INSTANCE="homefield"
INSTANCE="${HOMEFIELD_INSTANCE:-$DEFAULT_INSTANCE}"
# 1 when --instance (or HOMEFIELD_INSTANCE) named one VM. Commands that can
# report every VM on this Mac then act on just the one named; otherwise they
# cover all of them (#182).
EXPLICIT_INSTANCE=0
[ -z "${HOMEFIELD_INSTANCE:-}" ] || EXPLICIT_INSTANCE=1
# The --color= option as typed, forwarded to the per-VM runs of vm_dispatch.
COLOR_ARG=""
# The globals below are read across the modules (lib/vm.sh, lib/github.sh and
# the command files), so shellcheck's per-file view sees them as unused.
# shellcheck disable=SC2034
RUNNER_HOME="/opt/actions-runner"
# Seconds runner_on_github waits for gh before calling the answer "not
# checked" (#103): gh has no timeout flag, and on a black-holed network a
# connect can take ~75 s on macOS. Tests drive it low through the env.
GH_TIMEOUT="${HOMEFIELD_GH_TIMEOUT:-15}"
case "$GH_TIMEOUT" in ''|*[!0-9]*) GH_TIMEOUT=15 ;; esac


# ── Usage ───────────────────────────────────────────────────────────────────
# The help text in pieces, so each surface prints only what it needs and the
# full text stays one text: `homefield help` cats every piece in order (the
# sections below are the reference, byte for byte what one file said before
# the split), `homefield help <command>` and `<command> --help` print a
# command's paragraph and its own options, and `homefield --help` prints the
# short overview (usage_short).
usage_header() {
  cat <<'EOF'
Usage: bin/homefield <command> [options]

Every command that acts on a VM covers every HomeField VM on this Mac by
default; --instance (or $HOMEFIELD_INSTANCE) narrows it to the one named.
install and setup create/register exactly the instance they are given.
EOF
}

usage_cmd_setup() {
  cat <<'EOF'
  setup      The whole first-time setup in one command: preflight must pass in
             full (any failed check stops it with nothing created; on a
             terminal, a gh that is not logged in is first offered
             `gh auth login` when it is the only failed check, with
             `-s admin:org` when --url is an organization), then the
             same steps as install, ending with a summary of what is done (and
             what needs attention) and the next steps, including the
             repositories that can already use the runner. On a terminal it then
             offers to open the routing pull request and carry on once you
             merge it (homefield adopt --setup --wait) for the repository the
             runner is registered to, or asks which repository to route first
             for an organization; it opens nothing unless you say yes, and a
             failed pull request does not fail setup (Ctrl-C while it waits
             ends setup with 130). Takes install's options. On an instance
             that is already registered it upgrades, like install.
EOF
}
usage_cmd_install() {
  cat <<'EOF'
  install    Create the VM (if needed), provision it and register the runner.
             For an organization it also creates the runner group, and it
             waits until the runner shows online. On an instance that is
             already registered, this is an upgrade. The lower-level command
             setup runs: it reports preflight but does not stop on it.
EOF
}
usage_cmd_upgrade() {
  cat <<'EOF'
  upgrade    Re-run provisioning on a registered runner: packages, hooks,
             runner binary. A VM with a job running is refused and skipped,
             unless --force; the others are still upgraded. A VM that cannot
             be asked whether one is is skipped too. Exits 0 only when every
             VM was upgraded.
EOF
}
usage_cmd_status() {
  cat <<'EOF'
  status     Show each VM, its registration (and whether GitHub still lists
             it) and whether a job is running. One block per VM; exits 0 only
             when every one of them answered well.
EOF
}
usage_cmd_start() {
  cat <<'EOF'
  start      Boot each VM, then report whether its runner is taking jobs:
             booted and online are separate facts. Exits 0 when every runner
             is online (service running, GitHub lists it online), 1 otherwise
             with the fix per VM; a failure on one never skips the next.
EOF
}
usage_cmd_stop() {
  cat <<'EOF'
  stop       Stop each VM, so its runner takes no jobs until it starts again.
             A VM with a job running is refused (that job would be cancelled)
             and skipped, as is one that cannot be asked whether it has one;
             the others are still stopped. Autostart stays as it was, so a
             reboot starts them again; stopping an already stopped VM is not
             an error. Exits 0 only when every VM reached Stopped.
EOF
}
usage_cmd_diagnose() {
  cat <<'EOF'
  diagnose   One read-only report per VM for when something went wrong: the VM
             (created, isolated, registered, listed on GitHub, service,
             version, npm), the runner group on GitHub's side (its access and
             which repositories are in it) and — once, before the VMs by
             default — the prerequisites. Each report ends in a summary that
             names the command fixing each problem; --json wraps them as
             instances/healthy/prerequisites/vms. Exits 0 when every VM is
             healthy, 1 otherwise. Starts and changes nothing: a VM that is not
             running is reported, not started.
EOF
}
usage_cmd_uninstall() {
  cat <<'EOF'
  uninstall  Deregister the runner and delete one VM. With more than one on
             this Mac, or with its only VM under another name, it refuses until
             --instance names which: deleting every runner is never a default.
EOF
}
usage_cmd_reset() {
  cat <<'EOF'
  reset      Roll back an install, complete or half-finished: deregister the
             runner if it registered, delete the VM, and delete the runner
             group if this install created it (and nothing else is in it).
             Lists what it will remove and asks first; HOMEFIELD_YES=1 answers
             yes. Nothing to undo is not an error. Unlike uninstall it does
             not need a VM to exist. Refuses as uninstall does when the VM is
             not named and this Mac has more than one, or only another name.
EOF
}
usage_cmd_route() {
  cat <<'EOF'
  route      Switch repositories' routed jobs to hosted or local
             (the CI_RUNNER variable). Switching to hosted also cancels and
             re-runs runs whose jobs are stuck waiting for the local runner.
             A repository that cannot be switched is warned about and skipped;
             the others are still routed. Exits 0 only when every repository
             was routed.
EOF
}
usage_cmd_preflight() {
  cat <<'EOF'
  preflight  Check prerequisites for a fresh install: macOS, Apple Silicon,
              Lima, gh, python3, brew. Exits 0 when all pass, 1
              otherwise (with messages pointing to the exact fix command).
              Designed to be run before install; setup and install call it
              first (setup stops on a failure, install only reports it).
EOF
}
usage_cmd_adopt() {
  cat <<'EOF'
  adopt      Prepare a repository to use the runner: check that its routing is
             merged, and only then give it access to the runner group and
             switch it to local. Refuses a public repository.
EOF
}
usage_cmd_memory() {
  cat <<'EOF'
  memory     Show every VM's memory use from its per-minute log: average and
             peak per day, and out-of-memory kills. A VM that is not running,
             or has no samples yet, fails as it did before; the others are
             still reported.
EOF
}
usage_cmd_report() {
  cat <<'EOF'
  report     Queue wait, duration and minutes of the jobs in repositories,
             local against hosted, from the GitHub API.
EOF
}
usage_cmd_version() {
  cat <<'EOF'
  version    Show which version of this tool is installed, and whether a
             newer one is available (checked with gh).
EOF
}

# usage_commands: the full Commands: list — every paragraph, no blanks
# between, as the full usage prints it.
usage_commands() {
  echo "Commands:"
  usage_cmd_setup
  usage_cmd_install
  usage_cmd_upgrade
  usage_cmd_status
  usage_cmd_start
  usage_cmd_stop
  usage_cmd_diagnose
  usage_cmd_uninstall
  usage_cmd_reset
  usage_cmd_route
  usage_cmd_preflight
  usage_cmd_adopt
  usage_cmd_memory
  usage_cmd_report
  usage_cmd_version
}

usage_options() {
  cat <<'EOF'
Options:
  --instance NAME    Lima instance: one VM instead of every HomeField VM on
                     this Mac. Defaults to all of them for the commands that act
                     on a VM, and install/setup create "homefield";
                     $HOMEFIELD_INSTANCE names one as if it were passed.
EOF
}
usage_sec_install() {
  cat <<'EOF'
install (and setup, which takes the same options):
  --url URL          https://github.com/<org> or https://github.com/<owner>/<repo>
                     (asked for on a terminal when a new registration has none).
                     Whether the owner is an organization or a personal account
                     is looked up first (gh, else the public API). A personal
                     account has no account-wide runners and no runner groups,
                     so it needs a repository URL; with only its owner URL,
                     a terminal is asked for the repository, and without one
                     install stops, naming --url https://github.com/<you>/<repo>
  --personal         treat the owner as a personal account without looking it
                     up (the lookup needs the API, and a token that can see the
                     account). Cannot be combined with --org
  --org              treat the owner as an organization without looking it up.
                     Cannot be combined with --personal
  --label LABEL      routing label (default homefield-ci)
  --name NAME        runner name (default: this Mac's local hostname and the
                     instance, e.g. my-mac-homefield). Must be free in the
                     scope: a name already registered there is refused
  --replace          if the name is taken, remove that registration (a stale
                     one of this Mac's, say) right before registering. If it
                     is another machine's runner, that runner stops working
  --group GROUP      org runner group (default homefield-ci; ignored for a repo
                     or a personal account).
                     Created if missing: selected repositories, no public ones.
                     On the GitHub Free plan, use Default: custom groups
                     need Team or Enterprise
  --group-exists     the group exists and you checked it (selected
                     repositories, public ones off): go on when gh cannot
                     list the groups, instead of asking. Registration still
                     fails if the group is missing
  --packages "A B"   extra apt packages (RUNNER_EXTRA_PACKAGES)
  --preset NAME      add a shipped preset's apt packages and hooks on top of
                     what the VM has; repeatable. Shipped: browsers, hosted.
                     Unlike --packages it never replaces the saved list
                     (docs/runbook.md, "Adding tools")
  --cpus N           VM CPUs, when creating it (default: vm/lima.yaml)
  --memory GIB       VM memory in GiB, when creating it (default: vm/lima.yaml)
  --no-autostart     do not start the VM at login
EOF
}
usage_sec_upgrade() {
  cat <<'EOF'
upgrade:
  --packages "A B"   replace the saved extra packages
  --preset NAME      add a shipped preset's apt packages and hooks on top of
                     what the VM has; repeatable. Shipped: browsers, hosted.
                     Unlike --packages it never replaces the saved list
                     (docs/runbook.md, "Adding tools")
  --force            upgrade even while a job is running (the job is cancelled)
EOF
}
usage_sec_diagnose() {
  cat <<'EOF'
diagnose:
  --json             machine-readable output: the same facts, a top-level
                     healthy boolean and a problems array; nothing else on
                     stdout. Needs neither jq nor python3. A check that needs
                     GitHub waits at most HOMEFIELD_GH_TIMEOUT seconds (15).
EOF
}
usage_sec_status() {
  cat <<'EOF'
status:
  --json             machine-readable output: the same facts, one object per
                     VM (instance, healthy, the VM's status, the runner and
                     its registration, the GitHub listing, the service, the
                     job, npm, the extra packages), wrapped as
                     instances/healthy/vms when every HomeField VM on this
                     Mac is reported; nothing else on stdout. Needs neither
                     jq nor python3. The GitHub ask waits at most
                     HOMEFIELD_GH_TIMEOUT seconds (15).
EOF
}
usage_sec_uninstall() {
  cat <<'EOF'
uninstall:
  --keep-vm          only deregister; keep the VM
EOF
}
usage_sec_reset() {
  cat <<'EOF'
reset:
  --keep-vm          only deregister; keep the VM
  --keep-group       keep the runner group. Without this, the group is deleted
                     only if install created it (recorded in
                     ~/.local/state/homefield/<instance>.state, or under
                     $HOMEFIELD_STATE_DIR), it is not Default, GitHub still
                     lists it with that id and name, and no runner other than
                     this one is in it
  --remove-tool      also remove the `homefield` command and the tool's files
                     install.sh put on this Mac. They are shared by every
                     instance, so this is not the default. Done last, and
                     only when every other step worked
EOF
}
usage_sec_route() {
  cat <<'EOF'
route <hosted|local>:
  --repo OWNER/REPO  repository to switch (repeat for several; required)
  --label LABEL      routing label of the stuck jobs to look for (default homefield-ci)
  --dry-run          show what would change, change nothing
  Needs gh with write access to the repositories' variables and runs. Does
  not need the VM.
EOF
}
usage_sec_adopt() {
  cat <<'EOF'
adopt:
  --repo OWNER/REPO  the repository to adopt (required, one)
  --label LABEL      routing label (default homefield-ci; a routing-guard step
                     with another label in the workflows is used as it is)
  --guards           generate and check the guarded (multi-clause) expression.
                     Without it, a repository without a guard gets simple
                     mode — the one-clause expression
                     \${{ vars.CI_RUNNER == 'local' && 'homefield-ci' || 'ubuntu-latest' }}
                     whose only guardrail is the CI_RUNNER switch: it routes
                     every event, so it assumes everyone who can open a pull
                     request is trusted with the Mac, and `homefield route
                     hosted` rolls it back. A guard already in the repository
                     keeps its own shape either way; simple mode also accepts
                     the guarded expression, so a mixed repository passes
  --events "E,..."   events whose jobs are routed (default pull_request; also
                     push, workflow_dispatch, schedule). Needs --guards in
                     simple mode, which routes every event. Like
                     --label: shapes the printed expression when there is no
                     guard yet, and must equal the guard's `events` when there
                     is one. Jobs on push, workflow_dispatch and schedule wait
                     for the Mac: a deploy gated on CI can queue behind it
  --dependabot hosted|local
                     keep Dependabot's jobs hosted (default) or route them
                     too; needs --guards in simple mode. Same rules as
                     --events. Dependabot's install scripts then run on a VM
                     that is not thrown away
  --fallback IMAGE   hosted image used when CI_RUNNER is not local (default
                     ubuntu-latest; ubuntu-*, windows-* or macos-*); same
                     rules as --events
  --group GROUP      runner group the repository needs access to (default
                     homefield-ci; skipped for Default and for personal accounts)
  --jobs "F:J,..."   file:job entries you mean to route, for the snippets it
                     prints when the routing is not in place yet and, with
                     --setup, the hosted jobs to route on top of those
                     already routed (the latter always stay listed)
  --setup            open a pull request that writes steps 1-4 of
                     docs/adopting.md instead of waiting for them: every job
                     of a workflow that runs on pull requests and asks today
                     for a GitHub-hosted image gets the canonical expression
                     (with a comment pointing at the guide), the routing guard
                     lists exactly those jobs (written to
                     .github/workflows/homefield-routing.yml when the
                     repository has no guard yet), and the cache keys built
                     from runner.os in those files gain runner.arch. A
                     workflow whose file name holds a space or comma is never
                     routed (a guard jobs: list cannot hold it); the run says
                     so. Exits 1 with "nothing to route" when no job
                     qualifies. It needs write access to the repository, and
                     touches neither the runner group nor CI_RUNNER: after you
                     merge it, run adopt without --setup
                     (docs/adopting.md, step 5), or add --wait.
  --wait             with --setup: after opening the pull request, wait for
                     you to merge it, then carry on in this run with what
                     adopt without --setup does (group access, then
                     CI_RUNNER=local). Nothing is switched or added to the
                     group while waiting, and the merge stays yours: if the
                     merged routing does not pass, it stops as a plain adopt
                     would. Checks every 10 seconds. Ctrl-C is safe in every
                     phase: adopt says where things stand (a pull request
                     is left as it is, a branch without one is taken back),
                     and adopt without --setup picks up from there. Exits
                     4 when the pull request is closed without a merge,
                     still open at the timeout, or cannot be read, and 5
                     when it was merged but adopt then failed (130 and 143
                     after Ctrl-C and SIGTERM). Exits 1
                     for anything before the pull request exists, as without
                     --wait. A fresh `homefield setup` offers this command
                     (with --label and --group when given)
  --wait-timeout MIN minutes --wait waits for the merge (default 60; a whole
                     number, 1 or more; only with --wait)
  --no-switch        do everything except set CI_RUNNER
  --dry-run          read-only: report what would change, change nothing
  --verify           after the switch (or when CI_RUNNER was already local),
                     re-run the repository's latest completed pull-request run
                     and report, job by job, whether it ran on the local
                     runner (docs/adopting.md, step 6). It uses CI minutes,
                     waits up to about 3 minutes, and never changes adopt's
                     exit status. Without --verify, a terminal is asked first
                     (default no); without a terminal the commands are printed
  --no-verify        never offer it, and never touch the repository's runs
  Reads the repository's workflows on its default branch. Only when the
  routing guard is there (the pinned action, in a workflow that runs
  on pull requests), passes and at least one job is routed does it add the
  repository to the group and switch it; otherwise it prints what to add and
  exits 1, having changed nothing. Adding the repository to the group needs
  admin:org; without it, it says so and goes on. --setup stops earlier: it
  opens the routing pull request and changes nothing else (unless --wait
  carries on after the merge; with --dry-run it waits for nothing). Writing
  .github/workflows/ needs the workflow scope of a classic PAT; without it,
  --setup stops before anything is created, naming `gh auth refresh -s workflow`.
  Needs gh and python3. Does not need the VM.
EOF
}
usage_sec_memory() {
  cat <<'EOF'
memory:
  --days N           how many days to show (default 7)
  The log is written by the guest every minute from samples taken every 2
  seconds, so a short spike is kept. "Used" is total minus available memory.
EOF
}
usage_sec_report() {
  cat <<'EOF'
report:
  --repo OWNER/REPO  repository to include (repeat for several; required)
  --since DATE       first day, YYYY-MM-DD, UTC (default: the 1st of this month)
  --until DATE       last day, inclusive (default: today)
  --label LABEL      routing label that marks a job as local (default homefield-ci)
  --json             machine-readable output
  Needs gh with read access to the repositories' runs. Does not need the VM.
  Queue wait is from a job being queued to it starting; minutes are each
  job's duration rounded up to the minute, as GitHub bills hosted jobs. For
  local jobs that is what they would have cost. Looks at every attempt of
  every run, so it makes one API call per run: allow a few minutes a month.
EOF
}

usage_tokens() {
  cat <<'EOF'
Registration and removal need a one-hour token. It is fetched with `gh` when
your gh credentials allow it (org owner with admin:org, or repository admin);
otherwise you are asked to paste one from the "New runner" page. Tokens go to
the VM on stdin, never on a command line. For an organization, gh also reads
and creates the runner group, which needs the same admin:org scope: on a
terminal you are offered `gh auth refresh -s admin:org` if it is missing;
without one, pass --group-exists for a group you created and checked by hand.
EOF
}

# usage_join <pieces...>: the pieces with one blank line between, the full
# text's own separators.
usage_join() {
  local first=1
  while [ $# -gt 0 ]; do
    [ "$first" = 1 ] || echo ""
    first=0
    "$1"
    shift
  done
}

# usage: the full reference, on `homefield help`. The pieces in the order the
# one heredoc had them, so the text is unchanged.
usage() {
  usage_join usage_header usage_commands usage_options \
    usage_sec_install \
    usage_sec_upgrade \
    usage_sec_diagnose \
    usage_sec_status \
    usage_sec_uninstall \
    usage_sec_reset \
    usage_sec_route \
    usage_sec_adopt \
    usage_sec_memory \
    usage_sec_report \
    usage_tokens
}

# usage_for <command>: one command's help, for `homefield help <command>`
# and `<command> --help`: the overview header, the command's paragraph from
# the Commands: list, its own options, the global --instance note, and — for
# the commands that register, deregister or ask for a token — the token
# paragraph. setup takes install's options, so it prints install's section.
usage_for() {
  case "$1" in
    setup)
      usage_join usage_header usage_cmd_setup usage_sec_install usage_options usage_tokens ;;
    install)
      usage_join usage_header usage_cmd_install usage_sec_install usage_options usage_tokens ;;
    upgrade)
      usage_join usage_header usage_cmd_upgrade usage_sec_upgrade usage_options ;;
    status)
      usage_join usage_header usage_cmd_status usage_sec_status usage_options ;;
    start)
      usage_join usage_header usage_cmd_start usage_options ;;
    stop)
      usage_join usage_header usage_cmd_stop usage_options ;;
    diagnose)
      usage_join usage_header usage_cmd_diagnose usage_sec_diagnose usage_options ;;
    uninstall)
      usage_join usage_header usage_cmd_uninstall usage_sec_uninstall usage_options usage_tokens ;;
    reset)
      usage_join usage_header usage_cmd_reset usage_sec_reset usage_options usage_tokens ;;
    route)
      usage_join usage_header usage_cmd_route usage_sec_route usage_options ;;
    preflight)
      usage_join usage_header usage_cmd_preflight usage_options ;;
    adopt)
      usage_join usage_header usage_cmd_adopt usage_sec_adopt usage_options ;;
    memory)
      usage_join usage_header usage_cmd_memory usage_sec_memory usage_options ;;
    report)
      usage_join usage_header usage_cmd_report usage_sec_report usage_options ;;
    version)
      usage_join usage_header usage_cmd_version usage_options ;;
    *)
      die "help: unknown command '$1' (see bin/homefield help)" ;;
  esac
}

usage_short() {
  cat <<'EOF'
Usage: bin/homefield <command> [options]

Run GitHub Actions pull-request jobs on a Lima VM on this Mac, with a hosted
fallback. Every command that acts on a VM covers every HomeField VM on this
Mac by default; --instance (or $HOMEFIELD_INSTANCE) narrows it to the one
named. install and setup create/register exactly the instance they are given.

Commands:
  setup      The whole first-time setup in one command (install's options)
  install    Create the VM, provision it and register the runner
  upgrade    Re-run provisioning on a registered runner
  status     Show each VM, its registration and whether a job is running
  start      Boot each VM, then report whether its runner is taking jobs
  stop       Stop each VM (refused while a job is running)
  diagnose   One read-only report per VM, for when something went wrong
  uninstall  Deregister the runner and delete one VM
  reset      Roll back an install, complete or half-finished
  route      Switch repositories' routed jobs to hosted or local
  preflight  Check prerequisites for a fresh install
  adopt      Prepare a repository to use the runner
  memory     Show every VM's memory use from its per-minute log
  report     Queue wait, duration and minutes of jobs, local against hosted
  version    Show the installed version, and whether a newer one exists

Run `bin/homefield help <command>` for a command's options, `bin/homefield
help` for the full reference. The guides live in docs/: getting-started.md
(first install), adopting.md (routing a repository), runbook.md (operating
the runner), security.md (the routing guard's contract), cli.md (every
command, option, exit code and environment variable, for scripts and agents).
EOF
}


# ── Color ───────────────────────────────────────────────────────────────────
# Colors are for the severity markers (OK/WARN/FAIL, warnings, errors) and
# only when the user will actually see them: the default (auto) colors a
# terminal and leaves a pipe alone, because every consumer of piped output —
# the test suites' substring matches, a `grep homefield`, CI logs — wants the
# plain text. HOMEFIELD_COLOR=always forces colors into a pipe (NO_COLOR beats
# it, as the no-color.org convention), --color=never beats the variable, and
# --color=always beats both being unset. Each level's marker keeps its plain
# word (OK, WARN, FAIL, warning:) so `--color=never` output is byte-identical
# to the pre-color output and scrapers of either form never see an escape.
HF_ANSI_OFF=1
# color_init [args...]: scan the option list once, before any output. Called
# from main with the command's arguments; a sourced bin/homefield (tests) calls
# it through the emitters below, so the level of a marker never depends on
# where in main it was set.

color_wrap() { # color_wrap <code> <text>: <text> wrapped in <code>, or bare
  if [ "$HF_ANSI_OFF" = 0 ]; then
    printf '%s%s%s' "$(hf_color "$1")" "$2" "$(hf_color 0)"
  else
    printf '%s' "$2"
  fi
}

log() { echo "homefield: $*"; }




# check_instance: INSTANCE is a name Lima accepts (ValidateInstName, Lima 1.2
# on; 1.1 checks the same characters and length, not the .yml/.yaml ending),
# the same check as install.sh's. Anything else would reach limactl as an
# option (--help) or a path.


# The line every HomeField VM's stored Lima config starts with: lima.yaml is
# copied from vm/lima.yaml when the VM is created, comments included, and it has
# carried this header since v0.1.0. Other Lima instances on a dev Mac do not,
# so listing all of them would report VMs HomeField never made.
# shellcheck disable=SC2034  # read by lib/vm.sh's is_homefield_vm
HF_VM_MARKER='# Lima VM for the local GitHub Actions runner.'




# instance_command <name> [command args...]: this tool, one VM, as its own
# process. A single-instance run keeps its errexit and die semantics intact,
# and a failure on one VM cannot change the state of the next.
# shellcheck disable=SC2034  # read by lib/vm.sh's instance_command
HF_SELF="$ROOT/bin/homefield"




# vm_lookup: vm_status into VM_STATUS (empty: no VM), for the commands that act
# on "no VM": create one, or report that there is none. A Lima that could not be
# asked ends the command (install would otherwise register a runner group and
# then fail to create a VM that exists). Not a $(...), so die ends the command.
# shellcheck disable=SC2034  # read by lib/vm.sh
VM_STATUS=""


# --workdir /: the host's working directory does not exist in the guest, which
# has no mounts. stdin is closed, or `limactl shell` would swallow whatever is
# typed ahead, such as a token meant for the prompt; guest_stdin is for the
# two calls that feed a token in on purpose.
guest() { limactl shell --workdir / "$INSTANCE" "$@" </dev/null; }
guest_stdin() { limactl shell --workdir / "$INSTANCE" "$@"; }


# The VM is the isolation boundary, so nothing runs in it until it is shown to
# have no host data mounts and no view of the Mac's home directories. A guest
# command that cannot run at all is reported as such: treating its empty
# output as "no mounts found" would misread a broken VM as a safe one. The
# one expected mount is Apple's read-only Rosetta share (#21), which
# isolation_probe excludes by its exact line.
#
# isolation_probe is the check itself, for the callers that report instead of
# stopping (diagnose): 0 verified, 1 broken (host mounts, or /Users visible),
# 2 the guest could not be asked. It prints nothing; ISOLATION_WHY says what it
# found, and ISOLATION_SUFFIX is what verify_isolation adds to that in its die.
# shellcheck disable=SC2034  # read by lib/vm.sh
ISOLATION_WHY=""
# shellcheck disable=SC2034  # read by lib/vm.sh
ISOLATION_SUFFIX=""






# registered: 0 if the runner is registered, 1 if not, 2 if the VM could not be
# asked. Commands that act on the answer call is_registered instead.
registered() { guest_has_file "$RUNNER_HOME/.runner"; }







# runner_version: the runner version provision.sh installed, or "unknown".
runner_version() { guest sudo cat "$RUNNER_HOME/.provisioned-version" 2>/dev/null || echo unknown; }
# runner_extra_packages: the saved extra apt packages, on one line.
runner_extra_packages() { guest sh -c 'cat /etc/homefield/extra-packages 2>/dev/null | tr "\n" " "'; }









# have_terminal: stdin is a terminal to ask on (a seam for the tests).
have_terminal() { [ -t 0 ]; }







# ── Runner name ─────────────────────────────────────────────────────────────
# The guest's hostname, lima-<instance>, is the same on every Mac, so a second
# Mac registering under it would take the first one's registration (#52). The
# default is this Mac's local hostname plus the instance instead: unique per
# Mac on a network, and it says which machine a runner is on.




# ── Runner group ────────────────────────────────────────────────────────────
# The group is what keeps an organization's other repositories off the runner
# (docs/runbook.md, "Runner group"), so install makes sure it exists before
# the runner joins it, instead of leaving that to a manual step.









# lower <text>: in lower case (bash 3.2 has no ${var,,}).
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }



# The instance's state file on this Mac: what install did that reset has to
# undo, as `key=value` lines. Today one key, group_created=<org>/<group
# name>/<group id>, set only when install itself created the runner group (a
# group that was already there is never recorded, so reset never deletes
# it). Per instance, and outside the tool's own directory, which install.sh
# replaces on every update. docs/runbook.md, "Rolling back a failed install".
state_file() { printf '%s/%s.state' "${HOMEFIELD_STATE_DIR:-$HOME/.local/state/homefield}" "$INSTANCE"; }













































# ── diagnose ────────────────────────────────────────────────────────────────
# One read-only report over state the other commands already look at, for the
# moment an install, upgrade or adopt has gone wrong: the VM (status's checks,
# plus isolation), the runner group on GitHub's side, and preflight's
# prerequisites. It collects everything into DG_* first and prints afterwards,
# so the human and the --json form say the same thing, and --json prints
# nothing but the JSON on stdout.
#
# Read-only is a property to keep: nothing here starts or stops the VM or the
# runner, registers, or writes. `limactl shell` starts a stopped instance, so
# the guest is only asked about a VM that lists as Running. Unlike the
# loopback probe of install, nothing opens a listener on the Mac.
#
# Every gh call is bounded by runner_on_github's GH_TIMEOUT, which comes first
# and decides whether the later ones are made at all: the runner group and its
# repositories are only read once GitHub has answered it.

# json_nstr <text>: json_str, or null for an empty text.
json_nstr() { if [ -n "$1" ]; then json_str "$1"; else printf null; fi; }


# dg_warn <text>: something that could not be checked; not a problem found.
dg_warn() { DG_WARN+=("$1"); }
# dg_hint <text>: a next step, for a runner that is otherwise healthy.
dg_hint() { DG_HINT+=("$1"); }

















# ── reset ───────────────────────────────────────────────────────────────────
# reset rolls back a complete or half-finished install of one instance: the
# runner's registration, the VM and the runner group install created, and with
# --remove-tool the tool itself. It works from what exists now, so a failed
# install, an uninstall that stopped partway and a VM deleted by hand are all
# one case; nothing existing is a no-op. What it removes is in the plan it
# prints and asks about before any change, and in the report it ends with.

# Where install.sh put the tool: the same defaults as install.sh's
# HOMEFIELD_HOME and pick_bin_dir. install.sh cannot be sourced from here (it
# runs on load), so the two are kept in step by hand, and tests/reset.sh
# removes a wrapper that install.sh itself wrote.
tool_install_dir() { printf '%s' "${HOMEFIELD_HOME:-$HOME/.local/share/homefield}"; }



rep() { REPORT+=("$1"); }






# ── adopt ───────────────────────────────────────────────────────────────────
# Everything docs/adopting.md asks for that is not a workflow edit: a check that
# the routing is merged, the runner group's access list, and the switch. The
# group and the switch both wait for the routing: a repository that can reach
# the runner before its jobs carry the guarded expression has nothing keeping
# the runner to pull requests from its own branches.


adopt_warn() { echo "homefield: warning: $(color_wrap 2 "$*")" >&2; }


































# ── Main ────────────────────────────────────────────────────────────────────
# --instance may come before or after the command.
main() {
  local cmd="" rest=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --instance)
        INSTANCE="${2:?--instance needs a value}"
        # shellcheck disable=SC2034  # read across the modules (lib/vm.sh, cmd-install, cmd-diagnose)
        EXPLICIT_INSTANCE=1
        shift 2
        ;;
      # --color is global, accepted before or after the command, and never
      # reaches a command's own parser: the emitters read HF_ANSI_OFF, which
      # color_init sets before any output.
      --color=*) COLOR_ARG="$1"; shift ;;
      *)
        if [ -z "$cmd" ]; then cmd="$1"; else rest+=("$1"); fi
        shift
        ;;
    esac
  done
  [ -n "$cmd" ] || { usage_short >&2; exit 1; }
  color_init ${COLOR_ARG:+"$COLOR_ARG"} "$cmd"
  # Only the commands that act on the VM: preflight, route, adopt, report and
  # version never use it, so a stale HOMEFIELD_INSTANCE does not stop them.
  case "$cmd" in setup | install | upgrade | status | start | stop | diagnose | uninstall | reset | memory) check_instance ;; esac
  set -- "${rest[@]+"${rest[@]}"}"
  # <command> --help (or -h) prints that command's help, before the command's
  # own parser sees the flag: no command takes -h for anything else. --help
  # before the command (--homefield --help) is the short overview, handled
  # below; color_init has run, so the emitters' level is already set.
  local arg
  for arg in ${rest[@]+"${rest[@]}"}; do
    case "$arg" in -h | --help) usage_for "$cmd"; return 0 ;; esac
  done
  case "$cmd" in
    preflight) [ $# -eq 0 ] || die "preflight takes no options (see bin/homefield help)"; cmd_preflight ;;
    setup) cmd_setup "$@" ;;
    install) cmd_install "$@" ;;
    upgrade) cmd_upgrade "$@" ;;
    status) cmd_status "$@" ;;
    start) cmd_start "$@" ;;
    stop) cmd_stop "$@" ;;
    diagnose) cmd_diagnose "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    reset) cmd_reset "$@" ;;
    route) cmd_route "$@" ;;
    adopt) cmd_adopt "$@" ;;
    memory) cmd_memory "$@" ;;
    report) cmd_report "$@" ;;
    version | --version) cmd_version "$@" ;;
    help)
      # help (no argument): the full reference. help <command>: that command's
      # help, the same text <command> --help prints.
      if [ $# -eq 0 ]; then
        usage
      elif [ $# -eq 1 ]; then
        usage_for "$1"
      else
        die "help: unknown topic '$2' (see bin/homefield help)"
      fi
      ;;
    -h | --help) usage_short ;;
    *) usage_short >&2; exit 1 ;;
  esac
}


# The tests source this file to call the functions above on their own.
[ "${HOMEFIELD_SOURCE_ONLY:-}" = 1 ] || main "$@"

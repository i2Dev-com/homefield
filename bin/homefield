#!/usr/bin/env bash
# Set up, upgrade, inspect and remove the local GitHub Actions runner on this
# Mac: a Lima VM from vm/lima.yaml, provisioned by vm/provision.sh. Wraps the
# manual steps in docs/runbook.md, which stays the reference for what each one
# does and why.
#
#   bin/homefield install [--url https://github.com/<org>[/<repo>]] [options]
#   bin/homefield upgrade [--packages "..."] [--force]
#   bin/homefield status
#   bin/homefield uninstall [--keep-vm]
#   bin/homefield route <hosted|local> --repo <owner>/<repo> [--repo ...]
#   bin/homefield adopt --repo <owner>/<repo> [--jobs "ci.yml:lint,..."] [--events E] [--dependabot hosted|local] [--fallback IMAGE] [--no-switch] [--dry-run]
#   bin/homefield memory [--days N]
#   bin/homefield report --repo <owner>/<repo> [--repo ...] [--since DATE]
#   bin/homefield version
#
# install.sh puts this on the PATH as `homefield`; the messages below say
# bin/homefield, which is the same file in a checkout.
#
# Every command takes --instance NAME (default homefield, or $HOMEFIELD_INSTANCE)
# to pick the Lima VM. Run `bin/homefield help` for the options.
set -euo pipefail
# Runs on macOS's stock bash 3.2, which turns `set -e` off inside $(...). A
# function that can fail inside one says `|| exit 1` where it calls another.

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIMA_YAML="$ROOT/vm/lima.yaml"
PROVISION="$ROOT/vm/provision.sh"
GUEST_PROVISION="/tmp/provision.sh"
INSTANCE="${HOMEFIELD_INSTANCE:-homefield}"
RUNNER_HOME="/opt/actions-runner"
# Seconds runner_on_github waits for gh before calling the answer "not
# checked" (#103): gh has no timeout flag, and on a black-holed network a
# connect can take ~75 s on macOS. Tests drive it low through the env.
GH_TIMEOUT="${HOMEFIELD_GH_TIMEOUT:-15}"
case "$GH_TIMEOUT" in ''|*[!0-9]*) GH_TIMEOUT=15 ;; esac

usage() {
  cat <<'EOF'
Usage: bin/homefield <command> [options]

Commands:
  install    Create the VM (if needed), provision it and register the runner.
             For an organization it also creates the runner group, and it
             waits until the runner shows online. On an instance that is
             already registered, this is an upgrade.
  upgrade    Re-run provisioning on a registered runner: packages, hooks,
             runner binary. Refuses while a job is running, unless --force.
             Also refuses when the VM cannot be asked whether one is.
  status     Show the VM, the registration (and whether GitHub still lists
             it) and whether a job is running.
  uninstall  Deregister the runner and delete the VM.
  route      Switch repositories' routed jobs to hosted or local
             (the CI_RUNNER variable). Switching to hosted also cancels and
             re-runs runs whose jobs are stuck waiting for the local runner.
  preflight  Check prerequisites for a fresh install: macOS, Apple Silicon,
              Lima, gh, python3, brew. Exits 0 when all pass, 1
              otherwise (with messages pointing to the exact fix command).
              Designed to be run before install; install calls it first.
  adopt      Prepare a repository to use the runner: check that its routing is
             merged, and only then give it access to the runner group and
             switch it to local. Refuses a public repository.
  memory     Show the VM's memory use from its per-minute log: average and
             peak per day, and out-of-memory kills.
  report     Queue wait, duration and minutes of the jobs in repositories,
             local against hosted, from the GitHub API.
  version    Show which version of this tool is installed, and whether a
             newer one is available (checked with gh).

Options:
  --instance NAME    Lima instance (default homefield, or $HOMEFIELD_INSTANCE)

install:
  --url URL          https://github.com/<org> or https://github.com/<owner>/<repo>
                     (asked for on a terminal when a new registration has none)
  --label LABEL      routing label (default homefield-ci)
  --name NAME        runner name (default: this Mac's local hostname and the
                     instance, e.g. my-mac-homefield). Must be free in the
                     scope: a name already registered there is refused
  --replace          if the name is taken, remove that registration (a stale
                     one of this Mac's, say) right before registering. If it
                     is another machine's runner, that runner stops working
  --group GROUP      org runner group (default homefield-ci; ignored for a repo).
                     Created if missing: selected repositories, no public ones.
                     On the GitHub Free plan, use Default: custom groups
                     need Team or Enterprise
  --group-exists     the group exists and you checked it (selected
                     repositories, public ones off): go on when gh cannot
                     list the groups, instead of asking. Registration still
                     fails if the group is missing
  --packages "A B"   extra apt packages (RUNNER_EXTRA_PACKAGES)
  --cpus N           VM CPUs, when creating it (default: vm/lima.yaml)
  --memory GIB       VM memory in GiB, when creating it (default: vm/lima.yaml)
  --no-autostart     do not start the VM at login

upgrade:
  --packages "A B"   replace the saved extra packages
  --force            upgrade even while a job is running (the job is cancelled)

uninstall:
  --keep-vm          only deregister; keep the VM

route <hosted|local>:
  --repo OWNER/REPO  repository to switch (repeat for several; required)
  --label LABEL      routing label of the stuck jobs to look for (default homefield-ci)
  --dry-run          show what would change, change nothing
  Needs gh with write access to the repositories' variables and runs. Does
  not need the VM.

adopt:
  --repo OWNER/REPO  the repository to adopt (required, one)
  --label LABEL      routing label (default homefield-ci; a routing-guard step
                     with another label in the workflows is used as it is)
  --events "E,..."   events whose jobs are routed (default pull_request; also
                     push, workflow_dispatch, schedule). Like
                     --label: shapes the printed expression when there is no
                     guard yet, and must equal the guard's `events` when there
                     is one. Jobs on push, workflow_dispatch and schedule wait
                     for the Mac: a deploy gated on CI can queue behind it
  --dependabot hosted|local
                     keep Dependabot's jobs hosted (default) or route them
                     too; same rules as --events. Dependabot's install
                     scripts then run on a VM that is not thrown away
  --fallback IMAGE   hosted image used when CI_RUNNER is not local (default
                     ubuntu-latest; ubuntu-*, windows-* or macos-*); same
                     rules as --events
  --group GROUP      runner group the repository needs access to (default
                     homefield-ci; skipped for Default and for personal accounts)
  --jobs "F:J,..."   file:job entries you mean to route, for the snippets it
                     prints when the routing is not in place yet
  --no-switch        do everything except set CI_RUNNER
  --dry-run          read-only: report what would change, change nothing
  Reads the repository's workflows on its default branch. Only when the
  routing guard is there (the pinned action, in a workflow that runs
  on pull requests), passes and at least one job is routed does it add the
  repository to the group and switch it; otherwise it prints what to add and
  exits 1, having changed nothing. Adding the repository to the group needs
  admin:org; without it, it says so and goes on. Needs gh and python3. Does
  not need the VM.

memory:
  --days N           how many days to show (default 7)
  The log is written by the guest every minute from samples taken every 2
  seconds, so a short spike is kept. "Used" is total minus available memory.

report:
  --repo OWNER/REPO  repository to include (repeat for several; required)
  --since DATE       first day, YYYY-MM-DD, UTC (default: the 1st of this month)
  --until DATE       last day, inclusive (default: today)
  --label LABEL      routing label that marks a job as local (default homefield-ci)
  --json             machine-readable output
  Needs gh with read access to the repositories' runs. Does not need the VM.
  Queue wait is from a job being queued to it starting; minutes are each
  job's duration rounded up to the minute, as GitHub bills hosted jobs. For
  local jobs that is what they would have cost. Looks at every attempt of
  every run, so it makes one API call per run: allow a few minutes a month.

Registration and removal need a one-hour token. It is fetched with `gh` when
your gh credentials allow it (org owner with admin:org, or repository admin);
otherwise you are asked to paste one from the "New runner" page. Tokens go to
the VM on stdin, never on a command line. For an organization, gh also reads
and creates the runner group, which needs the same admin:org scope: on a
terminal you are offered `gh auth refresh -s admin:org` if it is missing;
without one, pass --group-exists for a group you created and checked by hand.
EOF
}

die() {
  echo "homefield: $*" >&2
  exit 1
}
log() { echo "homefield: $*"; }

# ── Host and VM ─────────────────────────────────────────────────────────────
check_host() {
  [ "$(uname -s)" = "Darwin" ] || die "needs macOS (Lima with Apple's Virtualization.framework)"
  [ "$(uname -m)" = "arm64" ] || die "needs an Apple Silicon Mac: the VM is arm64"
  command -v limactl >/dev/null || die "needs Lima >= 2.0: brew install lima"
  local version major minor
  version="$(limactl --version | awk '{print $NF}')"
  major="${version%%.*}"
  minor="${version#*.}"
  minor="${minor%%.*}"
  # 2.0 is the first release documented to accept the `template:` locator in
  # vm/lima.yaml; it deprecated `template://` (Lima 2.0.0 release notes).
  if ! [[ "$major" =~ ^[0-9]+$ && "$minor" =~ ^[0-9]+$ ]] || [ "$major" -lt 2 ]; then
    die "needs Lima >= 2.0, found ${version}"
  fi
}

# cmd_preflight: everything an install needs, reported one line per check
# instead of stopping at the first failure like check_host, each failure with
# the command that fixes it. Exits 0 when every check passes, 1 otherwise.
# gh is not strictly needed: without it, install asks for a pasted token, so
# gh missing is a failure to fix, gh logged out is a failure too, and a token
# without admin:org only warns (an organization URL is what needs that scope,
# a repository URL is registered with repo; `gh auth refresh -s admin:org`).
# Lima >= 2.0 is the same check as check_host's.
cmd_preflight() {
  local failed=0 total=0 version major minor login scopes whoami py_version
  # Lima
  total=$((total + 1))
  if ! command -v limactl >/dev/null 2>&1; then
    echo "  FAIL  Lima not found: run 'brew install lima'"
    failed=$((failed + 1))
  else
    version="$(limactl --version 2>/dev/null | awk '{print $NF}')"
    major="${version%%.*}"
    minor="${version#*.}"
    minor="${minor%%.*}"
    if ! [[ "$major" =~ ^[0-9]+$ && "$minor" =~ ^[0-9]+$ ]] || [ "$major" -lt 2 ]; then
      echo "  FAIL  Lima >= 2.0 required, found ${version:-unknown}: run 'brew install lima'"
      failed=$((failed + 1))
    else
      echo "  OK    Lima $version"
    fi
  fi
  # gh: the active account, by login and scopes. App-installed tokens report no
  # scopes; the `Token scopes` line of `gh auth status` is absent for them, and
  # `gh auth status` also lists accounts that are not active.
  total=$((total + 1))
  if ! command -v gh >/dev/null 2>&1; then
    echo "  FAIL  gh (GitHub CLI) not found: run 'brew install gh'"
    failed=$((failed + 1))
  else
    whoami="$(gh auth status --json hosts --jq '.hosts["github.com"] // [] | map(select(.active)) | (.[0] // {}) | "\(.login // "")|\(.scopes // "")"' 2>/dev/null)" || whoami="|"
    login="${whoami%%|*}"
    scopes="${whoami#*|}"
    if [ -z "$login" ]; then
      echo "  FAIL  gh not logged in: run 'gh auth login'"
      failed=$((failed + 1))
    elif [ -z "$scopes" ]; then
      echo "  OK    gh authenticated as $login (no scope reported; an organization URL needs admin:org)"
    elif case ",$scopes," in *,admin:org,*) true ;; *) false ;; esac; then
      echo "  OK    gh authenticated as $login (admin:org scope)"
    else
      echo "  WARN  gh authenticated as $login, no admin:org scope (an organization URL needs it: gh auth refresh -s admin:org)"
    fi
  fi
  # python3: resolving on PATH is not enough — a broken shim prints but exits
  # non-zero, so the version command's own status decides.
  total=$((total + 1))
  if ! command -v python3 >/dev/null 2>&1; then
    echo "  FAIL  python3 not found: run 'brew install python'"
    failed=$((failed + 1))
  elif py_version="$(python3 --version 2>&1)"; then
    echo "  OK    python3 ($py_version)"
  else
    echo "  FAIL  python3 cannot run (${py_version:-no output}): reinstall it, e.g. run 'brew install python'"
    failed=$((failed + 1))
  fi
  # brew
  total=$((total + 1))
  if command -v brew >/dev/null 2>&1; then
    echo "  OK    brew available"
  else
    echo "  FAIL  brew not found: install Homebrew from https://brew.sh"
    failed=$((failed + 1))
  fi
  # macOS (Darwin), by product version rather than kernel release
  total=$((total + 1))
  if [ "$(uname -s)" = "Darwin" ]; then
    echo "  OK    macOS $(sw_vers -productVersion)"
  else
    echo "  FAIL  needs macOS (Darwin): found $(uname -s)"
    failed=$((failed + 1))
  fi
  # Apple Silicon
  total=$((total + 1))
  if [ "$(uname -m)" = "arm64" ]; then
    echo "  OK    arm64 (Apple Silicon)"
  else
    echo "  FAIL  needs Apple Silicon (arm64): found $(uname -m)"
    failed=$((failed + 1))
  fi
  # Summary
  echo ""
  if [ "$failed" -eq 0 ]; then
    echo "All checks passed (${total}/${total})."
    return 0
  fi
  echo "FAILED ${failed}/${total} check(s). Fix the above and retry."
  return 1
}

# check_instance: INSTANCE is a name Lima accepts (ValidateInstName, Lima 1.2
# on; 1.1 checks the same characters and length, not the .yml/.yaml ending),
# the same check as install.sh's. Anything else would reach limactl as an
# option (--help) or a path.

check_instance() {
  local re='^[A-Za-z0-9]+([._-][A-Za-z0-9]+)*$'
  [[ "$INSTANCE" =~ $re && ${#INSTANCE} -le 76 && ! "$INSTANCE" =~ [.][Yy][Aa]?[Mm][Ll]$ ]] ||
    die "--instance (or HOMEFIELD_INSTANCE) must be a Lima instance name: letters and digits, with a single '.', '_' or '-' between them, at most 76 characters, not ending in .yml or .yaml; got: $INSTANCE"
}

# vm_status: prints the VM's status (Running, Stopped, ...), or nothing when
# there is no such VM. Returns 2 when Lima could not be asked, or lists the VM
# without a status. It lists every
# instance and picks its own: `limactl list NAME` exits 1 for a missing VM
# ("unmatched instances", Lima 2.2.0) as it does when Lima itself fails, so
# only a successful list can say "no VM".
vm_status() {
  local rows name status
  rows="$(limactl list --format '{{.Name}} {{.Status}}' 2>/dev/null)" || return 2
  while read -r name status; do
    if [ "$name" = "$INSTANCE" ]; then
      # Listed with no status: its config is broken (Lima warns and lists it
      # with an empty status). It exists, so it is not "no VM".
      [ -n "$status" ] || return 2
      echo "$status"
      return 0
    fi
  done <<<"$rows"
  return 0
}
# vm_lookup: vm_status into VM_STATUS (empty: no VM), for the commands that act
# on "no VM": create one, or report that there is none. A Lima that could not be
# asked ends the command (install would otherwise register a runner group and
# then fail to create a VM that exists). Not a $(...), so die ends the command.
VM_STATUS=""
vm_lookup() {
  VM_STATUS="$(vm_status)" || die "could not ask Lima about VM ${INSTANCE} (limactl list failed, or lists it without a status); stopping here"
}

# --workdir /: the host's working directory does not exist in the guest, which
# has no mounts. stdin is closed, or `limactl shell` would swallow whatever is
# typed ahead, such as a token meant for the prompt; guest_stdin is for the
# two calls that feed a token in on purpose.
guest() { limactl shell --workdir / "$INSTANCE" "$@" </dev/null; }
guest_stdin() { limactl shell --workdir / "$INSTANCE" "$@"; }

ensure_vm() {
  local cpus="$1" memory="$2" status
  vm_lookup
  status="$VM_STATUS"
  if [ -z "$status" ]; then
    log "creating VM ${INSTANCE}"
    local args=(--name="$INSTANCE" --mount-none --tty=false)
    [ -n "$cpus" ] && args+=(--cpus="$cpus")
    [ -n "$memory" ] && args+=(--memory="$memory")
    limactl create "${args[@]}" "$LIMA_YAML"
    status="Stopped"
  fi
  if [ "$status" != "Running" ]; then
    log "starting VM ${INSTANCE}"
    limactl start --tty=false "$INSTANCE"
  fi
}

# The VM is the isolation boundary, so nothing runs in it until it is shown to
# have no host mounts and no view of the Mac's home directories. A guest
# command that cannot run at all is reported as such: treating its empty
# output as "no mounts found" would misread a broken VM as a safe one.
verify_isolation() {
  local mounts
  # mount is run on its own: in a pipe its failure would be hidden, and grep
  # would count nothing in its empty output. grep -c exits 1 for a count of 0,
  # which is an answer; a status above 1 is not.
  # shellcheck disable=SC2016  # the guest's shell expands these, not this one
  if ! mounts="$(guest sh -c 'out="$(mount)" || exit 3; printf "%s\n" "$out" | grep -Ec "virtiofs|9p|sshfs|reverse-sshfs"; test $? -le 1')"; then
    die "could not run the isolation check in VM ${INSTANCE}; is it running? (see docs/runbook.md, Setup)"
  fi
  case "$mounts" in
    ''|*[!0-9]*) die "could not read the mount count from VM ${INSTANCE}; refusing to continue (see docs/runbook.md, Setup)" ;;
  esac
  [ "$mounts" = "0" ] || die "VM ${INSTANCE} has host mounts; refusing to continue (see docs/runbook.md, Setup)"
  local users=0
  guest_sees /Users || users=$?
  case "$users" in
    0) die "VM ${INSTANCE} can see /Users; refusing to continue" ;;
    1) ;;
    *) die "could not run the /Users check in VM ${INSTANCE}; refusing to continue (see docs/runbook.md, Setup)" ;;
  esac
  log "isolation verified: no host mounts"
}

# guest_sees PATH: like guest_has_file for any kind of path, without sudo:
# 0 if the guest can see it, 1 if not, 2 if the guest could not be asked.
guest_sees() {
  local answer
  # shellcheck disable=SC2016  # the guest's shell expands $1, not this one
  answer="$(guest sh -c 'if test -e "$1"; then echo yes; else echo no; fi' sh "$1")" || return 2
  case "$answer" in
    yes) return 0 ;;
    no) return 1 ;;
    *) return 2 ;;
  esac
}

# guest_has_file PATH: 0 if the file is there, 1 if the guest says it is not,
# 2 if the guest could not be asked (limactl or sudo failed, or the answer was
# neither). The test runs in the guest and prints its answer, so a failed call
# cannot pass for "no": `test -f` alone exits 1 for a missing file and for a
# `limactl shell` that never reached the guest. A caller that acts on "no"
# has to stop on 2.
guest_has_file() {
  local answer
  # shellcheck disable=SC2016  # the guest's shell expands $1, not this one
  answer="$(guest sudo sh -c 'if test -f "$1"; then echo yes; else echo no; fi' sh "$1")" || return 2
  case "$answer" in
    yes) return 0 ;;
    no) return 1 ;;
    *) return 2 ;;
  esac
}

# registered: 0 if the runner is registered, 1 if not, 2 if the VM could not be
# asked. Commands that act on the answer call is_registered instead.
registered() { guest_has_file "$RUNNER_HOME/.runner"; }
# is_registered: registered, for the commands that act on "no". A VM that could
# not be asked ends the command: read as "not registered", it would let
# uninstall delete the VM and leave the registration on GitHub, and let install
# register again, where --replace removes this VM's own registration.
is_registered() {
  local rc=0
  registered || rc=$?
  [ "$rc" -lt 2 ] || die "could not ask VM ${INSTANCE} whether its runner is registered; is it running? Try again when bin/homefield status answers"
  return "$rc"
}

# runner_on_github <url> <id>: 0 if GitHub lists a runner with the id at <url>,
# 1 if it lists the scope's runners and that id is not among them, 2 if it
# could not be asked (no gh, no admin access, no network), 3 if the call was
# killed after GH_TIMEOUT seconds (a black-holed network stalls the connect
# for ~75 s on macOS, and status owes its other lines no such wait, #103).
# GitHub removes a
# runner that has not connected for more than 14 days, and the VM's .runner
# stays (#76). Matched by id: another Mac can register the name again. Never
# prompts, status calls it.
runner_on_github() {
  local scope ids id rc=0
  [ -n "$2" ] && command -v gh >/dev/null || return 2
  scope="$(api_scope "$1" 2>/dev/null)" || return 2
  # The killed-by-signal case is told from a plain failure by the exit code
  # (128 + TERM): the timer below is the only thing that kills this gh. The
  # timer's own kill can race gh finishing a heartbeat earlier; both answers
  # mean "not checked", and only the status wording differs.
  local tmp pid timer
  tmp="$(mktemp)" || return 2
  gh api --hostname github.com --paginate "${scope}/actions/runners?per_page=100" --jq '.runners[].id' </dev/null >"$tmp" 2>/dev/null &
  pid=$!
  # >/dev/null on the timer matters: sleep inherits stdout, and a caller
  # that runs status inside $(...) would wait for the whole timeout before
  # substitution closes.
  ( sleep "$GH_TIMEOUT"; kill -TERM "$pid" 2>/dev/null ) </dev/null >/dev/null 2>&1 & timer=$!
  wait "$pid" || rc=$?
  kill "$timer" 2>/dev/null || true
  wait "$timer" 2>/dev/null || true
  ids="$(cat "$tmp")"
  rm -f "$tmp"
  [ "$rc" -le 128 ] || return 3
  [ "$rc" = 0 ] || return 2
  while read -r id; do
    [ "$id" != "$2" ] || return 0
  done <<<"$ids"
  return 1
}

# removed_recovery <url> <name>: how to register a runner GitHub removed again,
# under its old name. The label and group are not stored in the VM.
removed_recovery() {
  echo "bin/homefield uninstall --instance ${INSTANCE} --keep-vm, then bin/homefield install --instance ${INSTANCE} --url $1${2:+ --name $2}, with the --label and --group of the first install if they were not the defaults"
}

# job_running: 0 if a job is running, 1 if not, 2 if the guest could not be
# asked (the call failed, or pgrep did not run). `pgrep` alone exits 1 for "no
# job" and for a `limactl shell` that never reached the guest. The [R] keeps
# the pattern from matching this shell's own command line.
job_running() {
  local answer
  # shellcheck disable=SC2016  # the guest's shell expands these, not this one
  answer="$(guest sh -c 'pgrep -f "[R]unner.Worker" >/dev/null; case $? in 0) echo yes ;; 1) echo no ;; esac')" || return 2
  case "$answer" in
    yes) return 0 ;;
    no) return 1 ;;
    *) return 2 ;;
  esac
}
# is_job_running: job_running, for the commands that go on when it says "no".
# A guest that could not be asked ends the command, with --force too: --force
# overrides a job that is running, not a runner that cannot be reached.
is_job_running() {
  local rc=0
  job_running || rc=$?
  [ "$rc" -lt 2 ] || die "could not ask VM ${INSTANCE} whether a job is running; nothing was stopped. Try again when bin/homefield status answers"
  return "$rc"
}

# npm_state: whether the runner's bundled npm runs (#110), as with
# job_running: 0 ok, 1 broken, 2 the VM could not be asked. Verify only: the
# repair belongs to the job-started hook (vm/provision.sh), which relinks the
# externals symlinks a runner self-update flattens (actions/runner#2094)
# before every job. `cd /` keeps a project .npmrc out of the check.
npm_state() {
  local answer
  # shellcheck disable=SC2016  # the guest's shell expands these, not this one
  answer="$(guest sh -c 'for n in node20 node24; do d="/opt/actions-runner/externals/$n/bin"; [ -e "$d/npm" ] || continue; (cd / && "$d/node" "$d/npm" --version >/dev/null 2>&1) || { echo broken; exit 0; }; done; echo ok')" || return 2
  case "$answer" in
    ok) return 0 ;;
    broken) return 1 ;;
    *) return 2 ;;
  esac
}

# Maintenance (upgrade, uninstall) takes the runner offline first, straight
# after the idle check: a runner that is still listening can be handed a job
# at any moment, and apt restarting Docker or the service being uninstalled
# would then take that job down. If the command then fails, the runner is
# started again on the way out; a command that succeeds calls runner_back.
stopped_unit=""
stop_runner() {
  # No .service is a state of its own (provisioning never finished, or the
  # service was removed): nothing to stop. A guest that cannot be asked is not
  # that state, or the maintenance would go on with the runner listening.
  local has=0 unit
  guest_has_file "$RUNNER_HOME/.service" || has=$?
  case "$has" in
    0) ;;
    1) return 0 ;;
    *) die "could not ask VM ${INSTANCE} whether the runner has a service; nothing was stopped. Try again when bin/homefield status answers" ;;
  esac
  if ! unit="$(guest sudo cat "$RUNNER_HOME/.service")"; then
    die "could not read the runner's service name in VM ${INSTANCE}; nothing was stopped. Try again when bin/homefield status answers"
  fi
  # A file the guest answered for, with no name in it: no unit to stop.
  [ -n "$unit" ] || return 0
  # A name whose unit file is gone (an uninstall cut off before it deleted
  # .service) names nothing that runs. systemctl stop would fail with "not
  # loaded" and end the command before provisioning could repair it (#99).
  local load
  if ! load="$(guest systemctl show -p LoadState --value "$unit")"; then
    die "could not ask VM ${INSTANCE} whether ${unit} is installed; nothing was stopped. Try again when bin/homefield status answers"
  fi
  if [ "$load" = not-found ]; then
    log "${unit} is not installed; nothing to stop"
    return 0
  fi
  stopped_unit="$unit"
  trap restart_runner_on_failure EXIT
  log "stopping ${stopped_unit}: the runner takes no jobs until this finishes"
  guest sudo systemctl stop "$stopped_unit"
}
restart_runner_on_failure() {
  local rc=$?
  if [ "$rc" -ne 0 ] && [ -n "$stopped_unit" ]; then
    echo "homefield: failed; starting ${stopped_unit} again" >&2
    guest sudo systemctl start "$stopped_unit" ||
      echo "homefield: could not start ${stopped_unit}; check bin/homefield status" >&2
  fi
}
runner_back() {
  trap - EXIT
  stopped_unit=""
}

# Prints the named settings from the runner's config, one per line (empty for
# one that is missing): a name may contain spaces.
runner_setting() {
  guest sudo python3 -c 'import json,sys; d=json.load(open(sys.argv[1], encoding="utf-8-sig")); print(*(d.get(k, "") for k in sys.argv[2:]), sep="\n")' \
    "$RUNNER_HOME/.runner" "$@"
}

# ── Tokens ──────────────────────────────────────────────────────────────────
# api_scope <url>: the REST path of the registration scope.
api_scope() {
  local url="${1%/}"
  if [[ "$url" =~ ^https://github\.com/([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)$ ]]; then
    echo "repos/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
  elif [[ "$url" =~ ^https://github\.com/([A-Za-z0-9_.-]+)$ ]]; then
    echo "orgs/${BASH_REMATCH[1]}"
  else
    die "--url must be https://github.com/<org> or https://github.com/<owner>/<repo>, got: $1"
  fi
}

# runners_page <url>: the settings page listing the scope's runners. An
# organization's settings live under /organizations/<org>/.
runners_page() {
  local scope
  scope="$(api_scope "$1")" || exit 1
  case "$scope" in
    orgs/*) echo "https://github.com/organizations/${scope#orgs/}/settings/actions/runners" ;;
    *) echo "https://github.com/${scope#repos/}/settings/actions/runners" ;;
  esac
}

# The runner APIs of an organization need the admin:org scope, which gh's
# default login does not have. offer_scope_refresh asks once per run to add
# it, on a terminal; it succeeds when the caller should retry its gh call.
# Callers in $(...) do not pass the flag back to their parent, which is fine:
# the group step runs in the parent first, and get_token alone in uninstall.
scope_refresh_asked=0
offer_scope_refresh() {
  [ "$scope_refresh_asked" = 0 ] || return 1
  scope_refresh_asked=1
  [ -t 0 ] && command -v gh >/dev/null || return 1
  if [ -n "${GITHUB_TOKEN:-}${GH_TOKEN:-}" ]; then
    # gh uses that variable instead of its stored login, so adding a scope to
    # the stored login changes nothing for this command.
    echo "homefield: GITHUB_TOKEN or GH_TOKEN is set, and gh uses it instead of its stored login, so" >&2
    echo "homefield: 'gh auth refresh' would not help. Unset it, or use a token with admin:org." >&2
    return 1
  fi
  local answer
  read -rp "gh needs the admin:org scope. Run 'gh auth refresh -h github.com -s admin:org' now? [Y/n] " answer
  case "$answer" in [Nn]*) return 1 ;; esac
  # gh prints its one-time code on stdout; the caller may be in $(...).
  gh auth refresh -h github.com -s admin:org >&2
}

# get_token <registration|remove> <url>: prints the token. From gh when it can,
# else pasted; never echoed.
get_token() {
  local kind="$1" url="$2" scope out token=""
  scope="$(api_scope "$url")" || exit 1
  # On an error gh prints the error body to stdout, so only its exit status
  # says whether this is a token.
  if command -v gh >/dev/null; then
    if out="$(gh api -X POST "${scope}/actions/runners/${kind}-token" -q .token 2>/dev/null)"; then
      token="$out"
    elif [[ "$scope" == orgs/* ]] && offer_scope_refresh &&
      out="$(gh api -X POST "${scope}/actions/runners/${kind}-token" -q .token 2>/dev/null)"; then
      token="$out"
    fi
  fi
  if [ -z "$token" ]; then
    [ -t 0 ] || die "could not get a ${kind} token with gh, and no terminal to paste one"
    echo "homefield: could not get a ${kind} token with gh (needs org owner + admin:org, or repository admin)." >&2
    echo "homefield: get one from $(runners_page "$url")/new and paste only the token." >&2
    read -rsp "${kind} token: " token
    echo >&2
  fi
  [[ "$token" =~ ^[A-Za-z0-9_-]+$ ]] || die "that does not look like a ${kind} token"
  printf '%s' "$token"
}

# Personal accounts have no account-level runners: a user URL would fail at
# registration with a confusing error, so say so up front.
check_scope_owner() {
  local url="${1%/}" owner out type=""
  [[ "$url" =~ ^https://github\.com/([A-Za-z0-9_.-]+)$ ]] || return 0
  owner="${BASH_REMATCH[1]}"
  # gh when it works, else the public API with curl (no python3 needed: a
  # stock Mac only has the stub that offers to install it).
  if command -v gh >/dev/null && out="$(gh api "users/${owner}" -q .type 2>/dev/null)"; then
    type="$out"
  elif out="$(curl -fsS "https://api.github.com/users/${owner}" 2>/dev/null)"; then
    type="$(printf '%s\n' "$out" | sed -n 's/^ *"type": *"\([A-Za-z]*\)".*/\1/p' | head -1)"
  fi
  case "$type" in
    Organization) ;;
    User) die "${owner} is a personal account, which cannot have account-wide runners; use a repository URL (https://github.com/${owner}/<repo>)" ;;
    *) die "could not find ${owner} on GitHub (or reach api.github.com) to check that it is an organization" ;;
  esac
}

# validate_scope <url>: the URL's shape, and that an organization URL is one.
validate_scope() {
  api_scope "$1" >/dev/null
  check_scope_owner "$1"
}

# ask_url: prints the URL typed at the prompt. Needs a terminal; without one
# the URL has to come from --url.
ask_url() {
  local url
  [ -t 0 ] || die "install: --url is required for a new registration (no terminal to ask)"
  read -rp "GitHub organization or repository URL (https://github.com/<org> or https://github.com/<owner>/<repo>): " url
  [ -n "$url" ] || die "install: no URL given"
  printf '%s' "$url"
}

# prepare_registration: for cmd_install, whose url, group, name and replace
# it reads and sets (bash functions see their caller's locals). Asks for the
# URL if there is none, validates it, sorts out the runner group and the name.
prepare_registration() {
  [ -n "$url" ] || url="$(ask_url)" || exit 1
  validate_scope "$url"
  ensure_group "$url" "${group:-homefield-ci}"
  [ -n "$name" ] || name="$(default_name)" || exit 1
  check_name_free "$url" "$name" "$replace"
}

# ── Runner name ─────────────────────────────────────────────────────────────
# The guest's hostname, lima-<instance>, is the same on every Mac, so a second
# Mac registering under it would take the first one's registration (#52). The
# default is this Mac's local hostname plus the instance instead: unique per
# Mac on a network, and it says which machine a runner is on.

# default_name: prints <local hostname>-<instance>, lower case, with anything
# but letters, digits, '.', '_' and '-' replaced by '-'.
default_name() {
  local host
  host="$(scutil --get LocalHostName 2>/dev/null)" || host=""
  [ -n "$host" ] || die "install: could not read this Mac's name (scutil --get LocalHostName); pass --name"
  lower "${host}-${INSTANCE}" | tr -c 'a-z0-9._\n-' '-'
}

# check_name_free <url> <name> <replace>: refuses a name that is already
# registered in the scope, before anything is created. Registration would
# refuse it too (provision.sh never passes --replace), but only after the VM
# is built. Names are compared ignoring case. A runners list that cannot be
# read is not a reason to stop, except for --replace, which has to find the
# registration it removes.
#
# --replace removes the old registration (remove_taken_name, after token
# retrieval but before provisioning) rather than using config.sh's --replace,
# which keeps the old registration's runner group and ignores the one asked for
# (actions/runner#4091). Sets REPLACE_ID to the id to remove.
REPLACE_ID=""
check_name_free() {
  local url="$1" name="$2" replace="$3" scope rows n status id taken="" taken_id="" page
  scope="$(api_scope "$url")" || exit 1
  page="$(runners_page "$url")" || exit 1
  if ! command -v gh >/dev/null || ! rows="$(gh api --paginate "${scope}/actions/runners?per_page=100" \
    --jq '.runners[] | [.name, .status, (.id | tostring)] | @tsv' 2>/dev/null)"; then
    [ "$replace" != 1 ] || die "--replace needs gh to list the runners at ${url} (org owner + admin:org, or repository admin); remove ${name} at ${page} instead and run this again without --replace"
    log "could not list the runners at ${url} to check that ${name} is free; registration refuses it if it is not"
    return 0
  fi
  while IFS=$'\t' read -r n status id; do
    [ -n "$n" ] || continue
    if [ "$(lower "$n")" = "$(lower "$name")" ]; then
      taken="$status"
      taken_id="$id"
    fi
  done <<<"$rows"
  [ -n "$taken" ] || return 0
  if [ "$replace" = 1 ]; then
    if [ "$taken" = online ]; then
      echo "homefield: warning: ${name} is registered and online at ${url}; --replace removes its registration, and the runner that has it stops working" >&2
    else
      log "${name} is registered (${taken}) at ${url}; --replace removes that registration before registering"
    fi
    REPLACE_ID="$taken_id"
    return 0
  fi
  if [ "$taken" = online ]; then
    die "a runner named ${name} is already registered and online at ${url}, most likely on another machine; pick another name with --name (${page})"
  fi
  die "a runner named ${name} is already registered (${taken}) at ${url}. If it is this Mac's old registration, run this again with --replace; otherwise pick another name with --name, or remove it at ${page}"
}

# remove_taken_name <url> <name>: for --replace, removes the registration
# check_name_free found under the name, so this one registers fresh, in the
# group asked for. This follows token retrieval but precedes provisioning;
# a failure between removal and registration leaves the name unregistered.
remove_taken_name() {
  local url="$1" name="$2" scope
  [ -n "$REPLACE_ID" ] || return 0
  scope="$(api_scope "$url")" || exit 1
  log "removing the registration of ${name} (id ${REPLACE_ID}) at ${url}"
  gh api -X DELETE "${scope}/actions/runners/${REPLACE_ID}" >/dev/null ||
    die "could not remove ${name} at ${url}; remove it at $(runners_page "$url") and run this again without --replace"
  REPLACE_ID=""
}

# ── Runner group ────────────────────────────────────────────────────────────
# The group is what keeps an organization's other repositories off the runner
# (docs/runbook.md, "Runner group"), so install makes sure it exists before
# the runner joins it, instead of leaving that to a manual step.

# list_groups <org>: one line per runner group, tab separated: name,
# visibility, allows_public_repositories. Tabs, because a name may have spaces.
list_groups() {
  gh api --paginate "orgs/${1}/actions/runner-groups?per_page=100" \
    --jq '.runner_groups[] | [.name, .visibility, (.allows_public_repositories | tostring)] | @tsv' 2>/dev/null
}

# list_groups_ids <org>: like list_groups, with the group's id as a fourth
# column, for the calls that address a group by id.
list_groups_ids() {
  gh api --paginate "orgs/${1}/actions/runner-groups?per_page=100" \
    --jq '.runner_groups[] | [.name, .visibility, (.allows_public_repositories | tostring), (.id | tostring)] | @tsv' 2>/dev/null
}

# group_unchecked <group> <why>: the group could not be checked or created.
# Registering anyway would put the runner in a group nobody has looked at, or
# fail at the end, so ask first (default no); without a terminal, stop.
group_unchecked() {
  echo "homefield: could not check or create the runner group ${1}: ${2}" >&2
  echo "homefield: create it by hand (docs/runbook.md, \"Runner group\"): selected repositories, public repositories off." >&2
  [ -t 0 ] || die "stopping: the runner group ${1} is unchecked and there is no terminal to ask (if you created and checked it, pass --group-exists)"
  local answer
  read -rp "Continue without checking the group? [y/N] " answer
  case "$answer" in
    [Yy]*) ;;
    *) die "stopped: create the group ${1}, then run this again" ;;
  esac
}

# group_assumed <group> <why>: with --group-exists, a group gh cannot list is
# taken as there, and the closing message still says it is unchecked. Only for
# a group gh could not look at: a list that worked and lacks it is not
# overridden. Registration fails if the group is missing after all.
GROUP_EXISTS=0
group_assumed() {
  [ "$GROUP_EXISTS" = 1 ] || return 1
  log "runner group ${1}: not checked (${2}); going on because of --group-exists"
}

# token_hint: without a terminal offer_scope_refresh says nothing, so say here
# that gh may have a login with admin:org behind GITHUB_TOKEN or GH_TOKEN.
token_hint() {
  [ ! -t 0 ] && [ -n "${GITHUB_TOKEN:-}${GH_TOKEN:-}" ] || return 0
  echo "homefield: GITHUB_TOKEN or GH_TOKEN is set, and gh uses it instead of its stored login. If that login has admin:org, run this again with them empty for this one command: GITHUB_TOKEN= GH_TOKEN= homefield install ..." >&2
}

# lower <text>: in lower case (bash 3.2 has no ${var,,}).
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# What ensure_group found, for the closing message: "repo" (no groups),
# "default" (every repository in the org), "wide" (warned about), "narrow",
# "created" or "unchecked".
GROUP_STATE=""

# ensure_group <url> <group>: for an organization URL, finds the group by name
# and warns when it is wider than it should be, or creates it. A repository
# URL has no groups, and Default always exists. GitHub treats group names
# case-insensitively, so they are compared that way.
ensure_group() {
  local url="$1" group="${2:-homefield-ci}" scope org groups="" name vis pub found=0 why="" out
  scope="$(api_scope "$url")" || exit 1
  if [[ "$scope" != orgs/* ]]; then
    GROUP_STATE=repo
    return 0
  fi
  if [ "$(lower "$group")" = default ]; then
    GROUP_STATE=default
    return 0
  fi
  org="${scope#orgs/}"
  GROUP_STATE=unchecked

  if ! command -v gh >/dev/null; then
    group_assumed "$group" "gh is not installed" || group_unchecked "$group" "gh is not installed"
    return 0
  fi
  if ! groups="$(list_groups "$org")"; then
    if offer_scope_refresh; then
      groups="$(list_groups "$org")" || why="gh could not list the organization's runner groups, even after the scope refresh"
    else
      why="gh could not list the organization's runner groups (needs an org owner with the admin:org scope)"
    fi
    if [ -n "$why" ]; then
      group_assumed "$group" "$why" && return 0
      token_hint
      group_unchecked "$group" "$why"
      return 0
    fi
  fi
  # Listing groups needs admin:org, so the scope is there: a later failure
  # (the registration token) has another cause, and a refresh would not help.
  scope_refresh_asked=1

  while IFS=$'\t' read -r name vis pub; do
    [ "$(lower "$name")" = "$(lower "$group")" ] || continue
    found=1
    why=""
    case "$vis" in
      all) why="every repository in ${org} can use it" ;;
      private) why="every private repository in ${org} can use it" ;;
    esac
    [ "$pub" != true ] || why="${why:+${why}, and }public repositories can use it"
    if [ -n "$why" ]; then
      GROUP_STATE=wide
      echo "homefield: warning: runner group ${name} is wider than it should be: ${why}." >&2
      echo "homefield: narrow it to selected repositories with public ones off (docs/runbook.md, \"Runner group\")." >&2
    else
      GROUP_STATE=narrow
      log "runner group ${name} exists (selected repositories only, no public ones)"
    fi
  done <<<"$groups"
  [ "$found" = 0 ] || return 0

  [ "$GROUP_EXISTS" = 0 ] ||
    echo "homefield: warning: --group-exists, but gh listed the runner groups of ${org} and ${group} is not among them" >&2
  log "creating runner group ${group}: selected repositories, public repositories off"
  if ! out="$(gh api -X POST "orgs/${org}/actions/runner-groups" -f name="$group" -f visibility=selected \
    -F allows_public_repositories=false 2>&1)"; then
    # Only wording about the plan counts as a plan problem. A bare 403 or 422
    # can be SAML enforcement, a missing permission or a taken name, and the
    # plan advice (--group Default) would open the runner to every repository.
    case "$(lower "$out")" in
      *saml*)
        group_unchecked "$group" "the organization enforces SAML single sign-on and gh's token is not authorized for it (authorize it for SSO, or gh auth refresh): ${out}"
        ;;
      *plan* | *upgrade* | *"not available"*)
        echo "homefield: gh said: ${out}" >&2
        die "could not create runner group ${group}: custom runner groups need the GitHub Team plan or Enterprise. On the Free plan, pass --group Default (every repository in ${org} can then use the runner, so only do that if you trust them all) or use a repository URL (https://github.com/<owner>/<repo>)"
        ;;
      *)
        group_unchecked "$group" "gh said: ${out} (custom runner groups need the Team plan or Enterprise)"
        ;;
    esac
    return 0
  fi
  GROUP_STATE=created
  log "created runner group ${group}. No repository can use it yet: homefield adopt --repo <owner>/<repo> adds one (docs/adopting.md, step 5)"
}

# ── Waiting for the runner ──────────────────────────────────────────────────
# ONLINE_WAIT_TRIES / ONLINE_WAIT_INTERVAL / ONLINE_PROGRESS_CYCLES can be
# overridden by environment variables (tests run the wait with 3 tries and no
# interval); the defaults below are for real runs.
ONLINE_WAIT_TRIES=${ONLINE_WAIT_TRIES:-18}
ONLINE_WAIT_INTERVAL=${ONLINE_WAIT_INTERVAL:-5}
# Progress reports during the wait: one every 3 poll cycles (every 15 seconds),
# so a long wait is never silent and never looks hung. If the runner comes
# online sooner, no progress output is needed. A value below 1 would make the
# divide in the loop below fail, so a non-number or non-positive falls back.
ONLINE_PROGRESS_CYCLES=${ONLINE_PROGRESS_CYCLES:-3}
[ "$ONLINE_PROGRESS_CYCLES" -ge 1 ] 2>/dev/null || ONLINE_PROGRESS_CYCLES=3

# wait_online <url> <name> <group>: until the runner shows as online on
# GitHub, up to about 90 seconds. Never fails: it only reports, because the
# registration has already happened and GitHub can be slow to list it. The
# runners list carries the group's id but not its name, so the name is
# resolved against the runner-groups list; when that cannot be done, the
# report says what was observed instead of assuming the expected group.
wait_online() {
  local url="$1" name="$2" group="$3" scope rows="" n status labels grpid grp="" groups gid gname tries=0 page seen=""
  page="$(runners_page "$url")" || exit 1
  if [ -z "$name" ] || ! command -v gh >/dev/null; then
    log "check that the runner is online at ${page}"
    return 0
  fi
  scope="$(api_scope "$url")" || exit 1
  log "waiting for ${name} to show as online (up to $((ONLINE_WAIT_TRIES * ONLINE_WAIT_INTERVAL)) s)"
  while [ "$tries" -lt "$ONLINE_WAIT_TRIES" ]; do
    # Progress: the first 15 seconds give no feedback, then a message every
    # 15 seconds while the wait continues.
    if [ $((tries % ONLINE_PROGRESS_CYCLES)) -eq 0 ] && [ "$tries" -gt 0 ]; then
      log "waiting for ${name} (up to $((ONLINE_WAIT_TRIES * ONLINE_WAIT_INTERVAL)) s, waited $((tries * ONLINE_WAIT_INTERVAL)) s)"
    fi
    if ! rows="$(gh api --paginate "${scope}/actions/runners?per_page=100" \
      --jq '.runners[] | [.name, .status, (.labels | map(.name) | join(",")), .runner_group_id] | @tsv' 2>/dev/null)"; then
      log "could not read the runners list with gh; check that the runner is online at ${page}"
      return 0
    fi
    while IFS=$'\t' read -r n status labels grpid; do
      [ "$n" = "$name" ] || continue
      seen="$status"
      if [ "$status" = online ]; then
        if [[ "$scope" == orgs/* ]]; then
          if groups="$(gh api --paginate "${scope}/actions/runner-groups?per_page=100" \
            --jq '.runner_groups[] | [.id, .name] | @tsv' 2>/dev/null)"; then
            while IFS=$'\t' read -r gid gname; do
              [ "$gid" = "$grpid" ] && grp="$gname"
            done <<<"$groups"
          fi
          if [ -n "$grp" ]; then
            if [ "$grp" = "$group" ]; then
              log "${name} is online: labels ${labels}, group ${grp}"
            else
              log "${name} is online: labels ${labels}, group ${grp} (expected ${group})"
            fi
          elif [ -n "$grpid" ]; then
            log "${name} is online: labels ${labels}, group id ${grpid}"
          else
            log "${name} is online: labels ${labels}"
          fi
        else
          log "${name} is online: labels ${labels}"
        fi
        return 0
      fi
    done <<<"$rows"
    tries=$((tries + 1))
    [ "$tries" -ge "$ONLINE_WAIT_TRIES" ] || sleep "$ONLINE_WAIT_INTERVAL"
  done
  echo "homefield: warning: ${name} is not online after $((ONLINE_WAIT_TRIES * ONLINE_WAIT_INTERVAL)) s (${seen:-not listed yet}); check ${page} and bin/homefield status" >&2
  return 0
}

# ── Provisioning ────────────────────────────────────────────────────────────
# run_provision <stdin text> [VAR=value ...]
run_provision() {
  local input="$1"
  shift
  limactl copy "$PROVISION" "${INSTANCE}:${GUEST_PROVISION}"
  printf '%s' "$input" | guest_stdin sudo "$@" bash "$GUEST_PROVISION"
}

enable_autostart() {
  if limactl autostart enable "$INSTANCE" >/dev/null 2>&1 ||
    limactl start-at-login --enabled "$INSTANCE" >/dev/null 2>&1; then
    log "VM ${INSTANCE} starts at login"
  else
    log "could not enable autostart; see docs/runbook.md, Setup (Autostart)" >&2
  fi
}

# ── Commands ────────────────────────────────────────────────────────────────
cmd_install() {
  local url="" label="" name="" group="" packages="" packages_set=0 cpus="" memory="" autostart=1 replace=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --url) url="${2:?--url needs a value}"; shift 2 ;;
      --label) label="${2:?--label needs a value}"; shift 2 ;;
      --name) name="${2:?--name needs a value}"; shift 2 ;;
      --group) group="${2:?--group needs a value}"; shift 2 ;;
      --packages) packages="${2?--packages needs a value (may be empty)}"; packages_set=1; shift 2 ;;
      --cpus) cpus="${2:?--cpus needs a value}"; shift 2 ;;
      --memory) memory="${2:?--memory needs a value}"; shift 2 ;;
      --no-autostart) autostart=0; shift ;;
      --group-exists) GROUP_EXISTS=1; shift ;;
      --replace) replace=1; shift ;;
      *) die "install: unknown option $1 (see bin/homefield help)" ;;
    esac
  done
  # The readiness report comes first, before anything is created, and install
  # then gates on its own subset of it — macOS, arm64, Lima — which check_host
  # is: gh, python3 and brew are what the tool needs elsewhere (adopt, report,
  # the one-liner), and install itself can proceed without them.
  cmd_preflight || true
  check_host
  # Everything that can be checked is checked before anything is created: the
  # URL (asked for if it was not given), the organization, the runner group.
  # Whether the instance is registered is only known once its VM is up and
  # verified, but a VM that does not exist yet is certainly not registered, so
  # in that case it all happens first. With a VM already there, a URL that
  # was given is still validated before the VM is started, and the rest waits
  # for the answer to "registered?" (a registered instance is just upgraded).
  local prepared=0
  vm_lookup
  if [ -z "$VM_STATUS" ]; then
    prepare_registration
    prepared=1
  elif [ -n "$url" ]; then
    validate_scope "$url"
  fi
  ensure_vm "$cpus" "$memory"
  verify_isolation

  if is_registered; then
    log "${INSTANCE} is already registered; upgrading instead (registration settings are kept)"
    local args=()
    [ "$packages_set" = 1 ] && args+=(--packages "$packages")
    cmd_upgrade "${args[@]+"${args[@]}"}"
    return
  fi

  [ "$prepared" = 1 ] || prepare_registration
  local env=(RUNNER_URL="$url" RUNNER_NAME="$name")
  [ -n "$label" ] && env+=(RUNNER_LABEL="$label")
  [ -n "$group" ] && env+=(RUNNER_GROUP="$group")
  [ "$packages_set" = 1 ] && env+=(RUNNER_EXTRA_PACKAGES="$packages")

  local token
  token="$(get_token registration "$url")"
  remove_taken_name "$url" "$name"
  log "provisioning ${INSTANCE} and registering at ${url}"
  run_provision "RUNNER_TOKEN=${token}"$'\n' "${env[@]}"
  token=""
  [ "$autostart" = 1 ] && enable_autostart
  # The name the runner registered under, read back from its config.
  local registered_name=""
  registered_name="$(runner_setting agentName)" || registered_name=""
  wait_online "$url" "$registered_name" "${group:-homefield-ci}"
  echo
  echo "Registered. Next:"
  case "$GROUP_STATE" in
    narrow | created)
      echo "  - It is in the runner group ${group:-homefield-ci}, which admits only the"
      echo "    repositories added to it: homefield adopt --repo <owner>/<repo> adds one."
      ;;
    default)
      echo "  - It is in the Default group: every repository in the organization can"
      echo "    use it (docs/runbook.md, \"Runner group\")."
      ;;
    wide)
      echo "  - Narrow the runner group ${group:-homefield-ci} as warned above, then add"
      echo "    the repositories that should use it (docs/runbook.md, \"Runner group\")."
      ;;
    unchecked)
      echo "  - Check the runner group ${group:-homefield-ci} by hand: selected repositories,"
      echo "    public ones off (docs/runbook.md, \"Runner group\")."
      ;;
  esac
  cat <<EOF
  - Route jobs from a repository: docs/adopting.md, then
    homefield adopt --repo <owner>/<repo> (group access and the switch).
  - bin/homefield status   shows the runner at any time.
EOF
}

cmd_upgrade() {
  local packages="" packages_set=0 force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --packages) packages="${2?--packages needs a value (may be empty)}"; packages_set=1; shift 2 ;;
      --force) force=1; shift ;;
      *) die "upgrade: unknown option $1 (see bin/homefield help)" ;;
    esac
  done
  check_host
  vm_lookup
  [ -n "$VM_STATUS" ] || die "no VM ${INSTANCE}; run bin/homefield install"
  ensure_vm "" ""
  verify_isolation
  is_registered || die "${INSTANCE} is not registered; run bin/homefield install --url ..."
  # A registration GitHub removed would only fail at the end, when the runner
  # cannot start a session; one that cannot be checked goes ahead.
  local url="" id="" name="" on=0
  { read -r url || true; read -r id || true; read -r name || true; } < <(runner_setting gitHubUrl agentId agentName)
  runner_on_github "$url" "$id" || on=$?
  [ "$on" != 1 ] || die "GitHub no longer has ${INSTANCE}'s runner (id ${id}) at ${url}: it removes runners that have not connected for more than 14 days. Nothing was stopped. Register it again: $(removed_recovery "$url" "$name")"
  # An upgrade can restart Docker (apt) or the runner (a new binary), which
  # would take down a running job.
  if is_job_running && [ "$force" != 1 ]; then
    die "a job is running on ${INSTANCE}; try again when it is idle, or pass --force"
  fi
  stop_runner
  local env=()
  [ "$packages_set" = 1 ] && env+=(RUNNER_EXTRA_PACKAGES="$packages")
  log "upgrading ${INSTANCE}"
  # provision.sh starts the service again at the end, and waits until it is
  # listening for jobs.
  run_provision "" "${env[@]+"${env[@]}"}"
  runner_back
}

cmd_status() {
  [ $# -eq 0 ] || die "status takes no options besides --instance"
  command -v limactl >/dev/null || die "Lima is not installed"
  local status
  if ! status="$(vm_status)"; then
    echo "VM ${INSTANCE}: unknown (could not ask Lima)"
    return 1
  fi
  if [ -z "$status" ]; then
    echo "VM ${INSTANCE}: not created"
    return
  fi
  echo "VM ${INSTANCE}: ${status}"
  [ "$status" = "Running" ] || return 0
  local reg=0
  registered || reg=$?
  if [ "$reg" -ge 2 ]; then
    echo "runner: unknown (could not ask the VM)"
    return 1
  fi
  if [ "$reg" = 1 ]; then
    echo "runner: not registered"
    return
  fi
  # A read at end of input fails, and under `set -e` that ends the command:
  # fewer than three lines must reach the check below, not stop here.
  local name url id svc removed=0 on=0
  { read -r name || true; read -r url || true; read -r id || true; } < <(runner_setting agentName gitHubUrl agentId)
  if [ -n "$name" ] && [ -n "$url" ]; then
    echo "runner: ${name}, registered at ${url}"
    runner_on_github "$url" "$id" || on=$?
    case "$on" in
      0) echo "github: listed" ;;
      1)
        echo "github: NOT listed: GitHub removes runners that have not connected for more than 14 days."
        echo "  Register it again: $(removed_recovery "$url" "$name")"
        removed=1
        ;;
      3)
        echo "github: not checked (timed out after ${GH_TIMEOUT}s; the network may be down)"
        ;;
      *)
        if [ -n "$id" ]; then
          echo "github: not checked (needs gh with admin access to ${url})"
        else
          echo "github: not checked (no runner id in the VM's settings)"
        fi
        ;;
    esac
  else
    # The registration exists (.runner is there) but its details could not be
    # read just now; the rest of the report still stands on its own.
    echo "runner: registered, but its details could not be read"
  fi
  svc="$(guest sudo cat "$RUNNER_HOME/.service" 2>/dev/null || true)"
  if [ -n "$svc" ] && guest systemctl is-active --quiet "$svc"; then
    echo "service: running"
  else
    echo "service: NOT running (${svc:-no service installed})"
  fi
  local job=0 unknown=0
  job_running || job=$?
  case "$job" in
    0) echo "job: running" ;;
    1) echo "job: idle" ;;
    *) echo "job: unknown (could not ask the VM)"; unknown=1 ;;
  esac
  echo "runner version: $(guest sudo cat "$RUNNER_HOME/.provisioned-version" 2>/dev/null || echo unknown)"
  local npm=0
  npm_state || npm=$?
  case "$npm" in
    0) echo "npm: ok" ;;
    1)
      echo "npm: BROKEN (a runner self-update can flatten the externals symlinks; docs/runbook.md, \"Runner updates\")"
      unknown=1
      ;;
    *) echo "npm: unknown (could not ask the VM)"; unknown=1 ;;
  esac
  echo "extra packages: $(guest sh -c 'cat /etc/homefield/extra-packages 2>/dev/null | tr "\n" " "')"
  [ -n "$url" ] && echo "labels: see $(runners_page "$url") (not stored in the VM)"
  [ "$removed" = 0 ] || return 1
  return "$unknown"
}

# deregister_script: what uninstall runs in the guest, as root, with the remove
# token on its stdin. config.sh refuses to remove a runner whose service is
# installed, so the service goes first, and if anything after that fails (svc.sh
# uninstall partway through, or GitHub refusing the removal: a rejected token,
# a network failure) the runner is still registered and has to get its service
# back. provision.sh's ensure-service does that and starts it (#99): this
# release's copy, put in the guest by cmd_uninstall, so a VM provisioned by an
# older one gets it too. If that fails as well, the runner is registered with
# no service, and `homefield install` sets the service up again.
#
# deregister_script local: for a runner GitHub no longer has (#76), removes
# only the VM's copy of the registration (`config.sh remove --local`, which
# asks GitHub nothing), with an empty line for the token.
deregister_script() {
  # shellcheck disable=SC2016  # the guest's shell expands these, not this one
  local script='cd @HOME@ && read -r t && s=0 && { [ ! -f .service ] || s=1; } && { [ "$s" = 0 ] || ./svc.sh uninstall || { rc=$?; bash @PROVISION@ ensure-service --start; exit "$rc"; }; } && { ACTIONS_RUNNER_INPUT_TOKEN="$t" sudo --preserve-env=ACTIONS_RUNNER_INPUT_TOKEN -u runner ./config.sh remove@LOCAL@ || { rc=$?; [ "$s" = 0 ] || bash @PROVISION@ ensure-service --start; exit "$rc"; }; }'
  local flag=""
  [ "${1:-}" != local ] || flag=" --local"
  script="${script//@HOME@/$RUNNER_HOME}"
  script="${script//@LOCAL@/$flag}"
  printf '%s' "${script//@PROVISION@/$GUEST_PROVISION}"
}

cmd_uninstall() {
  local keep_vm=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --keep-vm) keep_vm=1; shift ;;
      *) die "uninstall: unknown option $1 (see bin/homefield help)" ;;
    esac
  done
  check_host
  local status
  vm_lookup
  status="$VM_STATUS"
  [ -n "$status" ] || die "no VM ${INSTANCE}"
  [ "$status" = "Running" ] || limactl start --tty=false "$INSTANCE"
  if is_registered; then
    is_job_running && die "a job is running on ${INSTANCE}; uninstall when it is idle"
    local url="" id="" token on=0
    { read -r url || true; read -r id || true; } < <(runner_setting gitHubUrl agentId)
    [ -n "$url" ] || die "could not read the runner's registration in VM ${INSTANCE}; nothing was changed"
    runner_on_github "$url" "$id" || on=$?
    echo "homefield: switch every repository that routes to this runner to hosted first:" >&2
    echo "homefield:   gh variable set CI_RUNNER --repo <owner>/<repo> --body hosted" >&2
    # The restore deregister_script falls back on, copied in while nothing
    # has changed yet.
    limactl copy "$PROVISION" "${INSTANCE}:${GUEST_PROVISION}" ||
      die "could not copy provision.sh into VM ${INSTANCE}; nothing was changed"
    # Offline before the token is fetched or typed, which can take a while.
    stop_runner
    if [ "$on" = 1 ]; then
      # A full removal would ask GitHub to delete a runner it does not have.
      log "GitHub no longer has this runner (id ${id}) at ${url}; removing its registration from the VM only"
      printf '\n' | guest_stdin sudo sh -c "$(deregister_script local)"
    else
      token="$(get_token remove "$url")"
      log "deregistering from ${url}"
      printf '%s\n' "$token" | guest_stdin sudo sh -c "$(deregister_script)"
      token=""
    fi
    runner_back
  else
    log "${INSTANCE} is not registered; nothing to deregister"
  fi
  if [ "$keep_vm" = 1 ]; then
    log "kept VM ${INSTANCE}"
    return
  fi
  limactl autostart disable "$INSTANCE" >/dev/null 2>&1 || limactl start-at-login --enabled=false "$INSTANCE" >/dev/null 2>&1 || true
  limactl stop --force "$INSTANCE" >/dev/null 2>&1 || true
  limactl delete --force "$INSTANCE"
  log "deleted VM ${INSTANCE}"
}

# stuck_runs <owner/repo> <label>: ids of the repository's active runs that
# have a job still queued for a runner with the label: the jobs that keep
# waiting after a switch to hosted, because runs-on was decided when they
# were queued.
stuck_runs() {
  local repo="$1" label="$2" status ids id waiting
  label="$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')"
  # --paginate: after a long outage there can be more than one page of
  # active runs, or of jobs in a run. With --paginate, --jq runs per page,
  # so both filters emit one line per match and a match on any page counts.
  for status in queued in_progress; do
    ids="$(gh api --paginate "repos/${repo}/actions/runs?status=${status}&per_page=100" --jq '.workflow_runs[].id')" || exit 1
    for id in $ids; do
      waiting="$(gh api --paginate "repos/${repo}/actions/runs/${id}/jobs?per_page=100" \
        --jq ".jobs[] | select(.status == \"queued\" and ((.labels | map(ascii_downcase)) | index(\"${label}\"))) | .id")" || exit 1
      [ -n "$waiting" ] && echo "$id"
    done
  done
  return 0
}

cmd_route() {
  local target="${1:-}" label="homefield-ci" dry=0 repos=() repo current stuck id status tries
  [ $# -gt 0 ] && shift
  case "$target" in
    hosted | local) ;;
    *) die "route: say where to: bin/homefield route <hosted|local> --repo <owner>/<repo>" ;;
  esac
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repos+=("${2:?--repo needs a value}"); shift 2 ;;
      --label) label="${2:?--label needs a value}"; shift 2 ;;
      --dry-run) dry=1; shift ;;
      *) die "route: unknown option $1 (see bin/homefield help)" ;;
    esac
  done
  [ "${#repos[@]}" -gt 0 ] || die "route: --repo <owner>/<repo> is required"
  [[ "$label" =~ ^[A-Za-z0-9._-]+$ ]] || die "route: --label must be one label"
  command -v gh >/dev/null || die "route needs gh (https://cli.github.com)"

  for repo in "${repos[@]}"; do
    [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "route: --repo must be <owner>/<repo>, got: $repo"
    current="$(gh variable get CI_RUNNER --repo "$repo" 2>/dev/null || echo "(unset)")"
    if [ "$dry" = 1 ]; then
      log "${repo}: CI_RUNNER ${current} -> ${target} (dry run)"
    else
      gh variable set CI_RUNNER --repo "$repo" --body "$target" >/dev/null
      log "${repo}: CI_RUNNER ${current} -> ${target}"
    fi
    [ "$target" = hosted ] || continue

    # runs-on was fixed when these jobs were queued, so they wait for the
    # local runner whatever the variable says now. Cancel and re-run them;
    # the re-run is routed afresh, to hosted.
    # A failed lookup must not read as "nothing stuck".
    stuck="$(stuck_runs "$repo" "$label")" || die "${repo}: could not list its runs with gh"
    for id in $stuck; do
      if [ "$dry" = 1 ]; then
        log "${repo}: run ${id} has jobs waiting for ${label}; would cancel and re-run it"
        continue
      fi
      log "${repo}: run ${id} has jobs waiting for ${label}; cancelling and re-running it"
      gh run cancel "$id" --repo "$repo" >/dev/null
      # Up to a minute for the cancel to land; a re-run is refused before.
      # A shell counter, so nothing outside bash can make the wait vanish.
      status=""
      tries=0
      while [ "$tries" -lt 30 ]; do
        status="$(gh run view "$id" --repo "$repo" --json status --jq .status)" || exit 1
        [ "$status" = completed ] && break
        sleep 2
        tries=$((tries + 1))
      done
      if [ "$status" != completed ]; then
        log "${repo}: run ${id} is still ${status} after a minute; re-run it yourself: gh run rerun ${id} --repo ${repo}" >&2
        continue
      fi
      gh run rerun "$id" --repo "$repo" >/dev/null
      log "${repo}: run ${id} re-run"
    done
  done
}

# ── adopt ───────────────────────────────────────────────────────────────────
# Everything docs/adopting.md asks for that is not a workflow edit: a check that
# the routing is merged, the runner group's access list, and the switch. The
# group and the switch both wait for the routing: a repository that can reach
# the runner before its jobs carry the guarded expression has nothing keeping
# the runner to pull requests from its own branches.

# Set by the steps below, for the ones after them and the summary.
ADOPT_TMP=""
ADOPT_REPO_ID=""
ADOPT_BRANCH=""
ADOPT_OWNER_TYPE=""
ADOPT_GROUP_OUTCOME=""
ADOPT_SWITCH_OUTCOME=""
ADOPT_READY=0
ADOPT_REASONS=""
ADOPT_NOTES=""
ADOPT_LABEL=""
# The label of the first routing guard that passes its check, when
# adopt did not get --label: a passing guard says which label the repository
# actually routes on, and that is the one to advise with.
ADOPT_LABEL_OK=""
ADOPT_GUARDS=0
ADOPT_ROUTED=""
ADOPT_WORKFLOWS=0

adopt_warn() { echo "homefield: warning: $*" >&2; }

# adopt_repository <owner/repo>: sets ADOPT_REPO_ID, ADOPT_BRANCH and
# ADOPT_OWNER_TYPE. Only private repositories may reach the runner.
adopt_repository() {
  local repo="$1" info private
  if ! info="$(gh api "repos/${repo}" --jq '[.private, .id, .default_branch, .owner.type] | @tsv' 2>/dev/null)"; then
    die "adopt: could not read ${repo} with gh: it does not exist, or this gh login cannot see it"
  fi
  IFS=$'\t' read -r private ADOPT_REPO_ID ADOPT_BRANCH ADOPT_OWNER_TYPE <<<"$info"
  case "$private" in
    true) ;;
    false) die "adopt: ${repo} is public. The runner is for private repositories only: a pull request runs the workflow files from its own branch, so anyone who can open one could run code on the VM (README, \"Security model\")" ;;
    *) die "adopt: gh gave an answer for ${repo} that this tool cannot read: ${info}" ;;
  esac
  [[ -n "$ADOPT_REPO_ID" && -n "$ADOPT_BRANCH" ]] || die "adopt: gh gave an answer for ${repo} that this tool cannot read: ${info}"
  log "repository: ${repo} is private (default branch ${ADOPT_BRANCH})"
}

# adopt_group_access <owner/repo> <group> <dry>: makes sure the runner group
# admits the repository, but only writes to it (the PUT) when the routing is
# ready (ADOPT_READY): group access is what lets a repository's jobs reach the
# runner, so it must not come before the routing that keeps them to its own
# pull requests. When the routing is not ready this still reads the group, to
# say whether the repository is already in it. Not being able to check is a
# warning, not an error: group access is an organization-admin matter that the
# person running this may not be, and the rest of the checks are still worth
# having. A group that allows public repositories is a warning too, and goes on
# into the outcome line: whatever else it says, the group is not the boundary
# the docs describe.
adopt_group_access() {
  local repo="$1" group="$2" dry="$3" org="${1%%/*}" rows="" listed=0 name vis pub gid
  local found="" members byhand="" widen=""
  [ "$ADOPT_READY" = 0 ] || byhand="; add ${repo} by hand (docs/adopting.md step 5)"
  if [ "$ADOPT_OWNER_TYPE" != Organization ]; then
    ADOPT_GROUP_OUTCOME="none needed (${org} is a personal account)"
    log "runner group: skipped, ${org} is a personal account and has no runner groups"
    return 0
  fi
  if [ "$(lower "$group")" = default ]; then
    ADOPT_GROUP_OUTCOME="none needed (Default group)"
    log "runner group: skipped, the Default group is open to every repository in ${org}"
    return 0
  fi
  if rows="$(list_groups_ids "$org")"; then
    listed=1
  elif offer_scope_refresh && rows="$(list_groups_ids "$org")"; then
    listed=1
  fi
  if [ "$listed" = 0 ]; then
    ADOPT_GROUP_OUTCOME="not checked"
    adopt_warn "could not check runner group access${byhand}"
    return 0
  fi
  while IFS=$'\t' read -r name vis pub gid; do
    [ -n "$name" ] || continue
    [ "$(lower "$name")" = "$(lower "$group")" ] || continue
    found="$name"
    break
  done <<<"$rows"
  if [ -z "$found" ]; then
    ADOPT_GROUP_OUTCOME="none needed (no group ${group})"
    log "runner group: ${org} has no group ${group}; the runner may be repository-scoped or in another group, so nothing was changed"
    return 0
  fi
  [ "$pub" != true ] || widen=", but the group allows public repositories"
  if [ "$vis" != selected ]; then
    ADOPT_GROUP_OUTCOME="already open (${vis})${widen}"
    adopt_warn "runner group ${found} is open to ${vis} repositories in ${org}${widen:+ and allows public ones}, so ${repo} already has access and nothing was added; narrow it to selected repositories with public ones off (docs/runbook.md, \"Runner group\")"
    return 0
  fi
  if [ -n "$widen" ]; then
    adopt_warn "runner group ${found} allows public repositories. ${repo} is private, but anyone who can add a public repository to the group lets that repository's pull requests run their own workflow files on the runner, and the README's security model rests on there being none. The group stays that way after this adoption; turn off Allow public repositories for it (docs/runbook.md, \"Runner group\")"
  fi
  if ! members="$(gh api --paginate "orgs/${org}/actions/runner-groups/${gid}/repositories?per_page=100" --jq '.repositories[].id' 2>/dev/null)"; then
    ADOPT_GROUP_OUTCOME="not checked${widen}"
    adopt_warn "could not read the repositories of runner group ${found}${byhand}"
    return 0
  fi
  if printf '%s\n' "$members" | grep -qx "$ADOPT_REPO_ID"; then
    ADOPT_GROUP_OUTCOME="already a member${widen}"
    log "runner group: ${repo} already has access to ${found}"
    if [ "$ADOPT_READY" = 0 ]; then
      adopt_warn "${repo} is already in runner group ${found}, so its workflows can already send jobs to the runner although its routing is not ready; take it out of the group until the routing is merged (docs/runbook.md, \"Runner group\")"
    fi
  elif [ "$ADOPT_READY" = 0 ]; then
    ADOPT_GROUP_OUTCOME="not added (the routing is not ready)"
    log "runner group: not added, because the routing is not ready"
  elif [ "$dry" = 1 ]; then
    ADOPT_GROUP_OUTCOME="would be added (dry run)${widen}"
    log "runner group: would add ${repo} to ${found} (dry run)"
  else
    gh api -X PUT "orgs/${org}/actions/runner-groups/${gid}/repositories/${ADOPT_REPO_ID}" >/dev/null ||
      die "adopt: could not add ${repo} to runner group ${found}; add it by hand (docs/adopting.md step 5)"
    ADOPT_GROUP_OUTCOME="added${widen}"
    log "runner group: added ${repo} to ${found}"
  fi
}

# adopt_fetch_workflows <owner/repo> <branch> <dir>: the repository's
# .github/workflows at the branch, into dir; sets ADOPT_WORKFLOWS to how many.
# A repository without the directory has none, which is not an error here.
adopt_fetch_workflows() {
  local repo="$1" branch="$2" dir="$3" names name enc
  mkdir -p "$dir"
  ADOPT_WORKFLOWS=0
  if ! names="$(gh api -X GET "repos/${repo}/contents/.github/workflows" -f ref="$branch" \
    --jq '.[] | select(.type == "file") | .name' 2>"$ADOPT_TMP/err")"; then
    if grep -q 404 "$ADOPT_TMP/err"; then
      names=""
    else
      die "adopt: could not list .github/workflows in ${repo} with gh: $(head -1 "$ADOPT_TMP/err")"
    fi
  fi
  while IFS= read -r name; do
    case "$name" in
      */* | "") continue ;;
      *.yml | *.yaml) ;;
      *) continue ;;
    esac
    # A name may have spaces or other characters a URL path cannot carry.
    enc="$(python3 -I "$ROOT/tools/adopt.py" quote "$name" </dev/null)" || exit 1
    gh api -X GET "repos/${repo}/contents/.github/workflows/${enc}" -f ref="$branch" \
      -H 'Accept: application/vnd.github.raw' >"$dir/$name" 2>"$ADOPT_TMP/err" </dev/null ||
      die "adopt: could not download .github/workflows/${name} from ${repo}: $(head -1 "$ADOPT_TMP/err")"
    ADOPT_WORKFLOWS=$((ADOPT_WORKFLOWS + 1))
  done <<<"$names"
}

# adopt_reason <text>: one reason the routing is not ready.
adopt_reason() {
  ADOPT_READY=0
  ADOPT_REASONS="${ADOPT_REASONS}  - $1"$'\n'
}

# adopt_note <text>: one thing to check about the guard, once.
adopt_note() {
  case $'\n'"$ADOPT_NOTES" in
    *$'\n'"$1"$'\n'*) ;;
    *) ADOPT_NOTES="${ADOPT_NOTES}$1"$'\n' ;;
  esac
}

# adopt_each <command> <items>: runs the command on each of the items, which
# tools/adopt.py joins with ";" ("-" is none).
adopt_each() {
  local cmd="$1" rest="$2" item
  [ "$rest" != - ] || return 0
  while [ -n "$rest" ]; do
    item="${rest%%;*}"
    if [ "$item" = "$rest" ]; then rest=""; else rest="${rest#*;}"; fi
    [ -z "$item" ] || "$cmd" "$item"
  done
}

# adopt_events_key <events>: the events in canonical order, comma-separated,
# so two spellings of the same set compare equal (the order of the list and
# the separators do not matter to routing_guard.py). Names it does not know
# are dropped; the guard check reports those.
adopt_events_key() {
  local padded e key=""
  padded=" $(printf '%s' "$1" | tr ',\n\t' '   ') "
  for e in pull_request push workflow_dispatch schedule; do
    case "$padded" in
      *" $e "*) key="${key:+${key},}${e}" ;;
    esac
  done
  printf '%s' "$key"
}

# adopt_routing_check <dir> <label> <label_given>: sets ADOPT_READY (1 when a
# usable routing-guard step is there, passes, and at least one job is routed),
# ADOPT_REASONS (why not), ADOPT_LABEL, ADOPT_EVENTS, ADOPT_DEPENDABOT,
# ADOPT_FALLBACK and ADOPT_ROUTED. The workflows' own guard says which label,
# options and jobs to expect; --events, --dependabot and --fallback arrive as
# ADOPT_FLAG_EVENTS, ADOPT_FLAG_DEPENDABOT and ADOPT_FLAG_FALLBACK (empty when
# not given) and are held to the guard the way --label is. The guard's arch is
# read too, and refused unless arm64: adopt sets up the arm64 VM, and there is
# no flag to change that (#21 is the x86-64 future). The checks are routing_guard.py,
# the same script the guard runs in CI, with the step's own arch, so what they
# report is what CI runs. A usable step is the action pinned to
# this copy's release or a commit, in a workflow that runs on pull requests
# (tools/adopt.py says which are).
adopt_routing_check() {
  local dir="$1" label="$2" label_given="$3" rows where gstatus glabel gblocks gwarns gjobs out rc lines
  local gevents gdependabot gfallback garch gmatch opts
  local candidates=0 deferred="" routed routedjob
  ADOPT_READY=1
  ADOPT_REASONS=""
  ADOPT_NOTES=""
    ADOPT_LABEL="$label"
  ADOPT_LABEL_OK=""
  ADOPT_EVENTS="${ADOPT_FLAG_EVENTS:-pull_request}"
  ADOPT_DEPENDABOT="${ADOPT_FLAG_DEPENDABOT:-hosted}"
  ADOPT_FALLBACK="${ADOPT_FLAG_FALLBACK:-ubuntu-latest}"
  ADOPT_GUARDS=0
  ADOPT_ROUTED=""
  rows="$(python3 -I "$ROOT/tools/adopt.py" guards "$dir")" || die "adopt: could not read the downloaded workflows"
  while IFS=$'\t' read -r where gstatus glabel gblocks gwarns gevents gdependabot gfallback garch gjobs; do
    [ -n "$where" ] || continue
    candidates=$((candidates + 1))
    case "$gstatus" in
      source)
        adopt_each adopt_reason "$gblocks"
        continue
        ;;
      blocked)
        # Only a reason when no step is usable: a leftover that cannot run is
        # not a guard, and does no harm next to one that can.
        [ "$gblocks" = - ] || deferred="${deferred:+${deferred};}${gblocks}"
        continue
        ;;
    esac
    if [ "$ADOPT_GUARDS" = 0 ]; then
      [ "$label_given" = 1 ] || ADOPT_LABEL="$glabel"
      [ -n "$ADOPT_FLAG_EVENTS" ] || ADOPT_EVENTS="$gevents"
      [ -n "$ADOPT_FLAG_DEPENDABOT" ] || ADOPT_DEPENDABOT="$gdependabot"
      [ -n "$ADOPT_FLAG_FALLBACK" ] || ADOPT_FALLBACK="$gfallback"
    fi
    ADOPT_GUARDS=$((ADOPT_GUARDS + 1))
    adopt_each adopt_note "$gwarns"
    gmatch=1
    if [ "$label_given" = 1 ] && [ "$glabel" != "$label" ]; then
      gmatch=0
      adopt_reason "the routing-guard step at ${where} uses label ${glabel}, but --label is ${label}"
    fi
    if [ -n "$ADOPT_FLAG_EVENTS" ] && [ "$(adopt_events_key "$gevents")" != "$(adopt_events_key "$ADOPT_FLAG_EVENTS")" ]; then
      gmatch=0
      adopt_reason "the routing-guard step at ${where} uses events ${gevents}, but --events is ${ADOPT_FLAG_EVENTS}"
    fi
    if [ -n "$ADOPT_FLAG_DEPENDABOT" ] && [ "$gdependabot" != "$ADOPT_FLAG_DEPENDABOT" ]; then
      gmatch=0
      adopt_reason "the routing-guard step at ${where} uses dependabot ${gdependabot}, but --dependabot is ${ADOPT_FLAG_DEPENDABOT}"
    fi
    if [ -n "$ADOPT_FLAG_FALLBACK" ] && [ "$gfallback" != "$ADOPT_FLAG_FALLBACK" ]; then
      gmatch=0
      adopt_reason "the routing-guard step at ${where} uses fallback ${gfallback}, but --fallback is ${ADOPT_FLAG_FALLBACK}"
    fi
    if [ "$garch" != arm64 ]; then
      gmatch=0
      adopt_reason "the routing-guard step at ${where} uses arch ${garch}, but adopt sets up an arm64 VM; a guard step for another architecture routes its jobs to a runner this Mac does not have (docs/adopting.md, step 3)"
    fi
    opts=(--label "$glabel" --events "$gevents" --dependabot "$gdependabot" --fallback "$gfallback" --arch "$garch")
    # Collect the jobs routed under this guard's label and options. A
    # repository can carry several routing-guard steps; jobs routed under any
    # of them count, not only the first guard's — unless a flag picked a
    # value, in which case only steps carrying it speak for it and the others
    # are already reported as a mismatch above.
    if [ "$gmatch" = 1 ]; then
      # A guard whose own options the script refuses fails here too: the
      # check below reports that, so an empty list is right for now.
      routed="$(python3 -I "$ROOT/routing-guard/routing_guard.py" --workflows-dir "$dir" "${opts[@]}" --list 2>/dev/null)" || routed=""
      while IFS= read -r routedjob; do
        [ -n "$routedjob" ] || continue
        case $'\n'"$ADOPT_ROUTED"$'\n' in
          *"$'\n'${routedjob}"$'\n'*) ;;
          *) ADOPT_ROUTED="${ADOPT_ROUTED:+${ADOPT_ROUTED}$'\n'}${routedjob}" ;;
        esac
      done <<<"$routed"
    fi
    rc=0
    out="$(python3 -I "$ROOT/routing-guard/routing_guard.py" --workflows-dir "$dir" "${opts[@]}" --jobs "$gjobs" 2>&1)" || rc=$?
    if [ "$rc" -eq 0 ]; then
      # The first guard that passes and agrees with the flags names the label
      # and options; they equal the flags' wherever one was given.
      if [ "$gmatch" = 1 ] && [ -z "$ADOPT_LABEL_OK" ]; then
        ADOPT_LABEL_OK="$glabel"
        ADOPT_OK_EVENTS="$gevents"
        ADOPT_OK_DEPENDABOT="$gdependabot"
        ADOPT_OK_FALLBACK="$gfallback"
      fi
      continue
    fi
    # The failure lines only: no colours, no passes, no header or totals.
    lines="$(printf '%s\n' "$out" | sed $'s/\033\\[[0-9;]*m//g' |
      grep -v -e PASS -e '^self-hosted runner routing' -e ' passed, ' -e '^$' || true)"
    adopt_reason "the routing-guard step at ${where} would fail:"
    ADOPT_REASONS="${ADOPT_REASONS}$(printf '%s\n' "$lines" | sed 's/^ */      /')"$'\n'
  done <<<"$rows"
  if [ "$ADOPT_GUARDS" = 0 ]; then
    adopt_each adopt_reason "${deferred:--}"
    if [ "$candidates" = 0 ]; then
      adopt_reason "no routing-guard step in .github/workflows (docs/adopting.md, step 3)"
    else
      adopt_reason "no routing-guard step that runs on pull requests (docs/adopting.md, step 3)"
    fi
    # No guard to say which label applies; look with the expected one, as before.
    # The options were checked above, so a failure here is the script not
    # running, not "no jobs": an empty list would hide it.
    ADOPT_ROUTED="$(python3 -I "$ROOT/routing-guard/routing_guard.py" --workflows-dir "$dir" --label "$ADOPT_LABEL" \
      --events "$ADOPT_EVENTS" --dependabot "$ADOPT_DEPENDABOT" --fallback "$ADOPT_FALLBACK" --list 2>/dev/null)" ||
      die "adopt: routing_guard.py could not list the routed jobs; run it by hand on the workflows to see why"
  elif [ -n "$ADOPT_LABEL_OK" ]; then
    ADOPT_LABEL="$ADOPT_LABEL_OK"
    ADOPT_EVENTS="$ADOPT_OK_EVENTS"
    ADOPT_DEPENDABOT="$ADOPT_OK_DEPENDABOT"
    ADOPT_FALLBACK="$ADOPT_OK_FALLBACK"
  fi
  if [ -z "$ADOPT_ROUTED" ]; then
    adopt_reason "no job uses the routing expression for label ${ADOPT_LABEL} (docs/adopting.md, step 2)"
  fi
  if [ "$ADOPT_READY" = 1 ]; then
    log "routing: ready, the guard passes and these jobs are routed: $(printf '%s' "$ADOPT_ROUTED" | tr '\n' ' ')"
  else
    log "routing: not ready"
    printf '%s' "$ADOPT_REASONS"
  fi
  if [ -n "$ADOPT_NOTES" ]; then
    adopt_warn "the routing guard may not run on every pull request. Check that every pull request that changes .github/workflows still runs it:"
    printf '%s' "$ADOPT_NOTES" | sed 's/^/homefield:   /' >&2
  fi
}

# adopt_fallback <image>: a warning only. routing_guard.py accepts any
# ubuntu-*, windows-* or macos-* name, so a typo such as ubuntu-lates passes
# the guard, and the jobs then wait for a runner that does not exist whenever
# CI_RUNNER is not local. This list is GitHub's standard hosted labels
# (docs.github.com, "GitHub-hosted runners", 2026-10). A label it does not
# know, a new image or a larger runner, only gets the warning.
adopt_fallback() {
  case "$1" in
    ubuntu-slim | ubuntu-latest | ubuntu-2[246].04 | ubuntu-2[246].04-arm | \
      windows-latest | windows-2022 | windows-2025 | windows-2025-vs2026 | \
      windows-11-arm | windows-11-vs2026-arm | \
      macos-latest | macos-1[45] | macos-26 | macos-1[45]-intel | macos-26-intel)
      log "fallback image: $1 is a standard GitHub-hosted label"
      ;;
    *)
      adopt_warn "fallback $1 is not one of GitHub's standard hosted labels that this version knows. If it is a typo, jobs wait for a runner that does not exist whenever CI_RUNNER is not local. Ignore this for a larger runner or an image newer than this list."
      ;;
  esac
}

# adopt_cache_keys <dir>: warnings only. See tools/adopt.py for what counts.
adopt_cache_keys() {
  local dir="$1" hits
  if [ "$ADOPT_WORKFLOWS" = 0 ]; then
    log "cache keys: no workflow files to look at"
    return 0
  fi
  hits="$(python3 -I "$ROOT/tools/adopt.py" cache-keys "$dir")" || die "adopt: could not read the downloaded workflows"
  # Only the routed jobs share caches across architectures, so once some are
  # routed, files without any routed job are left out (a nightly that stays
  # hosted is no concern). Before that, every file is a candidate.
  if [ -n "$ADOPT_ROUTED" ]; then
    local hit kept=""
    while IFS= read -r hit; do
      # ADOPT_ROUTED is file:job lines; a hit is file:line: text.
      case $'\n'"$ADOPT_ROUTED" in
        *$'\n'"${hit%%:*}":*) kept="${kept}${hit}"$'\n' ;;
      esac
    done <<<"$hits"
    hits="${kept%$'\n'}"
  fi
  if [ -z "$hits" ]; then
    log "cache keys: none found with runner.os and without runner.arch"
    return 0
  fi
  adopt_warn "cache keys with runner.os and no runner.arch (a text match; check what each one is the key of):"
  printf '%s\n' "$hits" | sed 's/^/homefield:   /' >&2
  adopt_warn "runner.os is Linux on the hosted runners and on this arm64 VM, so such a key lets the two architectures restore each other's build outputs. Add \${{ runner.arch }} (docs/adopting.md, step 4)."
}

# adopt_snippets <label> <jobs>: what to add to the workflows, with the
# options in ADOPT_EVENTS, ADOPT_DEPENDABOT and ADOPT_FALLBACK. The expression
# and the guard step come from the same code that checks them.
adopt_snippets() {
  local label="$1" jobs="$2" expr
  expr="$(python3 -I "$ROOT/routing-guard/routing_guard.py" --print-expression --label "$label" \
    --events "$ADOPT_EVENTS" --dependabot "$ADOPT_DEPENDABOT" --fallback "$ADOPT_FALLBACK")" ||
    die "adopt: the routing options cannot be routed on (label ${label}, events ${ADOPT_EVENTS}, dependabot ${ADOPT_DEPENDABOT}, fallback ${ADOPT_FALLBACK})"
  echo
  echo "Replace each job's runs-on with this expression, verbatim (docs/adopting.md, step 2):"
  echo
  echo "    runs-on: ${expr}"
  echo
  echo "Add the guard to a job that runs on every pull request, after checkout (step 3),"
  echo "listing every job you routed:"
  echo
  python3 -I "$ROOT/tools/adopt.py" guard-snippet --label "$label" --jobs "$jobs" \
    --events "$ADOPT_EVENTS" --dependabot "$ADOPT_DEPENDABOT" --fallback "$ADOPT_FALLBACK"
  echo
}

# adopt_switch <owner/repo> <label> <dry> <switch> <jobs>: sets CI_RUNNER to
# local through cmd_route when the routing is ready; otherwise prints what is
# missing and stops the command.
adopt_switch() {
  local repo="$1" label="$2" dry="$3" switch="$4" jobs="$5" current
  current="$(gh variable get CI_RUNNER --repo "$repo" 2>/dev/null || echo "(unset)")"
  if [ "$ADOPT_READY" = 1 ]; then
    if [ "$current" = local ]; then
      ADOPT_SWITCH_OUTCOME="is already local"
      log "switch: ${repo}: CI_RUNNER is already local; nothing to change"
    elif [ "$switch" = 0 ]; then
      ADOPT_SWITCH_OUTCOME="is ${current} (--no-switch)"
      log "switch: ${repo}: CI_RUNNER is ${current}; not switching (--no-switch)"
    elif [ "$dry" = 1 ]; then
      ADOPT_SWITCH_OUTCOME="would be set to local (dry run)"
      cmd_route local --repo "$repo" --label "$label" --dry-run
    else
      ADOPT_SWITCH_OUTCOME="set to local"
      cmd_route local --repo "$repo" --label "$label"
    fi
    return 0
  fi
  if [ "$current" = local ]; then
    adopt_warn "CI_RUNNER is already local on ${repo} although its routing is not in place; bin/homefield route hosted --repo ${repo} undoes that"
  fi
  adopt_snippets "$ADOPT_LABEL" "${jobs:-$(printf '%s' "$ADOPT_ROUTED" | tr '\n' ',')}"
  die "not switched: merge the routing first, then run homefield adopt again"
}

cmd_adopt() {
  local repo="" nrepo=0 label="homefield-ci" label_given=0 group="homefield-ci" jobs="" switch=1 dry=0 entry out
  ADOPT_FLAG_EVENTS="" ADOPT_FLAG_DEPENDABOT="" ADOPT_FLAG_FALLBACK=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repo="${2:?--repo needs a value}"; nrepo=$((nrepo + 1)); shift 2 ;;
      --label) label="${2:?--label needs a value}"; label_given=1; shift 2 ;;
      --events) ADOPT_FLAG_EVENTS="${2:?--events needs a value}"; shift 2 ;;
      --dependabot) ADOPT_FLAG_DEPENDABOT="${2:?--dependabot needs a value}"; shift 2 ;;
      --fallback) ADOPT_FLAG_FALLBACK="${2:?--fallback needs a value}"; shift 2 ;;
      --group) group="${2:?--group needs a value}"; shift 2 ;;
      --jobs) jobs="${2:?--jobs needs a value}"; shift 2 ;;
      --no-switch) switch=0; shift ;;
      --dry-run) dry=1; shift ;;
      *) die "adopt: unknown option $1 (see bin/homefield help)" ;;
    esac
  done
  [ "$nrepo" -gt 0 ] || die "adopt: --repo <owner>/<repo> is required"
  [ "$nrepo" -eq 1 ] || die "adopt: one --repo at a time"
  [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "adopt: --repo must be <owner>/<repo>, got: $repo"
  [[ "$label" =~ ^[A-Za-z0-9._-]+$ ]] || die "adopt: --label must be one label"
  [ -n "$group" ] || die "adopt: --group needs a name"
  for entry in $(printf '%s' "$jobs" | tr ',' ' '); do
    [[ "$entry" =~ ^[A-Za-z0-9._-]+\.ya?ml:[A-Za-z0-9_-]+$ ]] || die "adopt: --jobs entries are <workflow-file>:<job-id>, such as ci.yml:lint; got: $entry"
  done
  command -v gh >/dev/null || die "adopt needs gh (https://cli.github.com)"
  command -v python3 >/dev/null || die "adopt needs python3"
  # The same label and option rules as the guard, and a message from it when
  # they fail.
  out="$(python3 -I "$ROOT/routing-guard/routing_guard.py" --print-expression --label "$label" \
    --events "${ADOPT_FLAG_EVENTS:-pull_request}" --dependabot "${ADOPT_FLAG_DEPENDABOT:-hosted}" \
    --fallback "${ADOPT_FLAG_FALLBACK:-ubuntu-latest}" 2>&1)" ||
    die "adopt: the routing options cannot be routed on: $(printf '%s' "$out" | sed $'s/\033\\[[0-9;]*m//g')"
  [ "$dry" = 0 ] || log "dry run: nothing will be changed"

  ADOPT_TMP="$(mktemp -d)"
  trap 'rm -rf "$ADOPT_TMP"' EXIT
  adopt_repository "$repo"
  adopt_fetch_workflows "$repo" "$ADOPT_BRANCH" "$ADOPT_TMP/workflows"
  adopt_routing_check "$ADOPT_TMP/workflows" "$label" "$label_given"
  adopt_cache_keys "$ADOPT_TMP/workflows"
  adopt_fallback "$ADOPT_FALLBACK"
  adopt_group_access "$repo" "$group" "$dry"
  adopt_switch "$repo" "$ADOPT_LABEL" "$dry" "$switch" "$jobs"

  log "done: ${repo}: runner group ${ADOPT_GROUP_OUTCOME}; routing ready; CI_RUNNER ${ADOPT_SWITCH_OUTCOME}"
  log "still by hand: open a pull request and check the jobs ran on the local runner, add any tools they lack, and record the setup in the repository (docs/adopting.md, steps 6 and 7)"
}

# memory_cutoff_epoch <cutoff-day> <rows>: the cutoff day's midnight as an
# epoch, in the timezone the rows themselves carry. The summary selects
# rows by each row's own (guest) calendar day, so the epoch that decides a
# first row or a reboot must use the same day boundary — the host's
# midnight is a different instant when the zones differ (#91 review). The
# offset comes from the first row at/after the cutoff (an earlier row's day
# is outside the window). Empty when nothing is at/after the cutoff or the
# date cannot be parsed, which the summary then treats as "cannot decide".
memory_cutoff_epoch() {
  local cutoff="$1" rows="$2" offset
  offset="$(printf '%s\n' "$rows" | awk -F, -v cutoff="$cutoff" '
    $1 != "ts" && substr($1, 1, 10) >= cutoff { print substr($1, 20, 5); exit }')"
  [ -n "$offset" ] || return 0
  # ts is always YYYY-MM-DDTHH:MM:SS+HHMM (samplers %z), so the offset sits
  # at characters 20-24. BSD date first, GNU fallback: the tool runs only on
  # macOS, but the suites run here and on Linux CI.
  date -j -f "%Y-%m-%dT%H:%M:%S%z" "${cutoff}T00:00:00${offset}" +%s 2>/dev/null ||
    date -d "${cutoff}T00:00:00${offset}" +%s 2>/dev/null || true
}

# Per-day summary of the guest's memwatch rows (vm/provision.sh,
# homefield-memwatch): ts,samples,total_mib,used_avg_mib,used_max_mib,
# avail_min_mib,oom_kills,job[,boot]. Files sort by date, so rows arrive in
# time order and the cumulative oom counter can be diffed row to row. The
# counter restarts at a reboot, so: a boot change between two rows (column 9,
# added for #91) means the whole value is kills since that boot; same boot,
# take the difference. Both whole-counter cases count only when that boot is
# known (a 0 from an unreadable btime is unknown, not a boot at the epoch)
# and began inside the window (cutoff_epoch, compared as epochs) — kills
# under a boot older than the window span its start and cannot be split, and
# guessing would overcount, the #91 review's point against prev = 0. Rows
# from before column 9 (8 fields) fall back to the counter rule: a smaller
# value than before means a reboot; nothing can be decided for their first
# row, which stays uncounted.
# shellcheck disable=SC2016  # awk, not shell, expands the $n fields
MEMORY_AWK='
BEGIN { FS = ","; prev = -1; prev_boot = -1 }
$1 == "ts" || (NF != 8 && NF != 9) { next }
{
  day = substr($1, 1, 10)
  boot = (NF >= 9 && $9 + 0 > 0 ? $9 + 0 : -1)
  if (day < cutoff) { prev = $7; prev_boot = boot; next }
  if (!(day in n)) { order[++days] = day; mn[day] = -1 }
  n[day]++
  sum[day] += $4
  if ($5 > peak[day]) { peak[day] = $5; at[day] = substr($1, 12, 5) }
  if (mn[day] < 0 || $6 < mn[day]) mn[day] = $6
  if ($8 == 1) { busy[day]++; if ($5 > bpeak[day]) bpeak[day] = $5 }
  if (prev < 0) {
    if (boot >= 0 && cutoff_epoch != "" && boot >= cutoff_epoch + 0) oom[day] += $7
  } else if (boot >= 0 && prev_boot >= 0 && boot != prev_boot) {
    # Rebooted between rows: the counter is all kills since the NEW boot.
    # It counts only when that boot is inside the window — the previous row
    # can precede the window and the reboot can too, and then the counter
    # reaches across the boundary (#91 review).
    if (cutoff_epoch != "" && boot >= cutoff_epoch + 0) oom[day] += $7
  } else {
    oom[day] += ($7 >= prev ? $7 - prev : $7)
  }
  prev = $7
  prev_boot = boot
  total = $3
  tn++
  tsum += $4
  if ($5 > tpeak) { tpeak = $5; tday = day; tat = substr($1, 12, 5) }
}
END {
  if (days == 0) exit 3
  printf "%-10s %8s %9s %9s %10s %9s %5s\n", "day", "minutes", "avg MiB", "peak MiB", "job peak", "min avail", "OOM"
  for (i = 1; i <= days; i++) {
    d = order[i]
    printf "%-10s %8d %9d %9d %10s %9d %5d\n", d, n[d], sum[d] / n[d], peak[d], (busy[d] ? bpeak[d] : "-"), mn[d], oom[d]
    allOom += oom[d]
  }
  printf "\nVM memory %d MiB. Over %d minutes: average %d MiB, highest minute %d MiB (%d%%) on %s at %s, %d out-of-memory kills.\n", total, tn, tsum / tn, tpeak, tpeak * 100 / total, tday, tat, allOom
}'

cmd_memory() {
  local days=7 cutoff rows rc cutoff_epoch
  while [ $# -gt 0 ]; do
    case "$1" in
      --days) days="${2:?--days needs a value}"; shift 2 ;;
      *) die "memory: unknown option $1 (see bin/homefield help)" ;;
    esac
  done
  if ! [[ "$days" =~ ^[0-9]+$ ]] || [ "$days" -lt 1 ]; then
    die "memory: --days must be a positive number"
  fi
  check_host
  vm_lookup
  [ "$VM_STATUS" = "Running" ] || die "memory: VM ${INSTANCE} is not running"
  # BSD date, as on macOS: today minus (days - 1), so --days 1 is today.
  cutoff="$(date -v-"$((days - 1))"d +%F)"
  rows="$(guest sh -c 'cat /var/log/homefield/memwatch-*.csv 2>/dev/null; true')" || exit 1
  [ -n "$rows" ] || die "memory: no samples in ${INSTANCE} yet; the sampler is installed by bin/homefield upgrade"
  # The same instant as an epoch, for comparing the CSV's boot column
  # (#91): midnight at the start of the cutoff day, measured in the guests
  # timezone from the rows themselves, never the hosts.
  cutoff_epoch="$(memory_cutoff_epoch "$cutoff" "$rows")"
  rc=0
  printf '%s\n' "$rows" | awk -v cutoff="$cutoff" -v cutoff_epoch="$cutoff_epoch" "$MEMORY_AWK" || rc=$?
  [ "$rc" -ne 3 ] || die "memory: no samples since ${cutoff}"
  [ "$rc" -eq 0 ] || exit "$rc"
}

cmd_report() {
  command -v python3 >/dev/null || die "report needs python3"
  command -v gh >/dev/null || die "report needs gh (https://cli.github.com)"
  exec python3 "$ROOT/tools/report.py" "$@"
}

# update_command <repo> <ref>: the install.sh one-liner (README, Quick start)
# for that ref, plus the settings that differ from install.sh's defaults, so
# that it replaces this copy and not some other one. The default ref here is
# install.sh's: change both when a release is cut.
update_command() {
  local repo="$1" ref="$2" settings=""
  [ "$repo" = i2Dev-com/homefield ] || settings="${settings}HOMEFIELD_REPO=${repo} "
  [ "$ref" = v0.3.1 ] || settings="${settings}HOMEFIELD_REF=${ref} "
  [ "$ROOT" = "$HOME/.local/share/homefield" ] || settings="${settings}HOMEFIELD_HOME='${ROOT}' "
  echo "  curl -fsSL https://raw.githubusercontent.com/${repo}/${ref}/install.sh | ${settings}bash"
}

# github_read <gh|curl> <repo> <commits REF|tags>: the commit REF resolves to,
# or the repository's tag names (first 100), one per line. gh when it is there
# (it reads a private fork too); otherwise curl against the public API, which
# needs no login. A branch with a slash (release/1) goes into the path
# encoded, and curl follows redirects (a renamed repository answers 301).
github_read() {
  local via="$1" repo="$2" what="$3" ref="${4:-}"
  ref="${ref//\//%2F}"
  if [ "$via" = gh ]; then
    case "$what" in
      commits) gh api "repos/${repo}/commits/${ref}" --jq .sha ;;
      tags) gh api --paginate "repos/${repo}/tags?per_page=100" --jq '.[].name' ;;
    esac
    return
  fi
  case "$what" in
    commits) curl -fsSL --max-time 15 -H 'Accept: application/vnd.github.sha' "https://api.github.com/repos/${repo}/commits/${ref}" ;;
    tags)
      curl -fsSL --max-time 15 "https://api.github.com/repos/${repo}/tags?per_page=100" |
        sed -n 's/^ *"name": *"\([^"]*\)".*/\1/p'
      ;;
  esac
}

# update_check <repo> <ref> <commit>: says whether the ref this copy was
# installed from has moved, and whether a later release exists (the highest
# vMAJOR.MINOR.PATCH tag, when the installed ref is such a tag too). Reads
# GitHub through gh, or curl when gh is missing (github_read). Their own
# output is dropped: whatever goes wrong is one line here, and nothing here
# fails the command.
update_check() {
  local repo="$1" ref="$2" commit="$3" current="" tags="" tag="" latest="" advised=0
  local la="" lb="" lc="" a b c
  local repo_re='^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$' ref_re='^[A-Za-z0-9_./-]+$' sha_re='^[0-9a-f]{40}$'
  local tag_re='^v([0-9]+)[.]([0-9]+)[.]([0-9]+)$' via hint
  if command -v gh >/dev/null; then
    via=gh hint="see gh auth status"
  elif command -v curl >/dev/null; then
    via=curl hint="a private repository needs gh"
  else
    log "could not check for updates (neither gh nor curl is installed)"
    return 0
  fi
  if [[ ! "$repo" =~ $repo_re || "$repo" == *..* || ! "$ref" =~ $ref_re || "$ref" == *..* || "$ref" == -* ]]; then
    log "could not check for updates (.homefield-ref has no usable repo and ref)"
    return 0
  fi
  if [ -z "$commit" ]; then
    log "could not check for updates (.homefield-ref records no commit)"
    return 0
  fi
  # A branch or tag name resolves to the commit it points at (an annotated tag
  # is followed to its commit). A full commit hash cannot move.
  if [[ ! "$ref" =~ $sha_re ]]; then
    if ! current="$(github_read "$via" "$repo" commits "$ref" 2>/dev/null)"; then
      log "could not check for updates (${via} could not read ${ref} in ${repo}; ${hint})"
      return 0
    fi
    if [[ ! "$current" =~ $sha_re ]]; then
      log "could not check for updates (unexpected answer from ${via} for ${ref} in ${repo})"
      return 0
    fi
  fi
  if ! tags="$(github_read "$via" "$repo" tags 2>/dev/null)"; then
    log "could not check for updates (${via} could not list the tags of ${repo}; ${hint})"
    return 0
  fi
  # The highest release tag, compared part by part as numbers (no sort -V on
  # the bash 3.2 and BSD tools macOS ships).
  while IFS= read -r tag; do
    [[ "$tag" =~ $tag_re ]] || continue
    a="${BASH_REMATCH[1]}" b="${BASH_REMATCH[2]}" c="${BASH_REMATCH[3]}"
    if [ -z "$latest" ] || [ "$a" -gt "$la" ] ||
      { [ "$a" -eq "$la" ] && { [ "$b" -gt "$lb" ] || { [ "$b" -eq "$lb" ] && [ "$c" -gt "$lc" ]; }; }; }; then
      latest="$tag" la="$a" lb="$b" lc="$c"
    fi
  done <<<"$tags"

  # The recorded commit may be a short hash (install.sh falls back to one).
  if [ -z "$current" ]; then
    log "installed at a fixed commit (${commit:0:7}), so there is no ref to compare"
  elif [[ "$current" == "$commit"* ]]; then
    log "up to date with ${ref}"
  else
    log "${ref} has moved to ${current:0:7} since this copy was installed; update with:"
    update_command "$repo" "$ref"
    advised=1
  fi
  # Only when the installed ref is a release tag too: a branch follows its own
  # head, and a fixed commit has no release to compare.
  if [ -n "$latest" ] && [[ "$ref" =~ $tag_re ]]; then
    a="${BASH_REMATCH[1]}" b="${BASH_REMATCH[2]}" c="${BASH_REMATCH[3]}"
    if [ "$la" -gt "$a" ] || { [ "$la" -eq "$a" ] && { [ "$lb" -gt "$b" ] || { [ "$lb" -eq "$b" ] && [ "$lc" -gt "$c" ]; }; }; }; then
      log "${latest} is out (installed: ${ref}); read CHANGELOG.md for breaking changes, then update with:"
      update_command "$repo" "$latest"
      advised=1
    fi
  fi
  if [ "$advised" = 1 ]; then
    echo "That replaces the tool and leaves the VM alone; homefield upgrade updates the VM."
  fi
}

# What install.sh recorded when it installed this copy (repo, ref, commit),
# and whether that ref has moved on; a git checkout says where it is instead.
cmd_version() {
  [ $# -eq 0 ] || die "version takes no options besides --instance"
  local key value repo="" ref="" commit=""
  if [ -f "$ROOT/.homefield-ref" ]; then
    while IFS='=' read -r key value; do
      case "$key" in
        repo) repo="$value" ;;
        ref) ref="$value" ;;
        commit) commit="$value" ;;
      esac
    done <"$ROOT/.homefield-ref"
    echo "homefield ${ref:-unknown}${commit:+ (${commit:0:7})}, installed from ${repo:-unknown} in ${ROOT}"
    update_check "$repo" "$ref" "$commit"
  elif git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    echo "homefield $(git -C "$ROOT" describe --always), from a checkout in ${ROOT}"
  else
    echo "homefield (version unknown), in ${ROOT}"
  fi
}

# ── Main ────────────────────────────────────────────────────────────────────
# --instance may come before or after the command.
main() {
  local cmd="" rest=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --instance) INSTANCE="${2:?--instance needs a value}"; shift 2 ;;
      *)
        if [ -z "$cmd" ]; then cmd="$1"; else rest+=("$1"); fi
        shift
        ;;
    esac
  done
  [ -n "$cmd" ] || { usage >&2; exit 1; }
  # Only the commands that act on the VM: preflight, route, adopt, report and
  # version never use it, so a stale HOMEFIELD_INSTANCE does not stop them.
  case "$cmd" in install | upgrade | status | uninstall | memory) check_instance ;; esac
  set -- "${rest[@]+"${rest[@]}"}"
  case "$cmd" in
    preflight) [ $# -eq 0 ] || die "preflight takes no options (see bin/homefield help)"; cmd_preflight ;;
    install) cmd_install "$@" ;;
    upgrade) cmd_upgrade "$@" ;;
    status) cmd_status "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    route) cmd_route "$@" ;;
    adopt) cmd_adopt "$@" ;;
    memory) cmd_memory "$@" ;;
    report) cmd_report "$@" ;;
    version | --version) cmd_version "$@" ;;
    help | -h | --help) usage ;;
    *) usage >&2; exit 1 ;;
  esac
}

# The tests source this file to call the functions above on their own.
[ "${HOMEFIELD_SOURCE_ONLY:-}" = 1 ] || main "$@"
